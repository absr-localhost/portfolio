---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, services } from '~/data/profil';

const metadata = { title: 'Layanan' };
---

<Layout metadata={metadata}>
  <section class="bg-[#0B1F4B] py-12 text-white sm:py-16">
    <div class={wrap}>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Layanan</h1>
      <p class="mt-3 max-w-2xl text-slate-300">Yang bisa saya bantu.</p>
    </div>
  </section>
  <section class="py-12 sm:py-16">
    <div class={wrap}>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s, i) => (
            <div class={`${card} p-5`}>
              <div class="text-sm font-bold text-neutral-400">{String(i + 1).padStart(2, "0")}</div>
              <div class="mt-2 text-base font-semibold leading-snug">{s}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
