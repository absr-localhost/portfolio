---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { wrap, card, EMAIL } from '~/data/profil';

const metadata = { title: 'Layanan' };

const layanan: [string, string][] = [
  ['Pengembangan website dan aplikasi', 'Membangun aplikasi web dan seluler dari basis data, backend, hingga antarmuka.'],
  ['Server, jaringan, dan dukungan IT', 'Mengelola server, akun, cadangan data, dan jaringan agar layanan tetap tersedia.'],
  ['Konsultasi IT dan transformasi digital', 'Menganalisis kebutuhan dan merekomendasikan solusi yang tepat guna dan sesuai anggaran.'],
  ['Keamanan sistem', 'Pengujian dengan izin tertulis, lalu laporan temuan beserta perbaikannya.'],
  ['Otomasi VBA dan Power Platform', 'Mengotomasi pekerjaan Excel dan Office, serta membangun Power Apps, Power Automate, dan Power BI.'],
  ['Desain grafis dan video', 'Materi visual dan penyuntingan video untuk komunikasi dan edukasi.'],
  ['Solusi digital untuk pendidikan', 'Absensi digital, aplikasi rapor, dan sistem administrasi untuk sekolah.'],
  ['Pengembangan produk digital dan MVP', 'Memimpin produk dari ide, arsitektur teknis, pengembangan, hingga operasional.'],
];

const langkah: [string, string][] = [
  ['Analisis kebutuhan', 'Memahami masalah dan merekomendasikan solusi yang sesuai anggaran.'],
  ['Rancangan', 'Menyusun ruang lingkup, jadwal, dan arsitektur teknis.'],
  ['Pengerjaan', 'Membangun dan menguji sebelum rilis, supaya masalah ditemukan lebih dulu oleh tim.'],
  ['Serah terima dan dukungan', 'Serah terima yang jelas, lalu perawatan agar layanan tetap berjalan.'],
];

const keahlian: [string, string[]][] = [
  [
    'Pengembangan',
    [
      'Full-Stack Engineer / Developer',
      'Mobile App Developer (Android)',
      'UI/UX Designer',
      'Database Administrator',
      'QA dan Software Tester',
      'VBA / Macro Developer',
      'Power Platform Developer',
      'AI dan Chatbot Integrator',
    ],
  ],
  [
    'Infrastruktur dan dukungan',
    ['IT Specialist', 'IT Support Specialist', 'System Administrator (SysAdmin)', 'Network Engineer', 'DevOps dan Cloud Engineer'],
  ],
  ['Keamanan', ['Cybersecurity', 'Ethical Hacker / Penetration Tester', 'Digital Forensics dan Incident Response (defensif)']],
  ['Konsultasi dan manajemen', ['IT Consultant', 'Manajemen proyek IT', 'Solo Tech Founder / CTO', 'Data Analyst dan Business Intelligence']],
  ['Multimedia dan edukasi', ['Multimedia Specialist', 'IT Trainer dan Technical Writer']],
];

const btnMain =
  'inline-flex items-center justify-center gap-2 rounded-md bg-accent px-5 py-3 text-sm font-semibold text-primary shadow-sm transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
const btnSide =
  'inline-flex items-center justify-center gap-2 rounded-md border border-white/40 px-5 py-3 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<Layout metadata={metadata}>
  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={wrap}>
      <h1 class="text-2xl font-bold tracking-tight">Layanan</h1>
      <p class="mt-3 max-w-2xl text-sm text-slate-300">
        Solusi IT yang dirancang, dibangun, dan dirawat sampai berjalan stabil.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${EMAIL}`} class={btnMain}>
          <Icon name="tabler:mail" class="h-5 w-5" />
          Hubungi saya
        </a>
        <a href="/proyek" class={btnSide}>
          <Icon name="tabler:briefcase" class="h-5 w-5" />
          Lihat portofolio
        </a>
      </div>
    </div>
  </section>

  <section id="layanan" class="scroll-mt-24 py-10 sm:py-12">
    <div class={wrap}>
      <div class={`${card} overflow-hidden`}>
        <ul class="grid gap-px bg-slate-200 sm:grid-cols-2">
          {
            layanan.map(([judul, isi], i) => (
              <li class="flex items-start gap-3 bg-white px-4 py-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-primary text-white">
                  {i === 0 && <Icon name="tabler:code" class="h-5 w-5" />}
                  {i === 1 && <Icon name="tabler:server" class="h-5 w-5" />}
                  {i === 2 && <Icon name="tabler:bulb" class="h-5 w-5" />}
                  {i === 3 && <Icon name="tabler:shield-check" class="h-5 w-5" />}
                  {i === 4 && <Icon name="tabler:settings" class="h-5 w-5" />}
                  {i === 5 && <Icon name="tabler:brush" class="h-5 w-5" />}
                  {i === 6 && <Icon name="tabler:school" class="h-5 w-5" />}
                  {i === 7 && <Icon name="tabler:rocket" class="h-5 w-5" />}
                </span>
                <div>
                  <h3 class="text-sm font-semibold text-heading">{judul}</h3>
                  <p class="mt-0.5 text-sm leading-relaxed text-muted">{isi}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-10 sm:py-12">
    <div class={wrap}>
      <h2 class="mb-5 text-xl font-bold text-heading">Cara kerja</h2>
      <div class={`${card} overflow-hidden`}>
        <ul class="grid gap-px bg-slate-200 sm:grid-cols-2">
          {
            langkah.map(([judul, isi], i) => (
              <li class="flex items-start gap-3 bg-white px-4 py-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-primary text-white">
                  {i === 0 && <Icon name="tabler:search" class="h-5 w-5" />}
                  {i === 1 && <Icon name="tabler:layout-grid" class="h-5 w-5" />}
                  {i === 2 && <Icon name="tabler:code" class="h-5 w-5" />}
                  {i === 3 && <Icon name="tabler:settings" class="h-5 w-5" />}
                </span>
                <div>
                  <h3 class="text-sm font-semibold text-heading">{judul}</h3>
                  <p class="mt-0.5 text-sm leading-relaxed text-muted">{isi}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="keahlian" class="scroll-mt-24 py-10 sm:py-12">
    <div class={wrap}>
      <h2 class="mb-5 text-xl font-bold text-heading">Keahlian</h2>
      <div class="grid items-start gap-3 lg:grid-cols-2">
        {
          keahlian.map(([judul, peran], gi) => (
            <details class={`group ${card} overflow-hidden`}>
              <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-primary text-white">
                  {gi === 0 && <Icon name="tabler:code" class="h-5 w-5" />}
                  {gi === 1 && <Icon name="tabler:server" class="h-5 w-5" />}
                  {gi === 2 && <Icon name="tabler:shield-check" class="h-5 w-5" />}
                  {gi === 3 && <Icon name="tabler:briefcase" class="h-5 w-5" />}
                  {gi === 4 && <Icon name="tabler:palette" class="h-5 w-5" />}
                </span>
                <span class="flex-1 text-sm font-semibold text-heading">{judul}</span>
                <span class="text-sm text-muted">{peran.length}</span>
                <Icon name="tabler:chevron-down" class="h-5 w-5 shrink-0 text-muted transition-transform group-open:rotate-180" />
              </summary>
              <div class="flex flex-wrap gap-2 border-t border-slate-200 px-4 py-3">
                {peran.map((r) => (
                  <span class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-sm text-default">{r}</span>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={`${wrap} flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between`}>
      <div>
        <h2 class="text-xl font-bold">Butuh bantuan IT?</h2>
        <p class="mt-2 max-w-xl text-sm text-slate-300">Ceritakan kebutuhan Anda lewat email.</p>
      </div>
      <a href={`mailto:${EMAIL}`} class={btnMain}>
        <Icon name="tabler:mail" class="h-5 w-5" />
        Hubungi saya
      </a>
    </div>
  </section>
</Layout>
