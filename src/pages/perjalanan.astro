---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, timeline } from '~/data/profil';

const metadata = { title: 'Perjalanan' };
---

<Layout metadata={metadata}>
  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={wrap}>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Perjalanan</h1>
      <p class="mt-3 max-w-2xl text-slate-300">Jejak karier dari tahun ke tahun.</p>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class={wrap}>
      <ol class="max-w-3xl divide-y divide-slate-200 border-y border-slate-200">
        {
          timeline.map(([y, t, d]) => (
            <li class="grid gap-1 py-6 sm:grid-cols-[8rem_1fr] sm:gap-8">
              <div class="text-2xl font-extrabold tracking-tight text-primary">{y}</div>
              <div>
                <div class="text-lg font-semibold text-heading">{t}</div>
                <div class="mt-1 text-muted">{d}</div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-primary py-12 text-white sm:py-14">
    <div class={`${wrap} flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center`}>
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Punya kebutuhan IT yang ingin dibahas</h2>
        <p class="mt-2 max-w-xl text-slate-300">Ceritakan kebutuhan Anda, saya akan membalas lewat email atau Telegram.</p>
      </div>
      <a
        href="/kontak"
        class="inline-block rounded-md bg-accent px-6 py-3 text-sm font-semibold text-primary hover:opacity-90"
      >
        Hubungi saya
      </a>
    </div>
  </section>
</Layout>
