---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, about } from '~/data/profil';

const metadata = { title: 'Tentang Saya' };
---

<Layout metadata={metadata}>
  <section class="bg-[#0B1F4B] py-12 text-white sm:py-16">
    <div class={wrap}>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Tentang Saya</h1>
      <p class="mt-3 max-w-2xl text-slate-300">23+ peran dan keahlian IT, satu pendekatan: pahami kebutuhan dulu, baru pilih alatnya.</p>
    </div>
  </section>
  <section class="py-12 sm:py-16">
    <div class={wrap}>
      <div class="max-w-3xl space-y-5 text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
        {about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>
</Layout>
