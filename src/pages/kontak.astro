---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, EMAIL, socials } from '~/data/profil';

const metadata = { title: 'Kontak' };
---

<Layout metadata={metadata}>
  <section class="bg-[#0B1F4B] py-12 text-white sm:py-16">
    <div class={wrap}>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Kontak</h1>
      <p class="mt-3 max-w-2xl text-slate-300">Ceritakan kebutuhan Anda. Saya akan membalas lewat email atau Telegram.</p>
    </div>
  </section>
  <section class="py-12 sm:py-16">
    <div class={wrap}>
      <div class="flex flex-wrap gap-3">
        <a href={`mailto:${EMAIL}`} class="bg-[#0B1F4B] px-6 py-3 text-sm font-semibold text-white hover:bg-[#13306e]">{EMAIL}</a>
        {
          socials.map(([n, u]) => (
            <a href={u} target="_blank" rel="noopener noreferrer" class="border border-neutral-900 px-5 py-3 text-sm font-semibold hover:bg-neutral-100 dark:border-neutral-300 dark:hover:bg-neutral-800">{n}</a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
