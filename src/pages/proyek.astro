---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, projects } from '~/data/profil';

const metadata = { title: 'Portofolio & Proyek' };
---

<Layout metadata={metadata}>
  <section class="bg-[#0B1F4B] py-12 text-white sm:py-16">
    <div class={wrap}>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Portofolio & Proyek</h1>
      <p class="mt-3 max-w-2xl text-slate-300">Pilihan karya dari 57+ proyek dan pekerjaan yang telah saya selesaikan.</p>
    </div>
  </section>
  <section class="py-12 sm:py-16">
    <div class={wrap}>
      <div class="grid gap-4 lg:grid-cols-2">
        {
          projects.map((g) => (
            <div class={`${card} p-5 sm:p-6`}>
              <h3 class="text-lg font-bold">{g.title}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {g.items.map((i) => (
                  <li class="border border-neutral-300 px-3 py-1 text-xs text-neutral-700 dark:border-neutral-600 dark:text-neutral-300 sm:text-sm">{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
