---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card } from '~/data/profil';
import { projects, projectCats } from '~/data/proyek';

const metadata = {
  title: 'Proyek',
};

const cats = Object.entries(projectCats);
---

<Layout metadata={metadata}>
  <section class={`${wrap} py-12`}>
    <p class="text-sm font-semibold uppercase tracking-widest">Galeri karya</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Portofolio &amp; Proyek</h1>
    <p class="mt-4 max-w-3xl text-neutral-600 dark:text-neutral-300">
      Pilihan karya dari 57+ proyek dan pekerjaan yang telah saya selesaikan, mulai pengembangan full-stack,
      administrasi sistem, automasi, multimedia, hingga keamanan siber.
    </p>

    <div id="filter" class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter bidang">
      <button type="button" data-cat="all" class="filter-btn on border border-neutral-900 px-4 py-2 text-sm font-semibold dark:border-neutral-300">
        Semua
      </button>
      {
        cats.map(([key, label]) => (
          <button type="button" data-cat={key} class="filter-btn border border-neutral-900 px-4 py-2 text-sm font-semibold dark:border-neutral-300">
            {label}
          </button>
        ))
      }
    </div>

    <div id="grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <article class={`${card} proj p-6`} data-cat={p.cat}>
            <p class="text-xs uppercase tracking-widest text-neutral-500">
              {projectCats[p.cat as keyof typeof projectCats]}
            </p>
            <h2 class="mt-2 text-lg font-bold">{p.title}</h2>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{p.desc}</p>
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer font-semibold">Detail</summary>
              <p class="mt-2 text-neutral-600 dark:text-neutral-300">{p.detail}</p>
            </details>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style is:global>
  .filter-btn.on {
    background: #111;
    color: #fff;
  }
  .dark .filter-btn.on {
    background: #fff;
    color: #111;
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('filter');
    var cards = document.querySelectorAll('.proj');
    if (!bar) return;
    bar.addEventListener('click', function (e) {
      var b = e.target.closest('.filter-btn');
      if (!b) return;
      var k = b.getAttribute('data-cat');
      bar.querySelectorAll('.filter-btn').forEach(function (x) {
        x.classList.toggle('on', x === b);
      });
      cards.forEach(function (c) {
        c.hidden = !(k === 'all' || c.getAttribute('data-cat') === k);
      });
    });
  })();
</script>
