---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, projects as kategori, slugKategori } from '~/data/profil';
import { projects } from '~/data/proyek';

const metadata = {
  title: 'Portofolio',
};
---

<Layout metadata={metadata}>
  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={wrap}>
      <h1 class="text-2xl font-bold tracking-tight">Portofolio</h1>
    </div>
  </section>

  <!-- KATEGORI PROYEK: tujuan tautan dari kartu di Beranda (/proyek#nama-kategori) -->
  <section class="bg-slate-50 pt-8 sm:pt-10">
    <div class={`${wrap} space-y-4`}>
      <h2 class="text-lg font-bold text-heading sm:text-xl">Kategori proyek</h2>
      {
        kategori.map((k) => (
          <article id={slugKategori(k.title)} class={`${card} scroll-mt-20 p-5 sm:p-6 lg:scroll-mt-6`}>
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-base font-bold text-heading sm:text-lg">{k.title}</h3>
              <span class="shrink-0 text-xs text-muted">{k.items.length} proyek</span>
            </div>
            <ul class="mt-3 grid gap-x-6 gap-y-1.5 text-sm text-muted sm:grid-cols-2">
              {k.items.map((it) => (
                <li class="border-l-2 border-accent pl-2.5">{it}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-slate-50 py-8 sm:py-10">
    <div class={`${wrap} space-y-6`}>
      <h2 class="text-lg font-bold text-heading sm:text-xl">Studi kasus</h2>
      {
        projects.map((p) => (
          <article class={`${card} p-5 sm:p-8`}>
            <p class="text-xs text-muted">
              {p.tahun} <span class="text-slate-300">/</span> Untuk {p.untuk}
            </p>
            <h2 class="mt-1 text-xl font-bold tracking-tight text-heading sm:text-2xl">{p.judul}</h2>
            <p class="mt-3 text-base font-semibold text-heading sm:text-lg">{p.ringkasan}</p>

            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              <div class="rounded-md border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-muted">Sebelum</p>
                <p class="mt-1 text-sm text-default">{p.sebelum}</p>
              </div>
              <div class="rounded-md bg-primary p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-300">Sekarang</p>
                <p class="mt-1 text-sm text-white">{p.sekarang}</p>
              </div>
            </div>

            <h3 class="mt-6 text-sm font-semibold text-heading">Hasil</h3>
            <ul class="mt-2 divide-y divide-slate-200 border-y border-slate-200">
              {p.hasil.map((h) => (
                <li class="py-3 text-sm text-muted">
                  <span class="font-semibold text-heading">{h.judul}.</span> {h.isi}
                </li>
              ))}
            </ul>

            {
              p.alat && (
                <>
                  <h3 class="mt-6 text-sm font-semibold text-heading">Alat yang digunakan</h3>
                  <div class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4">
                    {p.alat.map((a) => (
                      <div class="overflow-hidden rounded-md border border-slate-200 bg-white">
                        <img
                          src={a.gambar}
                          alt={a.nama}
                          width="800"
                          height="600"
                          loading="lazy"
                          class="aspect-[4/3] w-full border-b border-slate-200 bg-slate-50 object-contain"
                        />
                        <div class="p-3">
                          <p class="text-sm font-semibold text-heading">{a.nama}</p>
                          <p class="mt-1 text-xs text-muted">{a.fungsi}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </>
              )
            }

            <p class="mt-6 border-t border-slate-200 pt-4 text-xs text-muted">
              <span class="font-semibold text-heading">Status</span> {p.status}
            </p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
