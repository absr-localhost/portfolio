---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card } from '~/data/profil';
import { projects, projectCats } from '~/data/proyek';

const metadata = {
  title: 'Proyek',
};
---

<Layout metadata={metadata}>
  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={wrap}>
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Galeri karya</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-5xl">Portofolio &amp; Proyek</h1>
      <p class="mt-3 max-w-3xl text-slate-300">
        Pilihan karya dari 57+ proyek dan pekerjaan yang telah saya selesaikan, mulai dari pengembangan
        full-stack, administrasi sistem, automasi, multimedia, hingga keamanan siber.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class={wrap}>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((p, i) => (
            <article class={`${card} flex flex-col border-t-2 border-t-accent p-6 transition hover:-translate-y-1 hover:border-accent hover:shadow-md`}>
              <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-semibold uppercase tracking-widest text-link">
                  {projectCats[p.cat]}
                </p>
                <span class="text-sm font-bold text-slate-300">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h2 class="mt-3 text-lg font-bold text-heading">{p.title}</h2>
              <p class="mt-2 text-sm text-muted">{p.desc}</p>
              <button
                type="button"
                data-open={`proj-${i}`}
                class="mt-5 self-start rounded-md border border-primary px-4 py-2 text-sm font-semibold text-primary transition hover:bg-primary hover:text-white"
              >
                Lihat detail
              </button>

              <dialog
                id={`proj-${i}`}
                class="proj-dialog m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto rounded-lg border-0 p-0 shadow-xl backdrop:bg-primary/70"
              >
                <div class="bg-primary px-6 py-6 text-white sm:px-8">
                  <p class="text-xs font-semibold uppercase tracking-widest text-accent">
                    {projectCats[p.cat]}
                  </p>
                  <h3 class="mt-2 text-2xl font-bold tracking-tight">{p.title}</h3>
                </div>

                <div class="bg-white px-6 py-6 sm:px-8">
                  <p class="text-lg font-medium text-heading">{p.desc}</p>
                  <span class="mt-4 block h-0.5 w-8 bg-accent" />
                  <p class="mt-4 leading-relaxed text-muted">{p.detail.gambaran}</p>

                  <h4 class="mt-8 text-sm font-semibold uppercase tracking-widest text-link">Yang dikerjakan</h4>
                  <ul class="mt-3 space-y-2">
                    {
                      p.detail.lingkup.map((x) => (
                        <li class="flex gap-3 text-muted">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rotate-45 bg-accent" />
                          <span>{x}</span>
                        </li>
                      ))
                    }
                  </ul>

                  <h4 class="mt-8 text-sm font-semibold uppercase tracking-widest text-link">Manfaat</h4>
                  <ul class="mt-3 space-y-2">
                    {
                      p.detail.manfaat.map((x) => (
                        <li class="flex gap-3 text-muted">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rotate-45 bg-accent" />
                          <span>{x}</span>
                        </li>
                      ))
                    }
                  </ul>

                  <div class="mt-8 rounded-lg border border-slate-200 border-l-4 border-l-accent bg-slate-50 p-5">
                    <p class="text-sm font-semibold uppercase tracking-widest text-link">Cocok untuk</p>
                    <p class="mt-2 text-muted">{p.detail.cocok}</p>
                  </div>

                  <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-6">
                    <p class="max-w-sm text-sm text-muted">Butuh yang serupa? Ceritakan kebutuhan Anda, saya akan membalas lewat email atau Telegram.</p>
                    <div class="flex flex-wrap gap-3">
                      <a href="/kontak" class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-primary hover:opacity-90">Hubungi saya</a>
                      <button type="button" data-close class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-heading hover:bg-slate-50">Tutup</button>
                    </div>
                  </div>
                </div>
              </dialog>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-primary py-12 text-white sm:py-14">
    <div class={`${wrap} flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center`}>
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Punya proyek atau kebutuhan IT</h2>
        <p class="mt-2 max-w-xl text-slate-300">Ceritakan kebutuhan Anda, saya akan membalas lewat email atau Telegram.</p>
      </div>
      <a
        href="/kontak"
        class="inline-block rounded-md bg-accent px-6 py-3 text-sm font-semibold text-primary hover:opacity-90"
      >
        Hubungi saya
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-open]').forEach(function (b) {
      b.addEventListener('click', function () {
        var d = document.getElementById(b.getAttribute('data-open'));
        if (d && d.showModal) d.showModal();
      });
    });
    document.querySelectorAll('dialog.proj-dialog').forEach(function (d) {
      d.addEventListener('click', function (e) {
        if (e.target === d) d.close();
      });
      d.querySelectorAll('[data-close]').forEach(function (c) {
        c.addEventListener('click', function () {
          d.close();
        });
      });
    });
  })();
</script>
