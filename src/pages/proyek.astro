---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { wrap, EMAIL } from '~/data/profil';
import { projects } from '~/data/proyek';

const metadata = {
  title: 'Portofolio',
};
---

<Layout metadata={metadata}>
  <!-- Judul halaman -->
  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={wrap}>
      <p class="text-xs font-semibold uppercase tracking-wider text-accent">Portofolio</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight sm:text-4xl">Proyek dan hasil kerja</h1>
      <p class="mt-3 max-w-2xl text-sm text-slate-300 sm:text-base">
        Studi kasus singkat: masalah yang ada, solusi yang dibangun, dan hasil yang dirasakan.
      </p>
    </div>
  </section>

  <section class="bg-slate-50 py-8 sm:py-12">
    <div class={`${wrap} space-y-8`}>
      <!-- Diisi dari admin lewat /portofolio/data.php -->
      <div id="daftar" class="space-y-8">
        <p id="muat" class="rounded-xl border border-slate-200 bg-white p-6 text-center text-sm text-muted">Memuat portofolio...</p>
      </div>

      <!-- Cadangan: tampil bila data admin kosong, gagal dimuat, atau JavaScript mati -->
      <div id="statis" hidden class="space-y-8">
      {
        projects.map((p) => (
          <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <!-- Kepala studi kasus -->
            <header class="border-b border-slate-200 p-5 sm:p-8">
              <div class="flex flex-wrap items-center gap-2 text-xs font-medium">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-heading">
                  <Icon name="tabler:calendar-event" class="h-3.5 w-3.5" />
                  {p.tahun}
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-heading">
                  <Icon name="tabler:school" class="h-3.5 w-3.5" />
                  Untuk {p.untuk}
                </span>
              </div>
              <h2 class="mt-4 text-xl font-bold leading-tight tracking-tight text-heading sm:text-3xl">{p.judul}</h2>
              <p class="mt-3 max-w-3xl text-base leading-relaxed text-muted sm:text-lg">{p.ringkasan}</p>
            </header>

            <div class="space-y-8 p-5 sm:space-y-10 sm:p-8">
              <!-- Sebelum -> Sekarang -->
              <div class="grid items-stretch gap-3 md:grid-cols-[1fr_auto_1fr]">
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-muted">Sebelum</p>
                  <p class="mt-2 text-sm leading-relaxed text-default sm:text-base">{p.sebelum}</p>
                </div>
                <div class="flex items-center justify-center text-accent" aria-hidden="true">
                  <Icon name="tabler:arrow-right" class="hidden h-6 w-6 md:block" />
                  <Icon name="tabler:arrow-down" class="h-6 w-6 md:hidden" />
                </div>
                <div class="rounded-xl bg-primary p-4 sm:p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-accent">Sekarang</p>
                  <p class="mt-2 text-sm leading-relaxed text-white sm:text-base">{p.sekarang}</p>
                </div>
              </div>

              <!-- Hasil -->
              <div>
                <h3 class="text-base font-bold text-heading sm:text-lg">Hasil</h3>
                <ul class="mt-3 grid gap-3 sm:grid-cols-3">
                  {p.hasil.map((h) => (
                    <li class="flex gap-3 rounded-xl border border-slate-200 p-4">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/20 text-primary">
                        <Icon name="tabler:check" class="h-4 w-4" />
                      </span>
                      <span class="text-sm leading-snug text-muted">
                        <strong class="block font-semibold text-heading">{h.judul}</strong>
                        {h.isi}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Alat: urut sesuai alur kerja -->
              {
                p.alat && (
                  <div>
                    <h3 class="text-base font-bold text-heading sm:text-lg">Alat yang digunakan</h3>
                    <ol class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4">
                      {p.alat.map((a, n) => (
                        <li class="group overflow-hidden rounded-xl border border-slate-200 bg-white transition hover:border-accent hover:shadow-md">
                          <div class="relative border-b border-slate-200 bg-slate-50">
                            <span class="absolute left-2 top-2 flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-white">
                              {n + 1}
                            </span>
                            <img
                              src={a.gambar}
                              alt={a.nama}
                              width="800"
                              height="600"
                              loading="lazy"
                              decoding="async"
                              class="aspect-[4/3] w-full object-contain p-2"
                            />
                          </div>
                          <div class="p-3 sm:p-4">
                            <p class="text-sm font-semibold leading-snug text-heading">{a.nama}</p>
                            <p class="mt-1 text-xs leading-relaxed text-muted">{a.fungsi}</p>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </div>
                )
              }
            </div>
          </article>
        ))
      }
      </div>

      <!-- Ajakan -->
      <div class="flex flex-col items-start gap-3 rounded-2xl bg-gradient-to-r from-primary to-secondary p-5 text-white sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <p class="text-sm sm:text-base">Butuh sistem serupa untuk sekolah atau organisasi Anda? Ceritakan kebutuhannya lewat email.</p>
        <a
          href={`mailto:${EMAIL}`}
          class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-4 py-2 text-xs font-semibold text-primary sm:text-sm"
        >
          <Icon name="tabler:mail" class="h-4 w-4" /> Hubungi saya
        </a>
      </div>
    </div>
  </section>

  <noscript>
    <style is:inline>
      #statis[hidden] {
        display: block;
      }
      #muat {
        display: none;
      }
    </style>
  </noscript>

  <script is:inline>
    (function () {
      var daftar = document.getElementById('daftar');
      var statis = document.getElementById('statis');
      var muat = document.getElementById('muat');

      var IK = {
        kiri: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6l6 6"/></svg>',
        kanan: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6l-6 6"/></svg>',
        tutup: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>',
        centang: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5l10 -10"/></svg>',
        panah: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6l-6 6"/></svg>',
        luar: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"/><path d="M11 13l9 -9"/><path d="M15 4h5v5"/></svg>'
      };

      function h(tag, cls, txt) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (txt != null) e.textContent = txt;
        return e;
      }
      function ikon(html) {
        var w = document.createElement('span');
        w.innerHTML = html;
        return w.firstChild;
      }
      function tombolIkon(cls, label, html, fn) {
        var b = h('button', cls);
        b.type = 'button';
        b.setAttribute('aria-label', label);
        b.appendChild(ikon(html));
        b.addEventListener('click', function (e) {
          e.stopPropagation();
          fn();
        });
        return b;
      }

      /* ---------- Perbesar foto ---------- */
      function bukaLightbox(fotos, mulai, judul) {
        var i = mulai;
        var ov = h('div', 'fixed inset-0 z-[100] flex flex-col bg-black/95');
        ov.setAttribute('role', 'dialog');
        ov.setAttribute('aria-modal', 'true');
        ov.setAttribute('aria-label', 'Foto ' + judul);
        var atas = h('div', 'flex items-center justify-between p-3 text-white');
        var hitung = h('span', 'text-sm');
        var tutup = tombolIkon('rounded-full p-2 hover:bg-white/10', 'Tutup', IK.tutup, selesai);
        atas.appendChild(hitung);
        atas.appendChild(tutup);
        var tengah = h('div', 'relative flex min-h-0 flex-1 items-center justify-center px-2');
        var img = h('img', 'max-h-full max-w-full object-contain');
        tengah.appendChild(img);
        var ket = h('p', 'px-4 pb-5 pt-2 text-center text-sm text-slate-200');
        function tampil(n) {
          i = (n + fotos.length) % fotos.length;
          img.src = fotos[i].url;
          img.alt = fotos[i].ket || judul;
          ket.textContent = fotos[i].ket || '';
          hitung.textContent = i + 1 + ' / ' + fotos.length;
        }
        if (fotos.length > 1) {
          var kr = tombolIkon('absolute left-2 rounded-full bg-white/15 p-2 text-white hover:bg-white/25', 'Foto sebelumnya', IK.kiri, function () { tampil(i - 1); });
          var kn = tombolIkon('absolute right-2 rounded-full bg-white/15 p-2 text-white hover:bg-white/25', 'Foto berikutnya', IK.kanan, function () { tampil(i + 1); });
          tengah.appendChild(kr);
          tengah.appendChild(kn);
        }
        ov.appendChild(atas);
        ov.appendChild(tengah);
        ov.appendChild(ket);
        ov.addEventListener('click', function (e) {
          if (e.target === ov || e.target === tengah) selesai();
        });
        function tombol(e) {
          if (e.key === 'Escape') selesai();
          else if (e.key === 'ArrowLeft' && fotos.length > 1) tampil(i - 1);
          else if (e.key === 'ArrowRight' && fotos.length > 1) tampil(i + 1);
        }
        function selesai() {
          document.removeEventListener('keydown', tombol);
          document.body.style.overflow = '';
          ov.remove();
        }
        document.addEventListener('keydown', tombol);
        document.body.style.overflow = 'hidden';
        document.body.appendChild(ov);
        tampil(i);
        tutup.focus();
      }

      /* ---------- Galeri foto ---------- */
      function galeri(fotos, judul) {
        var i = 0;
        var kotak = h('div', 'space-y-3');
        var panggung = h('div', 'relative overflow-hidden rounded-xl border border-slate-200 bg-slate-100');
        var buka = h('button', 'block w-full cursor-zoom-in');
        buka.type = 'button';
        buka.setAttribute('aria-label', 'Perbesar foto');
        var img = h('img', 'aspect-[4/3] w-full object-contain sm:aspect-[16/9]');
        img.decoding = 'async';
        buka.appendChild(img);
        buka.addEventListener('click', function () { bukaLightbox(fotos, i, judul); });
        panggung.appendChild(buka);
        var hitung = h('span', 'absolute bottom-2 right-2 rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white');
        if (fotos.length > 1) {
          panggung.appendChild(hitung);
          panggung.appendChild(tombolIkon('absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 text-primary shadow hover:bg-white', 'Foto sebelumnya', IK.kiri, function () { tampil(i - 1); }));
          panggung.appendChild(tombolIkon('absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/90 p-2 text-primary shadow hover:bg-white', 'Foto berikutnya', IK.kanan, function () { tampil(i + 1); }));
        }
        var ket = h('p', 'text-sm text-muted');
        var strip = h('div', 'flex gap-2 overflow-x-auto pb-1');
        var thumbs = [];
        fotos.forEach(function (f, n) {
          var t = h('button', 'h-14 w-20 shrink-0 overflow-hidden rounded-lg border border-slate-200 opacity-70 transition hover:opacity-100');
          t.type = 'button';
          t.setAttribute('aria-label', 'Lihat foto ' + (n + 1));
          var ti = h('img', 'h-full w-full object-cover');
          ti.src = f.thumb || f.url;
          ti.alt = '';
          ti.loading = 'lazy';
          t.appendChild(ti);
          t.addEventListener('click', function () { tampil(n); });
          thumbs.push(t);
          strip.appendChild(t);
        });
        function tampil(n) {
          i = (n + fotos.length) % fotos.length;
          img.src = fotos[i].url;
          img.alt = fotos[i].ket || judul;
          ket.textContent = fotos[i].ket || '';
          ket.hidden = !fotos[i].ket;
          hitung.textContent = i + 1 + ' / ' + fotos.length;
          thumbs.forEach(function (t, k) {
            t.classList.toggle('opacity-100', k === i);
            t.classList.toggle('ring-2', k === i);
            t.classList.toggle('ring-accent', k === i);
            t.classList.toggle('opacity-70', k !== i);
          });
          var depan = new Image();
          depan.src = fotos[(i + 1) % fotos.length].url;
        }
        kotak.appendChild(panggung);
        kotak.appendChild(ket);
        if (fotos.length > 1) kotak.appendChild(strip);
        tampil(0);
        return kotak;
      }

      /* ---------- Kartu proyek ---------- */
      function chip(teks) {
        return h('span', 'inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-heading', teks);
      }
      function judulBagian(teks) {
        return h('h3', 'text-base font-bold text-heading sm:text-lg', teks);
      }

      function kartu(p) {
        var a = h('article', 'overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm');
        if (p.id) a.id = 'p-' + p.id;

        var kepala = h('header', 'border-b border-slate-200 p-5 sm:p-8');
        var baris = h('div', 'flex flex-wrap items-center gap-2');
        if (p.tahun) baris.appendChild(chip(p.tahun));
        if (p.untuk) baris.appendChild(chip('Untuk ' + p.untuk));
        if (p.kategori) baris.appendChild(chip(p.kategori));
        if (baris.children.length) kepala.appendChild(baris);
        kepala.appendChild(h('h2', 'mt-4 text-xl font-bold leading-tight tracking-tight text-heading sm:text-3xl', p.judul));
        if (p.ringkasan) kepala.appendChild(h('p', 'mt-3 max-w-3xl text-base leading-relaxed text-muted sm:text-lg', p.ringkasan));
        a.appendChild(kepala);

        var isi = h('div', 'space-y-8 p-5 sm:space-y-10 sm:p-8');

        if (p.foto && p.foto.length) isi.appendChild(galeri(p.foto, p.judul));

        if (p.keterangan) {
          var kg = h('div', 'max-w-3xl space-y-3');
          p.keterangan.split(/\n{2,}/).forEach(function (t) {
            t = t.trim();
            if (t) {
              var para = h('p', 'text-base leading-relaxed text-default', t);
              para.style.whiteSpace = 'pre-line';
              kg.appendChild(para);
            }
          });
          isi.appendChild(kg);
        }

        if (p.sebelum || p.sekarang) {
          var g = h('div', 'grid items-stretch gap-3 md:grid-cols-[1fr_auto_1fr]');
          if (p.sebelum && p.sekarang) {
            var s1 = h('div', 'rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-5');
            s1.appendChild(h('p', 'text-xs font-semibold uppercase tracking-wider text-muted', 'Sebelum'));
            s1.appendChild(h('p', 'mt-2 text-sm leading-relaxed text-default sm:text-base', p.sebelum));
            var pn = h('div', 'flex items-center justify-center text-accent');
            pn.setAttribute('aria-hidden', 'true');
            var pi = ikon(IK.panah);
            pi.setAttribute('class', 'rotate-90 md:rotate-0');
            pn.appendChild(pi);
            var s2 = h('div', 'rounded-xl bg-primary p-4 sm:p-5');
            s2.appendChild(h('p', 'text-xs font-semibold uppercase tracking-wider text-accent', 'Sekarang'));
            s2.appendChild(h('p', 'mt-2 text-sm leading-relaxed text-white sm:text-base', p.sekarang));
            g.appendChild(s1);
            g.appendChild(pn);
            g.appendChild(s2);
          } else {
            g.className = 'grid gap-3';
            var satu = h('div', p.sekarang ? 'rounded-xl bg-primary p-4 sm:p-5' : 'rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-5');
            satu.appendChild(h('p', p.sekarang ? 'text-xs font-semibold uppercase tracking-wider text-accent' : 'text-xs font-semibold uppercase tracking-wider text-muted', p.sekarang ? 'Sekarang' : 'Sebelum'));
            satu.appendChild(h('p', p.sekarang ? 'mt-2 text-sm leading-relaxed text-white sm:text-base' : 'mt-2 text-sm leading-relaxed text-default sm:text-base', p.sekarang || p.sebelum));
            g.appendChild(satu);
          }
          isi.appendChild(g);
        }

        if (p.hasil && p.hasil.length) {
          var hb = h('div');
          hb.appendChild(judulBagian('Hasil'));
          var ul = h('ul', 'mt-3 grid gap-3 sm:grid-cols-3');
          p.hasil.forEach(function (x) {
            var li = h('li', 'flex gap-3 rounded-xl border border-slate-200 p-4');
            var ck = h('span', 'mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/20 text-primary');
            ck.appendChild(ikon(IK.centang));
            var tx = h('span', 'text-sm leading-snug text-muted');
            if (x.judul) tx.appendChild(h('strong', 'block font-semibold text-heading', x.judul));
            tx.appendChild(document.createTextNode(x.isi || ''));
            li.appendChild(ck);
            li.appendChild(tx);
            ul.appendChild(li);
          });
          hb.appendChild(ul);
          isi.appendChild(hb);
        }

        if (p.alat && p.alat.length) {
          var ab = h('div');
          ab.appendChild(judulBagian('Alat yang digunakan'));
          var ol = h('ol', 'mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4');
          p.alat.forEach(function (x, n) {
            var li = h('li', 'overflow-hidden rounded-xl border border-slate-200 bg-white');
            if (x.gambar) {
              var wrapImg = h('div', 'relative border-b border-slate-200 bg-slate-50');
              wrapImg.appendChild(h('span', 'absolute left-2 top-2 flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-white', String(n + 1)));
              var im = h('img', 'aspect-[4/3] w-full object-contain p-2');
              im.src = x.gambar;
              im.alt = x.nama;
              im.loading = 'lazy';
              im.decoding = 'async';
              wrapImg.appendChild(im);
              li.appendChild(wrapImg);
            }
            var tb = h('div', 'p-3 sm:p-4');
            tb.appendChild(h('p', 'text-sm font-semibold leading-snug text-heading', (x.gambar ? '' : n + 1 + '. ') + x.nama));
            if (x.fungsi) tb.appendChild(h('p', 'mt-1 text-xs leading-relaxed text-muted', x.fungsi));
            li.appendChild(tb);
            ol.appendChild(li);
          });
          ab.appendChild(ol);
          isi.appendChild(ab);
        }

        if (p.tautan && /^https?:\/\//i.test(p.tautan)) {
          var ln = h('a', 'inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90');
          ln.href = p.tautan;
          ln.target = '_blank';
          ln.rel = 'noopener noreferrer';
          ln.appendChild(document.createTextNode('Kunjungi proyek'));
          ln.appendChild(ikon(IK.luar));
          isi.appendChild(ln);
        }

        a.appendChild(isi);
        return a;
      }

      function cadangan() {
        if (muat) muat.remove();
        statis.hidden = false;
      }

      fetch('/portofolio/data.php', { cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('http');
          return r.json();
        })
        .then(function (j) {
          var l = j && j.portofolio;
          if (!Array.isArray(l) || !l.length) {
            cadangan();
            return;
          }
          if (muat) muat.remove();
          l.forEach(function (p) {
            daftar.appendChild(kartu(p));
          });
        })
        .catch(cadangan);
    })();
  </script>
</Layout>
