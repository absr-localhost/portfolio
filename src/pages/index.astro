---
import Layout from '~/layouts/PageLayout.astro';
import Ulasan from '~/components/Ulasan.astro';
import VideoBeranda from '~/components/VideoBeranda.astro';
import StatistikPanel from '~/components/StatistikPanel.astro';
import { wrap, stats, about, EMAIL } from '~/data/profil';

const metadata = {
  title: 'Beranda',
};

const card = 'rounded-lg border border-slate-200 bg-white shadow-sm';
---

<Layout metadata={metadata}>
  <section class="relative isolate overflow-hidden bg-primary text-white">
    <img
      src="/gedung-jakarta.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 -z-20 h-full w-full object-cover grayscale"
      width="1224"
      height="816"
    />
    <div class="absolute inset-0 -z-10 bg-primary/80"></div>

    <div class={`${wrap} grid items-end gap-6 pt-12 md:grid-cols-2 md:pt-20`}>
      <div class="pb-8 md:pb-20">
        <p class="mb-4 flex flex-wrap items-center gap-3 text-sm uppercase tracking-widest">
          <b class="text-accent">IT Specialist</b>
          <span class="text-slate-300">Full-Stack Developer</span>
        </p>
        <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          AGUS BUDIONO, S.Pd.
        </h1>
        <p class="mt-4 max-w-xl text-slate-200">
          Profesional teknologi informasi dari Sumatera Selatan. Membangun aplikasi, mengelola sistem, dan
          menjaga keamanan digital.
        </p>
        <p class="mt-4 inline-block rounded-sm border border-white/40 px-3 py-1 text-xs uppercase tracking-widest">
          Tersedia untuk proyek
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/proyek" class="rounded-md bg-accent px-5 py-3 text-sm font-semibold text-primary transition hover:brightness-95">Lihat portofolio</a>
          <a href={`mailto:${EMAIL}`} class="rounded-md border border-white px-5 py-3 text-sm font-semibold transition hover:bg-white/10">Hubungi saya</a>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/pk-3.webp"
          alt="Foto profil AGUS BUDIONO, S.Pd."
          class="max-h-[420px] w-auto object-contain md:max-h-[560px]"
          width="860"
          height="851"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class={`${wrap} py-14 sm:py-16`}>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        stats.map((s) => (
          <div class={`${card} p-6`}>
            <p class="text-4xl font-bold text-heading">{s.n}</p>
            <p class="mt-2 text-sm text-muted">{s.t}</p>
          </div>
        ))
      }
    </div>
  </section>

  <VideoBeranda />

  <StatistikPanel judul="Statistik situs" />


  <section class={`${wrap} pb-14 sm:pb-16`}>
    <div class="grid gap-6 lg:grid-cols-5">
      <div id="tp" class={`${card} p-6 sm:p-8 lg:col-span-3`}>
        <h2 class="mb-4 text-2xl font-bold text-heading">Tentang saya</h2>
        <div class="space-y-4 leading-relaxed text-muted">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div id="ab" class={`${card} p-6 lg:col-span-2`} hidden>
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h2 class="text-2xl font-bold text-heading">Artikel</h2>
          <a href="/artikel" class="shrink-0 text-sm font-semibold text-link hover:underline">Semua artikel</a>
        </div>
        <div id="ab-list"></div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var box = document.getElementById('ab');
      var list = document.getElementById('ab-list');
      var tp = document.getElementById('tp');
      if (!box || !list || !tp) return;
      function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text) e.textContent = text;
        return e;
      }
      fetch('/artikel/terbaru.php?t=' + Date.now(), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          var arr = d && d.artikel ? d.artikel.slice(0, 5) : [];
          if (!arr.length) {
            tp.classList.remove('lg:col-span-3');
            tp.classList.add('lg:col-span-5');
            return;
          }
          arr.forEach(function (it) {
            var a = el('a', 'group flex gap-3 border-t border-slate-200 py-3 first:border-t-0 first:pt-0');
            a.href = '/artikel/' + it.slug;
            var th;
            if (it.foto) {
              th = el('img', 'h-16 w-24 shrink-0 rounded-md bg-slate-200 object-cover');
              th.src = it.foto;
              th.alt = '';
              th.loading = 'lazy';
              th.width = 96;
              th.height = 64;
            } else {
              th = el('div', 'h-16 w-24 shrink-0 rounded-md bg-slate-200');
            }
            var tx = el('div', 'min-w-0');
            var meta = el('p', 'text-xs text-muted');
            if (it.kategori) meta.appendChild(el('span', 'mr-2 font-semibold text-primary', it.kategori));
            meta.appendChild(el('span', '', it.tanggal));
            tx.appendChild(meta);
            tx.appendChild(el('p', 'mt-0.5 text-sm font-semibold leading-snug text-heading group-hover:underline', it.judul));
            a.appendChild(th);
            a.appendChild(tx);
            list.appendChild(a);
          });
          box.hidden = false;
        })
        .catch(function () {
          tp.classList.remove('lg:col-span-3');
          tp.classList.add('lg:col-span-5');
        });
    })();
  </script>

  <Ulasan />


  <section class="bg-primary py-14 text-white sm:py-16">
    <div class={`${wrap} flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between`}>
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">Punya proyek atau kebutuhan IT?</h2>
        <p class="mt-2 max-w-xl text-slate-300">Ceritakan kebutuhan Anda lewat email.</p>
      </div>
      <a href={`mailto:${EMAIL}`} class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-primary transition hover:brightness-95">Hubungi saya</a>
    </div>
  </section>
</Layout>
