---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, stats, about, pages, EMAIL } from '~/data/profil';

const metadata = {
  title: 'Agus Budiono, S.Pd. | System Administrator & Cybersecurity',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="bg-[#0B1F4B] pb-24 pt-14 text-white sm:pt-24">
    <div class={wrap}>
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-300">IT Specialist &middot; Full-Stack Developer</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl">
        Agus Budiono<span class="text-2xl font-semibold text-slate-300 sm:text-3xl">, S.Pd.</span>
      </h1>
      <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-slate-200 sm:text-base">System Administrator &amp; Cybersecurity</p>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
        Dari kode, server, dan jaringan hingga keamanan dan automasi: ceritakan kebutuhan Anda, kita rancang sistem digital yang rapi, aman, dan benar-benar terpakai.
      </p>
      <p class="mt-3 text-sm text-slate-400">Sumatera Selatan, Indonesia &middot; Tersedia untuk proyek</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`mailto:${EMAIL}`} class="bg-white px-6 py-3 text-sm font-semibold text-[#0B1F4B] hover:bg-slate-200">Hubungi Saya</a>
        <a href="/proyek" class="border border-white/40 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">Lihat Proyek</a>
      </div>
    </div>
  </section>

  <section class={`${wrap} relative z-10 -mt-12`}>
    <div class="grid grid-cols-3 gap-2 sm:gap-4">
      {
        stats.map((s) => (
          <div class={`${card} px-2 py-4 text-center sm:px-4 sm:py-6`}>
            <div class="text-2xl font-extrabold text-black dark:text-white sm:text-4xl">{s.n}</div>
            <div class="mt-1.5 text-[11px] leading-snug text-neutral-600 dark:text-neutral-400 sm:text-sm">{s.t}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class={wrap}>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Profil</p>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-neutral-600 dark:text-neutral-300 sm:text-lg">{about[0]}</p>
      <a href="/tentang" class="mt-6 inline-block border border-neutral-900 px-5 py-2.5 text-sm font-semibold hover:bg-neutral-100 dark:border-neutral-300 dark:hover:bg-neutral-800">Selengkapnya</a>
    </div>
  </section>

  <section class="bg-neutral-50 py-14 dark:bg-neutral-950 sm:py-20">
    <div class={wrap}>
      <h2 class="text-2xl font-bold sm:text-3xl">Jelajahi</h2>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          pages.map(([t, h, d]) => (
            <a href={h} class={`${card} block p-5 hover:bg-neutral-50 dark:hover:bg-neutral-800`}>
              <div class="text-lg font-bold">{t}</div>
              <div class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{d}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
