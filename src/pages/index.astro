---
import Layout from '~/layouts/PageLayout.astro';
import Ulasan from '~/components/Ulasan.astro';
import VideoBeranda from '~/components/VideoBeranda.astro';
import StatistikPanel from '~/components/StatistikPanel.astro';
import { Icon } from 'astro-icon/components';
import { wrap, stats, about, socials, services, projects, EMAIL, slugKategori } from '~/data/profil';

const metadata = {
  title: 'Beranda',
};

// Kartu datar: garis tipis, tanpa bayangan, sudut kecil
const card = 'rounded-xl border border-slate-200 bg-white shadow-sm';
const judulBlok = 'text-sm font-bold text-heading sm:text-base';
const garis = 'mt-1 block h-0.5 w-8 bg-accent';

const ikonStat = ['tabler:calendar-event', 'tabler:briefcase', 'tabler:award'];
const ikonLayanan = [
  'tabler:code',
  'tabler:server',
  'tabler:bulb',
  'tabler:shield-lock',
  'tabler:bolt',
  'tabler:palette',
  'tabler:school',
  'tabler:rocket',
];
const ikonProyek = [
  'tabler:world-www',
  'tabler:school',
  'tabler:bolt',
  'tabler:server',
  'tabler:shield-lock',
  'tabler:movie',
  'tabler:bulb',
];

// Logo teknologi: WebP kecil (96px) disematkan langsung agar tidak perlu file gambar tambahan
const logo: Record<string, string> = {
  'HTML': 'data:image/webp;base64,',
  'CSS': 'data:image/webp;base64,',
  'JavaScript': 'data:image/webp;base64,',
  'PHP': 'data:image/webp;base64,',
  'Python': 'data:image/webp;base64,',
  'Java': 'data:image/webp;base64,',
  'C#': 'data:image/webp;base64,',
  'Dart': 'data:image/webp;base64,',
  'Flutter': 'data:image/webp;base64,',
  'Android': 'data:image/webp;base64,',
  'React': 'data:image/webp;base64,',
  'Laravel': 'data:image/webp;base64,',
  'Astro': 'data:image/webp;base64,',
  'Tailwind': 'data:image/webp;base64,',
  'SQL': 'data:image/webp;base64,',
  'MySQL': 'data:image/webp;base64,',
  'GitHub': 'data:image/webp;base64,',
  'Cloudflare': 'data:image/webp;base64,',
  'Linux': 'data:image/webp;base64,',
  'Windows': 'data:image/webp;base64,',
  'Telegram': 'data:image/webp;base64,',
  'Grok': 'data:image/webp;base64,',
  'Excel': 'data:image/webp;base64,',
  'Word': 'data:image/webp;base64,',
  'PowerPoint': 'data:image/webp;base64,',
  'Power Automate': 'data:image/webp;base64,',
  'Google Sheets': 'data:image/webp;base64,',
  'Google Drive': 'data:image/webp;base64,',
  'OneDrive': 'data:image/webp;base64,',
  'Google Classroom': 'data:image/webp;base64,',
  'Photoshop': 'data:image/webp;base64,',
  'Lightroom': 'data:image/webp;base64,',
  'Premiere Pro': 'data:image/webp;base64,',
  'After Effects': 'data:image/webp;base64,',
  'Canva': 'data:image/webp;base64,',
  'PixelLab': 'data:image/webp;base64,',
  'OBS Studio': 'data:image/webp;base64,',
  'Zoom': 'data:image/webp;base64,',
  'Google Meet': 'data:image/webp;base64,',
};

const kelompok: [string, string[]][] = [
  ['Pemrograman, web dan server', ['HTML', 'CSS', 'JavaScript', 'PHP', 'Python', 'Java', 'C#', 'Dart', 'Flutter', 'Android', 'React', 'Laravel', 'Astro', 'Tailwind', 'SQL', 'MySQL', 'GitHub', 'Cloudflare', 'Linux', 'Windows', 'Telegram', 'Grok']],
  ['Perkantoran dan penyimpanan', ['Excel', 'Word', 'PowerPoint', 'Power Automate', 'Google Sheets', 'Google Drive', 'OneDrive', 'Google Classroom']],
  ['Desain dan multimedia', ['Photoshop', 'Lightroom', 'Premiere Pro', 'After Effects', 'Canva', 'PixelLab', 'OBS Studio']],
  ['Rapat online', ['Zoom', 'Google Meet']],
];

const ikonSosial: Record<string, string> = {
  Telegram: 'tabler:brand-telegram',
  LinkedIn: 'tabler:brand-linkedin',
  GitHub: 'tabler:brand-github',
  TikTok: 'tabler:brand-tiktok',
  YouTube: 'tabler:brand-youtube',
};
---

<Layout metadata={metadata}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet" />

  <!-- 1. HERO: banner kartu -->
  <section class={`${wrap} pt-4 sm:pt-6`}>
    <div class="relative isolate overflow-hidden rounded-2xl bg-primary text-white shadow-lg">
      <img
        src="/gedung-jakarta.jpg"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 -z-20 h-full w-full object-cover grayscale"
        width="1224"
        height="816"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-primary via-primary/90 to-primary/50"></div>

      <div class="grid items-end gap-4 px-4 pt-6 sm:px-8 md:grid-cols-2 md:gap-6 md:pt-12">
        <div class="pb-2 md:pb-14">
          <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs uppercase tracking-wider sm:text-sm">
            <b class="text-accent">IT Specialist</b>
            <span class="text-slate-300">Full-Stack Developer</span>
          </p>
          <h1 class="judul-hero">AGUS BUDIONO, S.Pd.</h1>
          <p class="mt-3 max-w-xl text-sm text-slate-200 sm:text-base">
            Profesional teknologi informasi dari Sumatera Selatan. Membangun aplikasi, mengelola sistem, dan
            menjaga keamanan digital.
          </p>
          <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-white/40 px-3 py-1 text-[11px] uppercase tracking-wider sm:text-xs">
            <img src="/centang-biru.png" alt="" aria-hidden="true" width="18" height="18" class="h-[18px] w-[18px] shrink-0" />
            Tersedia untuk proyek
          </p>
          <div class="mt-4 flex flex-wrap gap-2 sm:mt-6 sm:gap-3">
            <a href="/proyek" class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-4 py-2 text-xs font-semibold text-primary sm:px-5 sm:py-2.5 sm:text-sm">
              Lihat portofolio
              <Icon name="tabler:arrow-right" class="h-4 w-4" />
            </a>
            <a href={`mailto:${EMAIL}`} class="inline-flex items-center gap-1.5 rounded-lg border border-white px-4 py-2 text-xs font-semibold hover:bg-white/10 sm:px-5 sm:py-2.5 sm:text-sm">
              <Icon name="tabler:mail" class="h-4 w-4" />
              Hubungi saya
            </a>
          </div>
        </div>

        <div class="flex justify-center md:justify-end">
          <img
            src="/pk-3.webp"
            alt="Foto profil AGUS BUDIONO, S.Pd."
            class="w-full max-w-[360px] object-contain sm:max-h-[320px] sm:w-auto sm:max-w-none md:max-h-[460px]"
            width="860"
            height="851"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. ANGKA RINGKAS: tetap 3 kolom di HP -->
  <section class={`${wrap} pb-3 pt-4 sm:pb-4 sm:pt-6`}>
    <div class="grid grid-cols-3 gap-2 sm:gap-3">
      {
        stats.map((s, i) => (
          <div class={`${card} p-3 sm:p-5`}>
            <span class="mb-2 flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary sm:h-10 sm:w-10">
              <Icon name={ikonStat[i] || 'tabler:star'} class="h-4 w-4 sm:h-5 sm:w-5" />
            </span>
            <p class="text-xl font-bold leading-none text-heading sm:text-3xl">{s.n}</p>
            <p class="mt-1.5 text-[11px] leading-snug text-muted sm:mt-2 sm:text-sm">{s.t}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3. VIDEO -->
  <VideoBeranda />

  <!-- 3b. PORTOFOLIO PROYEK (dari data proyek yang sudah ada) -->
  <section id="portofolio" class={`${wrap} scroll-mt-16 pt-5 sm:pt-8`}>
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 class="judul-seksi">Portofolio proyek</h2>
      <a href="/proyek" class="inline-flex items-center gap-1 text-xs font-semibold text-link hover:underline sm:text-sm">
        Lihat semua <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 sm:gap-3 lg:grid-cols-3">
      {
        projects.slice(0, 6).map((pr, i) => (
          <a href={`/proyek/${slugKategori(pr.title)}`} class={`${card} group flex gap-3 p-3 transition hover:border-accent sm:p-4`}>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary text-white">
              <Icon name={ikonProyek[i] || 'tabler:folder'} class="h-5 w-5" />
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-bold leading-snug text-heading">{pr.title}</span>
              <span class="mt-0.5 block text-xs text-muted">{pr.items.length} proyek &middot; {pr.items.slice(0, 2).join(', ')}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 3c. KEAHLIAN: logo teknologi + layanan -->
  <section class={`${wrap} pt-5 sm:pt-8`}>
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 class="judul-seksi">Keahlian saya</h2>
      <a href="/layanan#keahlian" class="inline-flex items-center gap-1 text-xs font-semibold text-link hover:underline sm:text-sm">
        Lihat semua <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </a>
    </div>
    {
      kelompok.map(([judul, daftar], gi) => (
        <div class={gi ? 'mt-4' : ''}>
          <p class="mb-2 text-xs font-semibold text-muted sm:text-sm">{judul}</p>
          <div class="grid grid-cols-4 gap-2 sm:grid-cols-5 sm:gap-3 lg:grid-cols-8 xl:grid-cols-10">
            {daftar.map((nama) => (
              <div class={`${card} flex flex-col items-center gap-1.5 px-1 py-2.5 sm:py-3`}>
                <img src={logo[nama]} alt="" width="40" height="40" loading="lazy" decoding="async" class="h-9 w-9 object-contain sm:h-10 sm:w-10" />
                <span class="text-center text-[11px] font-medium leading-tight text-heading sm:text-xs">{nama}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }

    <h3 class="mb-3 mt-6 text-sm font-bold text-heading sm:text-base">Layanan</h3>
    <div class="grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-4">
      {
        services.map((t, i) => (
          <div class={`${card} flex flex-col items-start gap-2 p-3 sm:p-4`}>
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/20 text-primary">
              <Icon name={ikonLayanan[i] || 'tabler:star'} class="h-5 w-5" />
            </span>
            <span class="text-xs font-semibold leading-snug text-heading sm:text-sm">{t}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!--
    4. TATA LETAK 3 KOLOM
    Desktop (1024px+): [Sosial media] [Tentang saya di tengah] [Artikel]
    HP/tablet: Tentang saya di atas, lalu Sosial media (kiri) dan Artikel (kanan) berdampingan.
  -->
  <section class={`${wrap} pb-2 pt-4 sm:pb-4 sm:pt-6`}>
    <div id="tata" class="tata">
      <!-- Tengah: Tentang saya -->
      <article id="tp" class={`t-tp ${card} flow-root p-3.5 sm:p-5`}>
        <div
          class="float-left mb-1 mr-3 h-16 w-16 overflow-hidden rounded bg-primary sm:mr-4 sm:h-24 sm:w-24 lg:h-28 lg:w-28"
        >
          <img
            src="/pk-3.webp"
            alt="Foto profil AGUS BUDIONO, S.Pd."
            class="h-full w-full object-cover object-top"
            width="112"
            height="112"
            loading="lazy"
          />
        </div>
        <h2 class={judulBlok}>Tentang saya<span class={garis}></span></h2>
        <div class="mt-3 space-y-2.5 text-[13px] leading-relaxed text-muted sm:space-y-3 sm:text-sm">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </article>

      <!-- Kiri: sosial media -->
      <aside id="sos" class={`t-sos ${card} p-2 sm:p-4`}>
        <h2 class={`${judulBlok} px-1 pb-2`}>Sosial media<span class={garis}></span></h2>
        <ul class="space-y-0.5">
          {
            socials.map(([nama, url]) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 rounded p-1 text-muted hover:bg-slate-50 hover:text-heading sm:gap-2.5 sm:p-1.5"
                >
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white sm:h-8 sm:w-8">
                    <Icon name={ikonSosial[nama] || 'tabler:link'} class="h-4 w-4" />
                  </span>
                  <span class="min-w-0 truncate text-xs font-medium sm:text-sm">{nama}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${EMAIL}`}
              class="flex items-center gap-1.5 rounded p-1 text-muted hover:bg-slate-50 hover:text-heading sm:gap-2.5 sm:p-1.5"
            >
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white sm:h-8 sm:w-8">
                <Icon name="tabler:mail" class="h-4 w-4" />
              </span>
              <span class="min-w-0 truncate text-xs font-medium sm:text-sm">Email</span>
            </a>
          </li>
        </ul>
      </aside>

      <!-- Kanan: artikel (kerangka abu-abu tampil dulu, diisi saat data masuk) -->
      <aside id="ab" class={`t-ab ${card} p-2.5 sm:p-4`}>
        <div class="mb-2 flex items-start justify-between gap-2 sm:mb-3">
          <h2 class={judulBlok}>Artikel<span class={garis}></span></h2>
          <a href="/artikel" class="shrink-0 text-xs font-semibold text-link hover:underline">Semua</a>
        </div>
        <div id="ab-list">
          <div class="space-y-2" aria-hidden="true">
            <div class="h-12 rounded bg-slate-100 sm:h-14"></div>
            <div class="h-12 rounded bg-slate-100 sm:h-14"></div>
            <div class="h-12 rounded bg-slate-100 sm:h-14"></div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      if (window.__abSiap) return;
      window.__abSiap = true;

      var JEDA = [1000, 2000, 4000];

      function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text) e.textContent = text;
        return e;
      }

      // Artikel tidak tersedia: sembunyikan kolom artikel, tata letak menyesuaikan
      function tanpaArtikel(grid, box) {
        grid.setAttribute('data-sepi', '');
        box.hidden = true;
      }

      function ambil(url, ms) {
        var c = new AbortController();
        var t = setTimeout(function () {
          c.abort();
        }, ms);
        return fetch(url, { cache: 'no-store', signal: c.signal }).then(
          function (r) {
            clearTimeout(t);
            if (!r.ok) throw new Error('http');
            return r.json();
          },
          function (e) {
            clearTimeout(t);
            throw e;
          }
        );
      }

      function coba(n, box) {
        return ambil('/artikel/terbaru.php?t=' + Date.now(), 8000).catch(function (e) {
          if (n >= JEDA.length || !box.isConnected) throw e;
          return new Promise(function (ok) {
            setTimeout(ok, JEDA[n]);
          }).then(function () {
            return coba(n + 1, box);
          });
        });
      }

      function siap() {
        var box = document.getElementById('ab');
        var list = document.getElementById('ab-list');
        var grid = document.getElementById('tata');
        if (!box || !list || !grid || box.dataset.siap) return;
        box.dataset.siap = '1';

        coba(0, box)
          .then(function (d) {
            if (!box.isConnected) return;
            var arr = d && d.artikel ? d.artikel.slice(0, 5) : [];
            if (!arr.length) {
              tanpaArtikel(grid, box);
              return;
            }
            list.textContent = '';
            arr.forEach(function (it) {
              var a = el('a', 'group flex gap-2 border-t border-slate-200 py-2 first:border-t-0 first:pt-0 sm:gap-3 sm:py-3');
              a.href = '/artikel/' + it.slug;

              var th;
              if (it.foto) {
                th = el('img', 'h-12 w-16 shrink-0 rounded-lg bg-slate-100 object-contain sm:h-14 sm:w-20');
                th.src = it.foto;
                th.alt = '';
                th.loading = 'lazy';
                th.width = 80;
                th.height = 56;
              } else {
                th = el('div', 'h-12 w-16 shrink-0 rounded-lg bg-slate-200 sm:h-14 sm:w-20');
              }

              var tx = el('div', 'min-w-0');
              var meta = el('p', 'text-[10px] leading-tight text-muted sm:text-xs');
              if (it.kategori) meta.appendChild(el('span', 'mr-1.5 font-semibold text-primary', it.kategori));
              meta.appendChild(el('span', '', it.tanggal));
              tx.appendChild(meta);
              tx.appendChild(
                el('p', 'mt-0.5 text-xs font-semibold leading-snug text-heading group-hover:underline sm:text-sm', it.judul)
              );

              // Deskripsi singkat: hanya tampil di layar sedang ke atas
              var desk = it.ringkas || it.deskripsi || it.ringkasan || it.excerpt;
              if (desk) {
                var w = el('div', 'hidden sm:block');
                w.appendChild(el('p', 'mt-0.5 line-clamp-2 text-xs text-muted', desk));
                tx.appendChild(w);
              }

              a.appendChild(th);
              a.appendChild(tx);
              list.appendChild(a);
            });
          })
          .catch(function () {
            if (box.isConnected) tanpaArtikel(grid, box);
          });
      }

      document.addEventListener('astro:page-load', siap);
    })();
  </script>

  <!-- 5. STATISTIK SITUS + DASHBOARD -->
  <StatistikPanel judul="Statistik situs" />

  <!-- 6. ULASAN -->
  <Ulasan />

  <!-- 7. AJAKAN -->
  <section class={`${wrap} py-6 sm:py-10`}>
    <div class="flex flex-col items-start gap-4 rounded-2xl bg-gradient-to-r from-primary to-secondary p-5 text-white shadow-lg sm:p-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-lg font-bold sm:text-2xl">Punya proyek atau kebutuhan IT?</h2>
        <p class="mt-1 max-w-xl text-sm text-slate-300 sm:text-base">Ceritakan kebutuhan Anda lewat email.</p>
      </div>
      <a href={`mailto:${EMAIL}`} class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-4 py-2 text-xs font-semibold text-primary sm:px-5 sm:py-2.5 sm:text-sm">
        <Icon name="tabler:mail" class="h-4 w-4" />
        Hubungi saya
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Judul hero: Archivo Black (besar dan tebal), putih */
  .judul-hero {
    font-family: 'Archivo Black', Impact, 'Arial Black', sans-serif;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    color: #ffffff;
    font-size: clamp(1.6rem, 7.2vw, 3.25rem);
    text-wrap: balance;
  }

  /* Judul seksi: batang aksen di kiri */
  .judul-seksi {
    border-left: 4px solid rgb(200 162 74);
    padding-left: 0.625rem;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    color: rgb(11 37 69);
  }
  @media (min-width: 640px) {
    .judul-seksi {
      font-size: 1.25rem;
    }
  }

  /* HP: Tentang saya penuh di atas; Sosial (kiri) dan Artikel (kanan) berdampingan */
  .tata {
    display: grid;
    align-items: start;
    gap: 0.625rem;
    grid-template-columns: 6.75rem minmax(0, 1fr);
  }
  .tata > .t-tp {
    grid-column: 1 / -1;
  }

  @media (min-width: 640px) {
    .tata {
      gap: 1rem;
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  /* Desktop: 3 kolom, Tentang saya di tengah */
  @media (min-width: 1024px) {
    .tata {
      gap: 1.5rem;
      grid-template-columns: 13rem minmax(0, 1fr) 19rem;
    }
    .tata > .t-sos {
      order: 1;
    }
    .tata > .t-tp {
      order: 2;
      grid-column: auto;
    }
    .tata > .t-ab {
      order: 3;
    }
  }

  /* Jika artikel gagal dimuat */
  .tata[data-sepi] {
    grid-template-columns: minmax(0, 1fr);
  }
  .tata[data-sepi] > .t-sos {
    grid-column: 1 / -1;
  }
  @media (min-width: 1024px) {
    .tata[data-sepi] {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    .tata[data-sepi] > .t-sos {
      grid-column: auto;
    }
  }
</style>
