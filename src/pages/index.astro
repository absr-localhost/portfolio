---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Agus Budiono, S.Pd. — IT Specialist, Full-Stack Developer & Keamanan Siber',
  description:
    'Agus Budiono, S.Pd., profesional IT dari Sumatera Selatan: pengembangan full-stack, administrasi sistem dan jaringan, automasi, dan keamanan siber.',
  ignoreTitleTemplate: true,
};

const stats = [
  { angka: '2017', teks: 'Mulai menekuni dunia IT' },
  { angka: '57+', teks: 'Proyek dan pekerjaan selesai' },
  { angka: '23+', teks: 'Peran dan bidang keahlian' },
];

const layanan = [
  'Pengembangan website & aplikasi (full-stack)',
  'Administrasi server, jaringan & dukungan IT',
  'Konsultasi IT & transformasi digital',
  'Penetration testing berizin & keamanan defensif',
  'Automasi VBA & Power Platform',
  'Desain grafis & video',
  'Solusi digital untuk pendidikan',
  'Pengembangan produk digital & MVP',
];

const peran = [
  { judul: 'IT Generalist', teks: 'Menguasai berbagai area IT sekaligus sehingga masalah dapat ditangani dari akar sampai solusi.' },
  { judul: 'Full-Stack Engineer / Developer', teks: 'Membangun aplikasi web dan seluler dari basis data, backend, hingga antarmuka.' },
  { judul: 'IT Jack-of-All-Trades', teks: 'Fleksibel beralih antara pemrograman, jaringan, perangkat, dan dokumentasi sesuai kebutuhan.' },
  { judul: 'IT Support Specialist', teks: 'Menangani keluhan pengguna dengan cepat, jelas, dan terdokumentasi.' },
  { judul: 'System Administrator (SysAdmin)', teks: 'Mengelola server, akun, cadangan data, dan ketersediaan layanan.' },
  { judul: 'IT Consultant', teks: 'Menganalisis kebutuhan dan merekomendasikan solusi yang tepat guna dan sesuai anggaran.' },
  { judul: 'Ethical Hacker / Penetration Tester', teks: 'Menguji keamanan sistem secara legal dengan izin tertulis dan melaporkan temuan beserta perbaikannya.' },
  { judul: 'Multimedia Specialist', teks: 'Desain grafis, penyuntingan video, dan materi visual untuk komunikasi dan edukasi.' },
  { judul: 'VBA / Macro Developer', teks: 'Mengotomasi pekerjaan Excel dan Office agar pekerjaan berulang selesai dalam hitungan detik.' },
  { judul: 'Power Platform Developer', teks: 'Membangun Power Apps, Power Automate, dan Power BI untuk alur kerja dan pelaporan.' },
  { judul: 'Solo Tech Founder / CTO', teks: 'Memimpin produk dari ide, arsitektur teknis, pengembangan, hingga operasional.' },
  { judul: 'IT Specialist', teks: 'Spesialis lintas bidang yang merancang, membangun, dan merawat sistem digital secara menyeluruh.' },
  { judul: 'Cybersecurity', teks: 'Menanamkan keamanan sejak desain: pertahanan, pengujian berizin, kesadaran pengguna, dan respons insiden.' },
  { judul: 'Mobile App Developer (Android)', teks: 'Merancang dan membangun aplikasi Android yang ringan, mudah dipakai, dan terhubung ke backend.' },
  { judul: 'UI/UX Designer', teks: 'Merancang alur dan tampilan yang jelas, nyaman dipakai, dan konsisten di ponsel maupun komputer.' },
  { judul: 'Database Administrator', teks: 'Merancang skema data, menjaga performa kueri, serta mengatur cadangan dan pemulihan basis data.' },
  { judul: 'Network Engineer', teks: 'Merancang, memasang, dan memecahkan masalah jaringan LAN, Wi-Fi, dan segmentasi yang stabil dan aman.' },
  { judul: 'DevOps & Cloud Engineer', teks: 'Mengelola deployment, hosting, domain, dan otomasi rilis agar aplikasi tayang cepat dan mudah dirawat.' },
  { judul: 'AI & Chatbot Integrator', teks: 'Menghubungkan model AI dan chatbot ke aplikasi serta layanan pelanggan agar respons cepat dan konsisten.' },
  { judul: 'IT Trainer & Technical Writer', teks: 'Menyusun panduan, SOP, dan pelatihan IT dengan bahasa yang mudah dipahami.' },
  { judul: 'Data Analyst & Business Intelligence', teks: 'Mengolah data menjadi tabel, grafik, dan dashboard yang membantu keputusan, memakai Excel, SQL, dan Power BI.' },
  { judul: 'Digital Forensics & Incident Response (Defensif)', teks: 'Menelusuri jejak kejadian keamanan, mengamankan bukti, dan memulihkan sistem secara tertib dan berizin.' },
  { judul: 'QA & Software Tester', teks: 'Menguji fungsi, tampilan, dan ketahanan aplikasi sebelum rilis agar bug ditemukan lebih dulu oleh tim.' },
  { judul: 'IT Project Manager', teks: 'Mengatur ruang lingkup, jadwal, dan komunikasi proyek IT dari kesepakatan awal hingga serah terima.' },
];

const perjalanan = [
  { tahun: '2017', judul: 'Mulai belajar dasar pemrograman', teks: 'Titik awal ketertarikan pada dunia IT.' },
  { tahun: '2018', judul: 'Aplikasi Android dan website pertama', teks: 'Fokus pada logika dasar dan antarmuka pengguna.' },
  { tahun: '2019', judul: 'Automasi administrasi dengan VBA', teks: 'Mulai membantu pekerjaan administratif berulang.' },
  { tahun: '2020', judul: 'Sistem absensi dan aplikasi pendidikan', teks: 'Absensi murid dan guru, hingga aplikasi rapor sekolah.' },
  { tahun: '2021', judul: 'Jaringan, server, dan dukungan teknis', teks: 'Menangani helpdesk, administrasi sistem, dan keamanan dasar.' },
  { tahun: '2022', judul: 'Full-stack, Power Platform, dan OSINT defensif', teks: 'Aplikasi web terpadu, alur kerja low-code, dan pemantauan eksposur publik.' },
  { tahun: '2023', judul: 'Pengujian keamanan berizin dan analisis malware', teks: 'Audit kerentanan serta riset pertahanan di sandbox terisolasi.' },
  { tahun: '2024–2026', judul: 'Konsultan IT dan pendiri produk mandiri', teks: 'Menangani proyek menyeluruh dari kebutuhan hingga perawatan.' },
];

const kontak = [
  { nama: 'Email', teks: 'absecid@protonmail.com', href: 'mailto:absecid@protonmail.com' },
  { nama: 'GitHub', teks: 'absr-localhost', href: 'https://github.com/absr-localhost' },
  { nama: 'LinkedIn', teks: 'agusb-localhost', href: 'https://www.linkedin.com/in/agusb-localhost' },
  { nama: 'Telegram', teks: 'hash4162tech', href: 'https://t.me/hash4162tech' },
  { nama: 'TikTok', teks: '@silentforce2sf', href: 'https://www.tiktok.com/@silentforce2sf' },
  { nama: 'YouTube', teks: '@sevencolors-id', href: 'https://www.youtube.com/@sevencolors-id' },
];
---

<Layout metadata={metadata}>
  <!-- Awal -->
  <section class="px-4 py-16 md:py-24 mx-auto max-w-5xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">IT Specialist · Full-Stack Developer · Cybersecurity</p>
    <h1 class="mt-4 text-4xl md:text-6xl font-bold tracking-tight">Agus Budiono, S.Pd.</h1>
    <p class="mt-2 text-xl text-muted">System Administrator &amp; Cybersecurity</p>
    <p class="mt-6 text-lg text-muted max-w-3xl mx-auto">
      Dari kode, server, dan jaringan hingga keamanan dan automasi: ceritakan kebutuhan Anda, kita rancang sistem digital yang rapi, aman, dan benar-benar terpakai.
    </p>
    <p class="mt-2 text-sm text-muted">Sumatera Selatan, Indonesia</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="#kontak" class="btn-primary">Hubungi Saya</a>
      <a href="#tentang" class="btn-secondary">Tentang Saya</a>
    </div>
  </section>

  <!-- Angka -->
  <section class="px-4 pb-12 mx-auto max-w-5xl">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      {stats.map((s) => (
        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-6">
          <div class="text-4xl font-bold text-primary">{s.angka}</div>
          <div class="mt-1 text-muted">{s.teks}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Tentang -->
  <section id="tentang" class="scroll-mt-20 px-4 py-12 mx-auto max-w-3xl">
    <h2 class="text-3xl font-bold">Tentang Saya</h2>
    <p class="mt-2 text-muted">23+ peran dan keahlian IT, satu pendekatan: pahami kebutuhan dulu, baru pilih alatnya.</p>
    <div class="mt-6 space-y-4 text-lg">
      <p>
        Saya Agus Budiono, S.Pd., profesional teknologi informasi dari Sumatera Selatan yang menekuni dunia IT sejak 2017. Saya bekerja lintas disiplin: pengembangan full-stack, administrasi sistem dan jaringan, dukungan teknis, konsultasi IT, automasi (VBA dan Power Platform), multimedia, serta keamanan siber. Latar belakang pendidikan (S.Pd.) membuat saya terbiasa menjelaskan hal teknis dengan bahasa yang mudah dipahami oleh siapa pun.
      </p>
      <p>
        Perjalanan saya dimulai dari rasa ingin tahu tentang bagaimana sebuah aplikasi dibangun dari nol. Dari aplikasi Android dan website pertama, saya berkembang ke automasi administrasi, sistem absensi dan rapor sekolah, lalu ke infrastruktur: server, jaringan, dan keamanan. Setiap proyek mengajarkan satu hal yang sama: teknologi yang baik adalah teknologi yang benar-benar dipakai, bukan yang berhenti di tahap demo.
      </p>
      <p>
        Di bidang keamanan, saya berpegang pada prinsip etis: pengujian hanya dilakukan dengan izin tertulis, analisis malware hanya di sandbox terisolasi, dan simulasi edukasi hanya di lingkungan yang disetujui. Bagi saya keamanan bukan fitur tambahan yang ditempel di akhir, melainkan bagian dari desain sejak hari pertama.
      </p>
      <p>
        Hingga kini saya telah menyelesaikan 57+ proyek dan pekerjaan, dan siap bergabung dalam tim sebagai IT Generalist, Full-Stack Developer, SysAdmin, maupun spesialis keamanan, atau bekerja mandiri sebagai konsultan dan pendiri produk.
      </p>
    </div>
  </section>

  <!-- Layanan -->
  <section id="layanan" class="scroll-mt-20 px-4 py-12 mx-auto max-w-5xl">
    <h2 class="text-3xl font-bold">Yang Bisa Saya Bantu</h2>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {layanan.map((l) => (
        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-5 font-medium">{l}</div>
      ))}
    </div>
  </section>

  <!-- Peran -->
  <section id="keahlian" class="scroll-mt-20 px-4 py-12 mx-auto max-w-5xl">
    <h2 class="text-3xl font-bold">Peran &amp; Keahlian</h2>
    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
      {peran.map((p) => (
        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-5">
          <h3 class="font-semibold">{p.judul}</h3>
          <p class="mt-1 text-sm text-muted">{p.teks}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Perjalanan -->
  <section id="perjalanan" class="scroll-mt-20 px-4 py-12 mx-auto max-w-3xl">
    <h2 class="text-3xl font-bold">Perjalanan dari Tahun ke Tahun</h2>
    <ol class="mt-6 space-y-5 border-l-2 border-gray-200 dark:border-slate-700 pl-6">
      {perjalanan.map((p) => (
        <li>
          <div class="text-sm font-bold text-primary">{p.tahun}</div>
          <div class="font-semibold">{p.judul}</div>
          <div class="text-sm text-muted">{p.teks}</div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Kontak -->
  <section id="kontak" class="scroll-mt-20 px-4 py-12 pb-20 mx-auto max-w-3xl">
    <h2 class="text-3xl font-bold">Hubungi Saya</h2>
    <p class="mt-2 text-muted">Kanal untuk melihat pembaruan dan menghubungi saya. Tautan terbuka di tab baru.</p>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {kontak.map((k) => (
        <a href={k.href} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-gray-200 dark:border-slate-700 p-5 hover:border-primary">
          <div class="text-sm text-muted">{k.nama}</div>
          <div class="font-semibold break-all">{k.teks}</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
