---
import Layout from '~/layouts/PageLayout.astro';
import Ulasan from '~/components/Ulasan.astro';
import VideoBeranda from '~/components/VideoBeranda.astro';
import StatistikPanel from '~/components/StatistikPanel.astro';
import { Icon } from 'astro-icon/components';
import { wrap, stats, about, socials, EMAIL } from '~/data/profil';

const metadata = {
  title: 'Beranda',
};

// Kartu datar: garis tipis, tanpa bayangan, sudut kecil
const card = 'rounded-md border border-slate-200 bg-white';
const judulBlok = 'text-sm font-bold text-heading sm:text-base';
const garis = 'mt-1 block h-0.5 w-8 bg-accent';

const ikonSosial: Record<string, string> = {
  Telegram: 'tabler:brand-telegram',
  LinkedIn: 'tabler:brand-linkedin',
  GitHub: 'tabler:brand-github',
  TikTok: 'tabler:brand-tiktok',
  YouTube: 'tabler:brand-youtube',
};
---

<Layout metadata={metadata}>
  <!-- 1. HERO -->
  <section class="relative isolate overflow-hidden bg-primary text-white">
    <img
      src="/gedung-jakarta.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 -z-20 h-full w-full object-cover grayscale"
      width="1224"
      height="816"
    />
    <div class="absolute inset-0 -z-10 bg-primary/80"></div>

    <div class={`${wrap} grid items-end gap-4 pt-8 md:grid-cols-2 md:gap-6 md:pt-16`}>
      <div class="pb-2 md:pb-16">
        <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs uppercase tracking-wider sm:text-sm">
          <b class="text-accent">IT Specialist</b>
          <span class="text-slate-300">Full-Stack Developer</span>
        </p>
        <h1 class="text-2xl font-bold leading-tight sm:text-4xl lg:text-5xl">AGUS BUDIONO, S.Pd.</h1>
        <p class="mt-3 max-w-xl text-sm text-slate-200 sm:text-base">
          Profesional teknologi informasi dari Sumatera Selatan. Membangun aplikasi, mengelola sistem, dan
          menjaga keamanan digital.
        </p>
        <p class="mt-3 inline-block rounded-sm border border-white/40 px-2.5 py-1 text-[11px] uppercase tracking-wider sm:text-xs">
          Tersedia untuk proyek
        </p>
        <div class="mt-4 flex flex-wrap gap-2 sm:mt-6 sm:gap-3">
          <a href="/proyek" class="rounded bg-accent px-4 py-2 text-xs font-semibold text-primary sm:px-5 sm:py-2.5 sm:text-sm">Lihat portofolio</a>
          <a href={`mailto:${EMAIL}`} class="rounded border border-white px-4 py-2 text-xs font-semibold hover:bg-white/10 sm:px-5 sm:py-2.5 sm:text-sm">Hubungi saya</a>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/pk-3.webp"
          alt="Foto profil AGUS BUDIONO, S.Pd."
          class="max-h-[240px] w-auto object-contain sm:max-h-[320px] md:max-h-[460px]"
          width="860"
          height="851"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- 2. ANGKA RINGKAS: tetap 3 kolom di HP -->
  <section class={`${wrap} pb-3 pt-5 sm:pb-4 sm:pt-8`}>
    <div class="grid grid-cols-3 gap-2 sm:gap-3">
      {
        stats.map((s) => (
          <div class={`${card} p-3 sm:p-5`}>
            <p class="text-xl font-bold leading-none text-heading sm:text-3xl">{s.n}</p>
            <p class="mt-1.5 text-[11px] leading-snug text-muted sm:mt-2 sm:text-sm">{s.t}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3. VIDEO -->
  <VideoBeranda />

  <!--
    4. TATA LETAK 3 KOLOM
    Desktop (1024px+): [Sosial media] [Tentang saya di tengah] [Artikel]
    HP/tablet: Tentang saya di atas, lalu Sosial media (kiri) dan Artikel (kanan) berdampingan.
  -->
  <section class={`${wrap} pb-2 pt-4 sm:pb-4 sm:pt-6`}>
    <div id="tata" class="tata">
      <!-- Tengah: Tentang saya -->
      <article id="tp" class={`t-tp ${card} flow-root p-3.5 sm:p-5`}>
        <div
          class="float-left mb-1 mr-3 h-16 w-16 overflow-hidden rounded bg-primary sm:mr-4 sm:h-24 sm:w-24 lg:h-28 lg:w-28"
        >
          <img
            src="/pk-3.webp"
            alt="Foto profil AGUS BUDIONO, S.Pd."
            class="h-full w-full object-cover object-top"
            width="112"
            height="112"
            loading="lazy"
          />
        </div>
        <h2 class={judulBlok}>Tentang saya<span class={garis}></span></h2>
        <div class="mt-3 space-y-2.5 text-[13px] leading-relaxed text-muted sm:space-y-3 sm:text-sm">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </article>

      <!-- Kiri: sosial media -->
      <aside id="sos" class={`t-sos ${card} p-2 sm:p-4`}>
        <h2 class={`${judulBlok} px-1 pb-2`}>Sosial media<span class={garis}></span></h2>
        <ul class="space-y-0.5">
          {
            socials.map(([nama, url]) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 rounded p-1 text-muted hover:bg-slate-50 hover:text-heading sm:gap-2.5 sm:p-1.5"
                >
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white sm:h-8 sm:w-8">
                    <Icon name={ikonSosial[nama] || 'tabler:link'} class="h-4 w-4" />
                  </span>
                  <span class="min-w-0 truncate text-xs font-medium sm:text-sm">{nama}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${EMAIL}`}
              class="flex items-center gap-1.5 rounded p-1 text-muted hover:bg-slate-50 hover:text-heading sm:gap-2.5 sm:p-1.5"
            >
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white sm:h-8 sm:w-8">
                <Icon name="tabler:mail" class="h-4 w-4" />
              </span>
              <span class="min-w-0 truncate text-xs font-medium sm:text-sm">Email</span>
            </a>
          </li>
        </ul>
      </aside>

      <!-- Kanan: artikel (kerangka abu-abu tampil dulu, diisi saat data masuk) -->
      <aside id="ab" class={`t-ab ${card} p-2.5 sm:p-4`}>
        <div class="mb-2 flex items-start justify-between gap-2 sm:mb-3">
          <h2 class={judulBlok}>Artikel<span class={garis}></span></h2>
          <a href="/artikel" class="shrink-0 text-xs font-semibold text-link hover:underline">Semua</a>
        </div>
        <div id="ab-list">
          <div class="space-y-2" aria-hidden="true">
            <div class="h-12 rounded bg-slate-100 sm:h-14"></div>
            <div class="h-12 rounded bg-slate-100 sm:h-14"></div>
            <div class="h-12 rounded bg-slate-100 sm:h-14"></div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      if (window.__abSiap) return;
      window.__abSiap = true;

      var JEDA = [1000, 2000, 4000];

      function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text) e.textContent = text;
        return e;
      }

      // Artikel tidak tersedia: sembunyikan kolom artikel, tata letak menyesuaikan
      function tanpaArtikel(grid, box) {
        grid.setAttribute('data-sepi', '');
        box.hidden = true;
      }

      function ambil(url, ms) {
        var c = new AbortController();
        var t = setTimeout(function () {
          c.abort();
        }, ms);
        return fetch(url, { cache: 'no-store', signal: c.signal }).then(
          function (r) {
            clearTimeout(t);
            if (!r.ok) throw new Error('http');
            return r.json();
          },
          function (e) {
            clearTimeout(t);
            throw e;
          }
        );
      }

      function coba(n, box) {
        return ambil('/artikel/terbaru.php?t=' + Date.now(), 8000).catch(function (e) {
          if (n >= JEDA.length || !box.isConnected) throw e;
          return new Promise(function (ok) {
            setTimeout(ok, JEDA[n]);
          }).then(function () {
            return coba(n + 1, box);
          });
        });
      }

      function siap() {
        var box = document.getElementById('ab');
        var list = document.getElementById('ab-list');
        var grid = document.getElementById('tata');
        if (!box || !list || !grid || box.dataset.siap) return;
        box.dataset.siap = '1';

        coba(0, box)
          .then(function (d) {
            if (!box.isConnected) return;
            var arr = d && d.artikel ? d.artikel.slice(0, 5) : [];
            if (!arr.length) {
              tanpaArtikel(grid, box);
              return;
            }
            list.textContent = '';
            arr.forEach(function (it) {
              var a = el('a', 'group flex gap-2 border-t border-slate-200 py-2 first:border-t-0 first:pt-0 sm:gap-3 sm:py-3');
              a.href = '/artikel/' + it.slug;

              var th;
              if (it.foto) {
                th = el('img', 'h-12 w-16 shrink-0 rounded bg-slate-200 object-cover sm:h-14 sm:w-20');
                th.src = it.foto;
                th.alt = '';
                th.loading = 'lazy';
                th.width = 80;
                th.height = 56;
              } else {
                th = el('div', 'h-12 w-16 shrink-0 rounded bg-slate-200 sm:h-14 sm:w-20');
              }

              var tx = el('div', 'min-w-0');
              var meta = el('p', 'text-[10px] leading-tight text-muted sm:text-xs');
              if (it.kategori) meta.appendChild(el('span', 'mr-1.5 font-semibold text-primary', it.kategori));
              meta.appendChild(el('span', '', it.tanggal));
              tx.appendChild(meta);
              tx.appendChild(
                el('p', 'mt-0.5 text-xs font-semibold leading-snug text-heading group-hover:underline sm:text-sm', it.judul)
              );

              // Deskripsi singkat: hanya tampil di layar sedang ke atas
              var desk = it.ringkas || it.deskripsi || it.ringkasan || it.excerpt;
              if (desk) {
                var w = el('div', 'hidden sm:block');
                w.appendChild(el('p', 'mt-0.5 line-clamp-2 text-xs text-muted', desk));
                tx.appendChild(w);
              }

              a.appendChild(th);
              a.appendChild(tx);
              list.appendChild(a);
            });
          })
          .catch(function () {
            if (box.isConnected) tanpaArtikel(grid, box);
          });
      }

      document.addEventListener('astro:page-load', siap);
    })();
  </script>

  <!-- 5. STATISTIK SITUS + DASHBOARD -->
  <StatistikPanel judul="Statistik situs" />

  <!-- 6. ULASAN -->
  <Ulasan />

  <!-- 7. AJAKAN -->
  <section class="bg-primary py-8 text-white sm:py-12">
    <div class={`${wrap} flex flex-col items-start gap-4 md:flex-row md:items-center md:justify-between`}>
      <div>
        <h2 class="text-lg font-bold sm:text-2xl">Punya proyek atau kebutuhan IT?</h2>
        <p class="mt-1 max-w-xl text-sm text-slate-300 sm:text-base">Ceritakan kebutuhan Anda lewat email.</p>
      </div>
      <a href={`mailto:${EMAIL}`} class="rounded bg-accent px-4 py-2 text-xs font-semibold text-primary sm:px-5 sm:py-2.5 sm:text-sm">Hubungi saya</a>
    </div>
  </section>
</Layout>

<style>
  /* HP: Tentang saya penuh di atas; Sosial (kiri) dan Artikel (kanan) berdampingan */
  .tata {
    display: grid;
    align-items: start;
    gap: 0.625rem;
    grid-template-columns: 6.75rem minmax(0, 1fr);
  }
  .tata > .t-tp {
    grid-column: 1 / -1;
  }

  @media (min-width: 640px) {
    .tata {
      gap: 1rem;
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  /* Desktop: 3 kolom, Tentang saya di tengah */
  @media (min-width: 1024px) {
    .tata {
      gap: 1.5rem;
      grid-template-columns: 13rem minmax(0, 1fr) 19rem;
    }
    .tata > .t-sos {
      order: 1;
    }
    .tata > .t-tp {
      order: 2;
      grid-column: auto;
    }
    .tata > .t-ab {
      order: 3;
    }
  }

  /* Jika artikel gagal dimuat */
  .tata[data-sepi] {
    grid-template-columns: minmax(0, 1fr);
  }
  .tata[data-sepi] > .t-sos {
    grid-column: 1 / -1;
  }
  @media (min-width: 1024px) {
    .tata[data-sepi] {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    .tata[data-sepi] > .t-sos {
      grid-column: auto;
    }
  }
</style>
