---
import Layout from '~/layouts/PageLayout.astro';
import Ulasan from '~/components/Ulasan.astro';
import VideoBeranda from '~/components/VideoBeranda.astro';
import StatistikPanel from '~/components/StatistikPanel.astro';
import { Icon } from 'astro-icon/components';
import { wrap, stats, about, socials, EMAIL } from '~/data/profil';

const metadata = {
  title: 'Beranda',
};

const card = 'rounded-lg border border-slate-200 bg-white shadow-sm';

// Ikon sosial media (nama harus sama dengan di data/profil)
const ikonSosial: Record<string, string> = {
  Telegram: 'tabler:brand-telegram',
  LinkedIn: 'tabler:brand-linkedin',
  GitHub: 'tabler:brand-github',
  TikTok: 'tabler:brand-tiktok',
  YouTube: 'tabler:brand-youtube',
};
---

<Layout metadata={metadata}>
  <!-- 1. HERO -->
  <section class="relative isolate overflow-hidden bg-primary text-white">
    <img
      src="/gedung-jakarta.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 -z-20 h-full w-full object-cover grayscale"
      width="1224"
      height="816"
    />
    <div class="absolute inset-0 -z-10 bg-primary/80"></div>

    <div class={`${wrap} grid items-end gap-6 pt-12 md:grid-cols-2 md:pt-20`}>
      <div class="pb-8 md:pb-20">
        <p class="mb-4 flex flex-wrap items-center gap-3 text-sm uppercase tracking-widest">
          <b class="text-accent">IT Specialist</b>
          <span class="text-slate-300">Full-Stack Developer</span>
        </p>
        <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          AGUS BUDIONO, S.Pd.
        </h1>
        <p class="mt-4 max-w-xl text-slate-200">
          Profesional teknologi informasi dari Sumatera Selatan. Membangun aplikasi, mengelola sistem, dan
          menjaga keamanan digital.
        </p>
        <p class="mt-4 inline-block rounded-sm border border-white/40 px-3 py-1 text-xs uppercase tracking-widest">
          Tersedia untuk proyek
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/proyek" class="rounded-md bg-accent px-5 py-3 text-sm font-semibold text-primary transition hover:brightness-95">Lihat portofolio</a>
          <a href={`mailto:${EMAIL}`} class="rounded-md border border-white px-5 py-3 text-sm font-semibold transition hover:bg-white/10">Hubungi saya</a>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/pk-3.webp"
          alt="Foto profil AGUS BUDIONO, S.Pd."
          class="max-h-[420px] w-auto object-contain md:max-h-[560px]"
          width="860"
          height="851"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- 2. ANGKA RINGKAS -->
  <section class={`${wrap} py-10 sm:py-14`}>
    <div class="grid gap-3 sm:grid-cols-3 sm:gap-4">
      {
        stats.map((s) => (
          <div class={`${card} p-5 sm:p-6`}>
            <p class="text-3xl font-bold text-heading sm:text-4xl">{s.n}</p>
            <p class="mt-2 text-sm text-muted">{s.t}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3. VIDEO -->
  <VideoBeranda />

  <!-- 4. TENTANG SAYA (tengah) + SIDEBAR -->
  <section class={`${wrap} py-10 sm:py-14`}>
    <!-- Tentang saya: foto kecil di pojok kiri atas, teks mengalir di sampingnya -->
    <div id="tp" class={`${card} flow-root p-5 sm:p-8`}>
      <div
        class="float-left mb-2 mr-4 h-20 w-20 overflow-hidden rounded-xl bg-primary sm:mr-6 sm:h-28 sm:w-28 lg:h-32 lg:w-32"
      >
        <img
          src="/pk-3.webp"
          alt="Foto profil AGUS BUDIONO, S.Pd."
          class="h-full w-full object-cover object-top"
          width="128"
          height="128"
          loading="lazy"
        />
      </div>
      <h2 class="mb-3 text-xl font-bold text-heading sm:text-2xl">Tentang saya</h2>
      <div class="space-y-3 text-sm leading-relaxed text-muted sm:space-y-4 sm:text-base">
        {about.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <!-- Sidebar: HP ditumpuk, desktop 2 kolom (kiri sosial media, kanan artikel) -->
    <div class="mt-4 grid gap-4 sm:mt-6 sm:gap-6 lg:grid-cols-5">
      <!-- Kiri: sosial media -->
      <aside id="sos" class={`${card} p-5 sm:p-6 lg:col-span-5`}>
        <h2 class="mb-3 text-lg font-bold text-heading sm:text-xl">Sosial media</h2>
        <ul class="grid grid-cols-1 gap-1 sm:grid-cols-2 lg:grid-cols-1">
          {
            socials.map(([nama, url]) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 rounded-md p-2.5 text-sm text-muted transition hover:bg-slate-100 hover:text-heading"
                >
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-white">
                    <Icon name={ikonSosial[nama] || 'tabler:link'} class="h-5 w-5" />
                  </span>
                  <span class="min-w-0 truncate font-medium">{nama}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${EMAIL}`}
              class="flex items-center gap-3 rounded-md p-2.5 text-sm text-muted transition hover:bg-slate-100 hover:text-heading"
            >
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-white">
                <Icon name="tabler:mail" class="h-5 w-5" />
              </span>
              <span class="min-w-0 truncate font-medium">Email</span>
            </a>
          </li>
        </ul>
      </aside>

      <!-- Kanan: daftar artikel (tersembunyi sampai data berhasil dimuat) -->
      <div id="ab" class={`${card} p-5 sm:p-6 lg:col-span-3`} hidden>
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h2 class="text-lg font-bold text-heading sm:text-xl">Artikel</h2>
          <a href="/artikel" class="shrink-0 text-sm font-semibold text-link hover:underline">Semua artikel</a>
        </div>
        <div id="ab-list"></div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      if (window.__abSiap) return;
      window.__abSiap = true;

      var JEDA = [1000, 2000, 4000];

      function el(tag, cls, text) {
        var e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text) e.textContent = text;
        return e;
      }

      // Tanpa artikel: sosial media memakai lebar penuh
      function lebar(sos) {
        sos.classList.remove('lg:col-span-2');
        sos.classList.add('lg:col-span-5');
      }

      function ambil(url, ms) {
        var c = new AbortController();
        var t = setTimeout(function () {
          c.abort();
        }, ms);
        return fetch(url, { cache: 'no-store', signal: c.signal }).then(
          function (r) {
            clearTimeout(t);
            if (!r.ok) throw new Error('http');
            return r.json();
          },
          function (e) {
            clearTimeout(t);
            throw e;
          }
        );
      }

      function coba(n, box) {
        return ambil('/artikel/terbaru.php?t=' + Date.now(), 8000).catch(function (e) {
          if (n >= JEDA.length || !box.isConnected) throw e;
          return new Promise(function (ok) {
            setTimeout(ok, JEDA[n]);
          }).then(function () {
            return coba(n + 1, box);
          });
        });
      }

      function siap() {
        var box = document.getElementById('ab');
        var list = document.getElementById('ab-list');
        var sos = document.getElementById('sos');
        if (!box || !list || !sos || box.dataset.siap) return;
        box.dataset.siap = '1';

        coba(0, box)
          .then(function (d) {
            if (!box.isConnected) return;
            var arr = d && d.artikel ? d.artikel.slice(0, 5) : [];
            if (!arr.length) {
              lebar(sos);
              return;
            }
            list.textContent = '';
            arr.forEach(function (it) {
              var a = el('a', 'group flex gap-3 border-t border-slate-200 py-3 first:border-t-0 first:pt-0');
              a.href = '/artikel/' + it.slug;

              var th;
              if (it.foto) {
                th = el('img', 'h-16 w-24 shrink-0 rounded-md bg-slate-200 object-cover sm:h-20 sm:w-28');
                th.src = it.foto;
                th.alt = '';
                th.loading = 'lazy';
                th.width = 112;
                th.height = 80;
              } else {
                th = el('div', 'h-16 w-24 shrink-0 rounded-md bg-slate-200 sm:h-20 sm:w-28');
              }

              var tx = el('div', 'min-w-0');
              var meta = el('p', 'text-xs text-muted');
              if (it.kategori) meta.appendChild(el('span', 'mr-2 font-semibold text-primary', it.kategori));
              meta.appendChild(el('span', '', it.tanggal));
              tx.appendChild(meta);
              tx.appendChild(
                el('p', 'mt-0.5 text-sm font-semibold leading-snug text-heading group-hover:underline', it.judul)
              );

              // Deskripsi singkat (dipakai jika API mengirim salah satu field ini)
              var desk = it.ringkas || it.deskripsi || it.ringkasan || it.excerpt;
              if (desk) tx.appendChild(el('p', 'mt-1 line-clamp-2 text-xs text-muted sm:text-sm', desk));

              a.appendChild(th);
              a.appendChild(tx);
              list.appendChild(a);
            });
            sos.classList.remove('lg:col-span-5');
            sos.classList.add('lg:col-span-2');
            box.hidden = false;
          })
          .catch(function () {
            if (box.isConnected) lebar(sos);
          });
      }

      document.addEventListener('astro:page-load', siap);
    })();
  </script>

  <!-- 5. STATISTIK SITUS + DASHBOARD -->
  <StatistikPanel judul="Statistik situs" />

  <!-- 6. ULASAN -->
  <Ulasan />

  <!-- 7. AJAKAN -->
  <section class="bg-primary py-14 text-white sm:py-16">
    <div class={`${wrap} flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between`}>
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">Punya proyek atau kebutuhan IT?</h2>
        <p class="mt-2 max-w-xl text-slate-300">Ceritakan kebutuhan Anda lewat email.</p>
      </div>
      <a href={`mailto:${EMAIL}`} class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-primary transition hover:brightness-95">Hubungi saya</a>
    </div>
  </section>
</Layout>
