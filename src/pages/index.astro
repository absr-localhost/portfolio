---
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, stats, about, pages, EMAIL } from '~/data/profil';

const metadata = {
  title: 'Beranda',
};
---

<Layout metadata={metadata}>
  <section class="relative isolate overflow-hidden bg-neutral-950 text-white">
    <img
      src="/gedung-jakarta.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 -z-20 h-full w-full object-cover grayscale"
      width="1224"
      height="816"
    />
    <div class="absolute inset-0 -z-10 bg-neutral-950/75"></div>

    <div class={`${wrap} grid items-end gap-6 pt-12 md:grid-cols-2 md:pt-20`}>
      <div class="pb-8 md:pb-20">
        <p class="mb-4 flex flex-wrap items-center gap-3 text-sm uppercase tracking-widest">
          <b>IT Specialist</b>
          <span class="text-neutral-300">Full-Stack Developer</span>
        </p>
        <h1 class="text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
          AGUS BUDIONO, S.Pd.
        </h1>
        <p class="mt-4 max-w-xl text-neutral-200">
          Profesional teknologi informasi dari Sumatera Selatan. Membangun aplikasi, mengelola sistem, dan
          menjaga keamanan digital.
        </p>
        <p class="mt-4 inline-block border border-white/40 px-3 py-1 text-xs uppercase tracking-widest">
          Tersedia untuk proyek
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/proyek" class="bg-white px-5 py-3 text-sm font-semibold text-neutral-900">Lihat proyek</a>
          <a href={`mailto:${EMAIL}`} class="border border-white px-5 py-3 text-sm font-semibold">Hubungi saya</a>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/pk-3.webp"
          alt="Foto profil AGUS BUDIONO, S.Pd."
          class="max-h-[420px] w-auto object-contain md:max-h-[560px]"
          width="860"
          height="851"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class={`${wrap} py-10`}>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        stats.map((s) => (
          <div class={`${card} p-6`}>
            <p class="text-4xl font-bold">{s.n}</p>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{s.t}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class={`${wrap} pb-10`}>
    <div class={`${card} p-6 sm:p-8`}>
      <h2 class="mb-4 text-2xl font-bold">Tentang saya</h2>
      <p class="leading-relaxed">{about[0]}</p>
      <a href="/tentang" class="mt-4 inline-block text-sm font-semibold underline">Baca selengkapnya</a>
    </div>
  </section>

  <section class={`${wrap} pb-16`}>
    <h2 class="mb-4 text-2xl font-bold">Jelajahi</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        pages.map(([t, h, d]) => (
          <a href={h} class={`${card} block p-6 transition hover:-translate-y-1`}>
            <p class="text-lg font-bold">{t}</p>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{d}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
