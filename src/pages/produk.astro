---
import Layout from '~/layouts/PageLayout.astro';
import { wrap } from '~/data/profil';

const metadata = {
  title: 'AGB STORE',
};
---

<Layout metadata={metadata}>
  <section class={`${wrap} py-12`}>
    <p class="text-sm font-semibold uppercase tracking-widest">Rekomendasi</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">AGB STORE</h1>
    <p class="mt-1 text-neutral-500">Agus Budiono – Produk Digital Marketing</p>
    <p class="mt-4 max-w-3xl text-neutral-600 dark:text-neutral-300">
      Rekomendasi &amp; inspirasi produk terbaik by AGB STORE. Produk berkualitas, viral, dan paling worth it untuk
      kebutuhan Anda. Dapatkan info promo, diskon, dan link pembelian toko tepercaya di bawah ini.
    </p>

    <div id="pFilters" class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter platform"></div>
    <div id="pGrid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <p class="col-span-full text-neutral-500">Memuat produk…</p>
    </div>
  </section>
</Layout>

<style is:global>
  .pf-btn.on {
    background: #111;
    color: #fff;
  }
  .dark .pf-btn.on {
    background: #fff;
    color: #111;
  }
</style>

<script is:inline>
  (function () {
    'use strict';
    var API = 'https://produk-affiliate.extreamcollectiveofficial.workers.dev';
    var PL = { tiktok: 'TikTok Shop', tokopedia: 'Tokopedia', shopee: 'Shopee', lazada: 'Lazada' };
    var PC = { tiktok: '#111111', tokopedia: '#03AC0E', shopee: '#EE4D2D', lazada: '#000000' };
    var items = [];
    var cur = '';
    var failed = false;

    function $(id) {
      return document.getElementById(id);
    }
    function esc(t) {
      return String(t == null ? '' : t).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function okUrl(u) {
      try {
        return /^https?:$/.test(new URL(u).protocol);
      } catch (e) {
        return false;
      }
    }
    function num(v) {
      return parseInt(String(v == null ? '' : v).replace(/\D/g, ''), 10) || 0;
    }
    function rp(n) {
      return 'Rp' + (Number(n) || 0).toLocaleString('id-ID');
    }
    function kfmt(n) {
      if (n >= 1e6) return (n / 1e6).toFixed(1).replace('.0', '').replace('.', ',') + 'jt';
      if (n >= 1e3) return (n / 1e3).toFixed(1).replace('.0', '').replace('.', ',') + 'rb';
      return String(n);
    }

    function card(p) {
      var pr = num(p.price);
      var old = num(p.priceOld);
      var disc = old > pr && pr > 0 ? Math.round((1 - pr / old) * 100) : 0;
      var rt = Math.max(0, Math.min(5, +p.rating || 0));
      var sold = num(p.sold);
      var img =
        p.image && (/^data:image\/(jpeg|png|webp);base64,/.test(p.image) || okUrl(p.image))
          ? '<img src="' + esc(p.image) + '" alt="' + esc(p.name) + '" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover">'
          : '<span class="text-sm text-neutral-500">Tanpa gambar</span>';
      var chip =
        '<span class="absolute left-2 top-2 px-2 py-1 text-xs font-semibold text-white" style="background:' +
        (PC[p.platform] || '#111111') +
        '">' +
        esc(PL[p.platform] || '') +
        '</span>';
      var badge = disc
        ? '<span class="absolute right-2 top-2 bg-red-600 px-2 py-1 text-xs font-semibold text-white">-' + disc + '%</span>'
        : '';
      var rate = '';
      if (rt > 0 || sold > 0) {
        rate =
          '<p class="mt-2 text-xs text-neutral-500">' +
          (rt > 0 ? '★ ' + rt.toFixed(1).replace('.', ',') : '') +
          (rt > 0 && sold > 0 ? ' · ' : '') +
          (sold > 0 ? kfmt(sold) + (p.soldPlus ? '+' : '') + ' terjual' : '') +
          '</p>';
      }
      var store = p.store
        ? '<p class="mt-1 text-xs text-neutral-500">' + esc(p.store) + (p.loc ? ' · ' + esc(p.loc) : '') + '</p>'
        : '';
      var free = p.free ? '<p class="mt-1 text-xs font-semibold text-green-700">Gratis ongkir</p>' : '';
      var href = okUrl(p.link) ? esc(p.link) : '#';
      return (
        '<article class="flex flex-col border border-neutral-900 bg-white dark:border-neutral-300 dark:bg-neutral-900">' +
        '<div class="relative flex aspect-square items-center justify-center overflow-hidden bg-neutral-100 dark:bg-neutral-800">' +
        img +
        chip +
        badge +
        '</div>' +
        '<div class="flex flex-1 flex-col p-4">' +
        '<p class="text-sm font-semibold leading-snug">' +
        esc(p.name) +
        '</p>' +
        '<p class="mt-2"><b class="text-lg">' +
        rp(pr) +
        '</b>' +
        (old > pr ? ' <s class="text-xs text-neutral-500">' + rp(old) + '</s>' : '') +
        '</p>' +
        rate +
        store +
        free +
        '<a class="mt-auto inline-block bg-neutral-900 px-4 py-2 text-center text-sm font-semibold text-white dark:bg-white dark:text-neutral-900" style="margin-top:1rem" target="_blank" rel="noopener sponsored" href="' +
        href +
        '">Beli di ' +
        esc(PL[p.platform] || 'toko') +
        '</a>' +
        '</div></article>'
      );
    }

    function render() {
      $('pFilters').innerHTML = Object.keys(PL)
        .map(function (k) {
          return (
            '<button type="button" data-k="' +
            k +
            '" aria-pressed="' +
            (cur === k) +
            '" class="pf-btn' +
            (cur === k ? ' on' : '') +
            ' border border-neutral-900 px-4 py-2 text-sm font-semibold dark:border-neutral-300">' +
            PL[k] +
            '</button>'
          );
        })
        .join('');
      var list = items.filter(function (p) {
        return !cur || p.platform === cur;
      });
      var msg = failed
        ? 'Produk belum dapat dimuat. Coba lagi nanti.'
        : 'Belum ada produk.';
      $('pGrid').innerHTML = list.length
        ? list.map(card).join('')
        : '<p class="col-span-full text-neutral-500">' + msg + '</p>';
    }

    $('pFilters').addEventListener('click', function (e) {
      var b = e.target.closest('.pf-btn');
      if (!b) return;
      cur = cur === b.getAttribute('data-k') ? '' : b.getAttribute('data-k');
      render();
    });

    render();
    fetch(API + '/api/produk')
      .then(function (r) {
        if (!r.ok) throw new Error('gagal');
        return r.json();
      })
      .then(function (d) {
        if (Array.isArray(d)) items = d;
        render();
      })
      .catch(function () {
        failed = true;
        render();
      });
  })();
</script>
