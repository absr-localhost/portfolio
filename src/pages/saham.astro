---
import Layout from '~/layouts/PageLayout.astro';
import { wrap } from '~/data/profil';

const metadata = { title: 'Saham Lokal' };
---

<Layout metadata={metadata}>
  <section class="bg-primary py-8 text-white sm:py-10">
    <div class={wrap}>
      <h1 class="text-2xl font-extrabold tracking-tight sm:text-4xl">Saham Lokal</h1>
    </div>
  </section>

  <section class="py-8 sm:py-10">
    <div class={wrap}>
      <div class="mx-auto max-w-2xl">
        <p id="sk-status" class="text-xs text-muted" role="status">Memuat data saham...</p>
        <p id="sk-warn" hidden class="mt-1 text-xs font-semibold text-amber-700"></p>
        <button
          id="sk-retry"
          type="button"
          hidden
          class="mt-3 rounded-md border border-primary px-4 py-2 text-sm font-semibold text-primary transition hover:bg-slate-50"
        >
          Coba lagi
        </button>
        <div
          id="sk-list"
          class="mt-3 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 border-t-2 border-t-accent bg-white shadow-sm"
        >
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var SUMBER = 'https://raw.githubusercontent.com/absr-localhost/data-web/main/saham.json';
    var BATAS_USANG = 3 * 24 * 3600 * 1000;
    var list = document.getElementById('sk-list');
    var status = document.getElementById('sk-status');
    var warn = document.getElementById('sk-warn');
    var retry = document.getElementById('sk-retry');
    var f0 = new Intl.NumberFormat('id-ID', { maximumFractionDigits: 0 });
    var f2 = new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    var data = null;
    var sibuk = false;

    var WARNA = { up: 'text-emerald-700', dn: 'text-red-700', nt: 'text-slate-500' };

    function el(tag, cls, text) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    }

    function arah(c) {
      if (typeof c !== 'number' || !isFinite(c) || Math.abs(c) < 0.005) return 'nt';
      return c > 0 ? 'up' : 'dn';
    }

    function harga(x) {
      return x.k === 'IHSG' ? f2.format(x.p) : 'Rp ' + f0.format(x.p);
    }

    function persen(x) {
      if (typeof x.c !== 'number' || !isFinite(x.c)) return '';
      var a = arah(x.c);
      var t = a === 'up' ? '▲ +' : a === 'dn' ? '▼ ' : '';
      return t + f2.format(x.c) + '%';
    }

    function waktu(ms) {
      return (
        new Date(ms).toLocaleString('id-ID', {
          timeZone: 'Asia/Jakarta',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        }) + ' WIB'
      );
    }

    function gambar(items) {
      list.innerHTML = '';
      items.forEach(function (x) {
        var baris = el('div', 'flex items-center justify-between gap-3 px-4 py-3' + (x.k === 'IHSG' ? ' bg-slate-50' : ''));
        var kiri = el('div', 'min-w-0');
        kiri.appendChild(el('p', 'text-sm font-bold text-heading', x.k));
        kiri.appendChild(el('p', 'truncate text-xs text-muted', x.k === 'IHSG' ? 'Indeks Harga Saham Gabungan' : x.n || ''));
        var kanan = el('div', 'shrink-0 text-right');
        kanan.appendChild(el('p', 'text-sm font-semibold text-heading', harga(x)));
        kanan.appendChild(el('p', 'text-xs font-semibold ' + WARNA[arah(x.c)], persen(x)));
        baris.appendChild(kiri);
        baris.appendChild(kanan);
        list.appendChild(baris);
      });
    }

    function tampil() {
      var items = (data.stocks || []).filter(function (x) {
        return x && x.k && typeof x.p === 'number' && isFinite(x.p);
      });
      if (!items.length) throw new Error('kosong');
      var ms = Number(data.updated) * 1000;
      var ada = isFinite(ms) && ms > 0;
      status.textContent = ada
        ? 'Sumber: server data Agus Budiono · Diperbarui ' + waktu(ms)
        : 'Sumber: server data Agus Budiono';
      if (ada && Date.now() - ms > BATAS_USANG) {
        warn.textContent = 'Data belum diperbarui sejak ' + waktu(ms) + '.';
        warn.hidden = false;
      } else {
        warn.hidden = true;
      }
      retry.hidden = true;
      gambar(items);
    }

    function muat() {
      if (sibuk) return;
      sibuk = true;
      fetch(SUMBER + '?t=' + Math.floor(Date.now() / 120000), { cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (d) {
          data = d;
          tampil();
        })
        .catch(function (e) {
          console.error('Data saham gagal dimuat:', e);
          if (data) {
            warn.textContent = 'Pembaruan terbaru gagal. Yang tampil adalah data sebelumnya.';
            warn.hidden = false;
          } else {
            status.textContent = 'Data saham belum bisa dimuat.';
            retry.hidden = false;
          }
        })
        .then(function () {
          sibuk = false;
        });
    }

    retry.addEventListener('click', muat);
    setInterval(function () {
      if (!document.hidden) muat();
    }, 5 * 60 * 1000);
    muat();
  })();
</script>
