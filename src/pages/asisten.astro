  if(!res.ok||!res.body) throw new Error("http");
  const rd=res.body.getReader(), dec=new TextDecoder(); let buf="", full="";
  for(;;){
    const {done,value}=await rd.read(); if(done) break;
    buf+=dec.decode(value,{stream:true});
