// Bersihkan format ala dokumen (tabel, ---, **, #) agar tampil seperti chat biasa; blok kode dipertahankan
function cleanText(t){
  return String(t||"").replace(/\r/g,"").split("\n").map(l=>{
    if(/^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$/.test(l)) return null;
    if(/^\s*-{3,}\s*$|^\s*\*{3,}\s*$|^\s*_{3,}\s*$/.test(l)) return null;
    if(/^\s*\|.*\|\s*$/.test(l)){ const c=l.trim().replace(/^\||\|$/g,"").split("|").map(x=>x.trim()).filter(Boolean); return c.length>1?"• "+c[0]+": "+c.slice(1).join(" – "):"• "+c.join(""); }
    return l.replace(/^\s{0,3}#{1,6}\s*/,"").replace(/^\s*[-*]\s+/,"• ");
  }).filter(l=>l!==null).join("\n").replace(/\*\*|__/g,"").replace(/`([^`\n]+)`/g,"$1").replace(/\n{3,}/g,"\n\n").trim();
}
function cleanReply(t){
  t=String(t||""); const parts=t.split("```"); if(parts.length===1) return cleanText(t);
  return parts.map((p,i)=> i%2 ? "```"+p.replace(/^[a-zA-Z0-9+#-]*\n/,"").replace(/\n+$/,"")+"```" : cleanText(p)).filter((p,i)=>i%2||p).join("\n");
}
