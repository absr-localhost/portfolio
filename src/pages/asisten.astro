    const check=()=>{ if(!owner&&fails>=total) end(""); };
    const claim=w=>{ if(owner) return owner===w; owner=w; Object.keys(ctls).forEach(k=>{ if(k!==w) ctls[k].abort(); }); clearT(); return true; };
    const runG=()=>{ if(sG||done||!useG) return; sG=true;
      askGemini(cG.signal,t=>{ if(done||!claim("g")) return; partial=t; onDelta(t); },ctx)
        .then(t=>{ if(done||!claim("g")) return; end(t); })
        .catch(()=>{ if(done) return; if(owner==="g") return end(partial); if(owner) return; fails++; startOld(); check(); }); };
    const runP=()=>{ if(sP||done) return; sP=true;
      askAI(cP.signal,!!(cur&&cur.img),cur,ctx,t=>{ if(done||!claim("p")) return; partial=t; onDelta(t); })
        .then(t=>{ if(done||!claim("p")) return; end(t); })
        .catch(()=>{ if(done) return; if(owner==="p") return end(partial); if(owner) return; fails++; runB(); check(); }); };
    const runB=()=>{ if(sB||done||!useB) return; sB=true;
      askBackend(cB.signal,t=>{ if(done||!claim("b")) return; partial=t; onDelta(t); },ctx)
        .then(t=>{ if(done||!claim("b")) return; end(t); })
        .catch(()=>{ if(done) return; if(owner==="b") return end(partial); if(owner) return; fails++; runP(); check(); }); };
    // jalur cadangan (Pollinations / backend Groq) sama seperti sebelumnya
    const startOld=()=>{ if(oldStarted||done) return; oldStarted=true;
      if(general||!useB){ runP(); if(useB) timers.push(setTimeout(runB,6000)); }
      else{ runB(); timers.push(setTimeout(runP,CHAT_CONFIG.hedgeMs)); } };
    if(useG){ runG(); timers.push(setTimeout(startOld,CHAT_CONFIG.geminiMs)); }   // Gemini pertama; bila belum mulai menjawab, cadangan ikut berjalan
    else startOld();
    hard=setTimeout(()=>end(partial),CHAT_CONFIG.totalMs);
  });
}

async function sendChat(text){
  text=(text||"").trim(); const cur=pend; if((!text&&!cur)||chatBusy) return;
  chatBusy=true; chatSend.disabled=true; chatChips.hidden=true; chatInput.value=""; chatInput.style.height="auto"; clearPend();
  addMsg("user",text||("📎 "+cur.name),cur); remember("user",text||("📎 "+cur.name));
  const wait=typingRow(); const done=()=>{ chatBusy=false; chatSend.disabled=false; chatInput.focus({preventScroll:true}); persist(); };
  if(BLOCKED.test(text)){ await sleep2(500); wait.remove(); addMsg("bot",REFUSAL); remember("bot",REFUSAL); return done(); }
  // 1) asisten otomatis: layanan, harga, pemesanan -> instan
  if(!cur){
    const loc=localAnswer(text);
    if(loc){
      chatHistory.push({role:"user",content:text});
      await sleep2(Math.min(180+loc.text.length*1.2,650)); wait.remove();
      addMsg("bot",loc.text,null,loc.links); remember("bot",loc.text); chatHistory.push({role:"assistant",content:loc.text});
      return done();
    }
  }
  // 2) pertanyaan umum / lainnya -> AI (tampil sambil mengalir)
  let content=text||"(pengunjung mengirim lampiran tanpa pesan)";
  if(cur){ content+="\n["+(cur.img?"Pengunjung melampirkan sebuah foto":"Pengunjung melampirkan berkas \""+cur.name+"\""+(cur.txt?". Isi berkas:\n"+cur.txt:" (isinya tidak dapat kamu baca)"))+"]"; }
  chatHistory.push({role:"user",content});
  let src=null; if(!cur){ try{ src=await gatherSources(text); }catch(e){ src=null; } }
  let row=null, box=null, raf=0, latest="";
  const paint=()=>{ raf=0; if(!box) return; fillBubble(box,cleanReply(latest)); toBottom(); };
  const final=await aiReply(cur,t=>{ latest=t;
    if(!row){ wait.remove(); row=addMsg("bot","…"); box=row.querySelector(".mt"); }
    if(!raf) raf=requestAnimationFrame(paint); },src&&src.ctx,isGeneral(text));
  cancelAnimationFrame(raf);
  const reply=cleanReply(final);
  if(cur&&cur.img) chatHistory[chatHistory.length-1].content=content.replace("sebuah foto","sebuah foto (sudah dilihat)");
  if(reply){
    if(row) fillBubble(box,reply); else{ wait.remove(); row=addMsg("bot",reply); }
    toBottom(); remember("bot",reply); chatHistory.push({role:"assistant",content:reply});
    if(reply!==REFUSAL){ const ln=[...((src&&src.links)||[]).filter(l=>!/Wikipedia/i.test(l[0])).slice(0,2)]; if(reply.length>350) ln.push(...FOLLOWUPS); appendLinks(row,ln); }
  } else {
    if(row) row.remove(); else wait.remove();
    chatHistory.pop();
    const msg="Maaf Kak, koneksiku lagi kurang stabil. Coba kirim lagi sebentar ya, atau langsung email ke "+EMAIL+".";
    addMsg("bot",msg,null,[["Coba lagi",()=>sendChat(text)]]); remember("bot",msg);
  }
  done();
}
/* ---------- tampilan chat (gaya web baru, fungsi sama seperti web lama) ---------- */
const chatLog=document.getElementById("uni-log"), chatForm=document.getElementById("uni-form"),
      chatInput=document.getElementById("uni-input"), chatSend=document.getElementById("uni-send"),
      chatChips=document.getElementById("uni-chips"), chatFile=document.getElementById("uni-file"),
      chatPre=document.getElementById("uni-pre"), chatPreImg=document.getElementById("uni-pre-img"), chatPreName=document.getElementById("uni-pre-name");
let chatHistory=[], chatBusy=false, pend=null, saved=[];   // pend = lampiran yang menunggu dikirim
const AVATAR='<img src="/uni-avatar.webp" alt="UNI" width="160" height="160" draggable="false" class="h-full w-full object-cover">';
const ICON_COPY='<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z"/><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1"/></svg>';
const ICON_OK='<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5l10 -10"/></svg>';
document.getElementById("uni-top-av").innerHTML=AVATAR;

const timeStr=()=>new Intl.DateTimeFormat("id-ID",{timeZone:"Asia/Jakarta",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).format(new Date()).replace(":",".");
const sleep2=ms=>new Promise(r=>setTimeout(r,ms));
const toBottom=()=>{ chatLog.scrollTop=chatLog.scrollHeight; };

// isi gelembung dengan teks + blok kode (tanpa innerHTML untuk teks, aman dari injeksi)
function fillBubble(box,text){
  box.textContent="";
  const parts=String(text).split("```");
  parts.forEach((p,i)=>{
    if(i%2){
      const w=document.createElement("div"); w.className="relative my-2";
      const pre=document.createElement("pre"); pre.className="overflow-x-auto rounded-md bg-slate-900 p-3 pr-10 text-xs text-slate-100";
      const c=document.createElement("code"); c.textContent=p.replace(/^\n+/,""); pre.appendChild(c);
      const cp=document.createElement("button"); cp.type="button"; cp.setAttribute("aria-label","Salin kode");
      cp.className="absolute right-1.5 top-1.5 inline-flex h-7 w-7 items-center justify-center rounded-md text-slate-300 transition hover:bg-slate-700"; cp.innerHTML=ICON_COPY;
      cp.addEventListener("click",()=>{ try{ navigator.clipboard.writeText(c.textContent); cp.innerHTML=ICON_OK; setTimeout(()=>{ cp.innerHTML=ICON_COPY; },1500); }catch(e){} });
      w.append(pre,cp); box.appendChild(w);
    } else {
      const s2=p.replace(/^\n+|\n+$/g,"");
      if(s2){ const s=document.createElement("span"); s.className="whitespace-pre-wrap"; s.textContent=s2; box.appendChild(s); }
    }
  });
}
function addRow(role){
  const prev=chatLog.lastElementChild;
  const r=document.createElement("div"); r.className="row "+role+" flex items-end gap-2 "+(role==="bot"?"justify-start pr-[10%]":"justify-end pl-[10%]");
  if(role==="bot"){
    const a=document.createElement("span");
    a.className="av h-8 w-8 shrink-0 overflow-hidden rounded-full border border-slate-200 bg-slate-100"+(prev&&prev.classList.contains("bot")?" invisible":"");
    a.innerHTML=AVATAR; r.appendChild(a);
  }
  chatLog.appendChild(r); return r;
}
const LINK_CLS="rounded-md border border-primary bg-white px-3 py-1.5 text-xs font-semibold text-primary transition hover:bg-slate-50";
function runLink(l){
  if(typeof l[1]==="function") l[1]();
  else if(/^https?:\/\//i.test(l[1])) window.open(l[1],"_blank","noopener,noreferrer");
  else location.href=l[1];
}
function addMsg(role,text,att,links,still){
  const r=addRow(role), d=document.createElement("div");
  d.className="msg min-w-0 break-words rounded-lg px-3 py-2 text-sm leading-relaxed "+role+(role==="user"?" bg-primary text-white":" border border-slate-200 bg-white text-default")+(still?" still":"");
  if(att&&att.img){ const im=document.createElement("img"); im.className="att mb-2 max-h-48 rounded-md"; im.alt="Foto lampiran"; im.src=att.img; d.appendChild(im); }
  else if(att){ const f=document.createElement("div"); f.className="fchip mb-2 rounded-md bg-white/20 px-2 py-1 text-xs"; f.textContent="📎 "+att.name; d.appendChild(f); }
  const body=document.createElement("div"); body.className="mt"; fillBubble(body,text); d.appendChild(body);
  if(links&&links.length){
    const lk=document.createElement("div"); lk.className="lk mt-2 flex flex-wrap gap-2";
    links.forEach(l=>{ const b=document.createElement("button"); b.type="button"; b.className=LINK_CLS; b.textContent=l[0]; b.addEventListener("click",()=>{ if(!chatBusy||typeof l[1]!=="function") runLink(l); }); lk.appendChild(b); });
    d.appendChild(lk);
  }
  const t=document.createElement("small"); t.className="mm mt-1 block text-[11px] opacity-70"+(role==="user"?" text-right":""); t.textContent=timeStr()+(role==="user"?" ✓✓":""); d.appendChild(t);
  r.appendChild(d); toBottom(); return r;
}
function typingRow(){
  const r=addRow("bot"), d=document.createElement("div"); d.className="msg bot rounded-lg border border-slate-200 bg-white px-3 py-3";
  const w=document.createElement("span"); w.className="flex items-center gap-1";
  for(let i=0;i<3;i++){ const x=document.createElement("i"); x.className="block h-1.5 w-1.5 animate-bounce rounded-full bg-slate-400"; x.style.animationDelay=(i*150)+"ms"; w.appendChild(x); }
  d.appendChild(w); r.appendChild(d); toBottom(); return r;
}
function appendLinks(row,links){
  const d=row&&row.querySelector(".msg"); if(!d||!links||!links.length) return;
  const lk=document.createElement("div"); lk.className="lk mt-2 flex flex-wrap gap-2";
  links.forEach(l=>{ const b=document.createElement("button"); b.type="button"; b.className=LINK_CLS; b.textContent=l[0];
    b.addEventListener("click",()=>{ if(!chatBusy||typeof l[1]!=="function") runLink(l); }); lk.appendChild(b); });
  const mm=d.querySelector(".mm"); d.insertBefore(lk,mm||null); toBottom();
}
function persist(){ try{ sessionStorage.setItem("uni_chat_v1",JSON.stringify({l:saved.slice(-40),h:chatHistory.slice(-24)})); }catch(e){} }
function remember(role,text){ saved.push({r:role,t:text}); persist(); }
function dayLabel(){ const dy=document.createElement("div"); dy.className="cday py-1 text-center text-xs text-muted"; dy.textContent="Hari ini"; chatLog.appendChild(dy); }
function chatWelcome(){
  chatLog.innerHTML=""; chatHistory=[]; saved=[]; lastTopic=""; clearPend(); try{ sessionStorage.removeItem("uni_chat_v1"); }catch(e){}
  dayLabel();
  addMsg("bot","Halo Kak! 👋 Aku UNI, asisten Tuan Agus Budiono.");
  addMsg("bot","Mau tanya soal layanan dan harga, atau hal apa saja? Langsung ketik ya, aku jawab 😊");
  chatChips.hidden=false;
}
function chatRestore(){
  try{ const o=JSON.parse(sessionStorage.getItem("uni_chat_v1")||"null"); if(!o||!o.l||!o.l.length) return false;
    dayLabel();
    o.l.forEach(m=>addMsg(m.r,m.t,null,null,true)); saved=o.l; chatHistory=o.h||[]; chatChips.hidden=true; return true; }catch(e){ return false; }
}
["Berapa harga pembuatan website?","Layanan apa saja yang tersedia?","Bagaimana cara memesan?","Bagaimana cara menghubungi Tuan Agus?"].forEach(q=>{
  const b=document.createElement("button"); b.type="button";
  b.className="shrink-0 whitespace-nowrap rounded-md border border-primary bg-white px-3 py-1.5 text-sm text-primary transition hover:bg-slate-50";
  b.textContent=q.replace("Tuan Agus","Agus");
  b.addEventListener("click",()=>sendChat(q)); chatChips.appendChild(b);
});

/* ---- lampiran foto / berkas ---- */
function clearPend(){ pend=null; chatPre.hidden=true; chatPreImg.hidden=true; chatPreImg.removeAttribute("src"); chatFile.value=""; }
function shrink(file){   // kecilkan foto agar ringan dikirim dan dibaca
  return new Promise(res=>{ const fr=new FileReader(); fr.onerror=()=>res(null);
    fr.onload=()=>{ const im=new Image(); im.onerror=()=>res(null);
      im.onload=()=>{ const k=Math.min(1,1024/Math.max(im.width,im.height)), c=document.createElement("canvas");
        c.width=Math.round(im.width*k); c.height=Math.round(im.height*k); c.getContext("2d").drawImage(im,0,0,c.width,c.height);
        res(c.toDataURL("image/jpeg",.82)); };
      im.src=fr.result; };
    fr.readAsDataURL(file); });
}
document.getElementById("uni-attach").addEventListener("click",()=>chatFile.click());
document.getElementById("uni-pre-x").addEventListener("click",clearPend);
chatFile.addEventListener("change",async()=>{
  const f=chatFile.files&&chatFile.files[0]; if(!f) return;
  if(f.size>8*1048576){ chatFile.value=""; addMsg("bot","Maaf Kak, ukuran berkasnya kebesaran. Maksimal 8 MB ya 🙏"); return; }
  if(f.type.startsWith("image/")){ const u=await shrink(f); if(!u){ chatFile.value=""; return; }
    pend={name:f.name,img:u}; chatPreImg.src=u; chatPreImg.hidden=false; }
  else{ let txt=""; if(/^text\//.test(f.type)||/\.(txt|csv)$/i.test(f.name)){ try{ txt=(await f.text()).slice(0,4000); }catch(e){} }
    pend={name:f.name,txt}; chatPreImg.hidden=true; }
  chatPreName.textContent=f.name; chatPre.hidden=false; chatInput.focus({preventScroll:true});
});


chatForm.addEventListener("submit",e=>{e.preventDefault(); sendChat(chatInput.value)});
chatInput.addEventListener("keydown",e=>{ if(e.key==="Enter"&&!e.shiftKey&&!e.isComposing){ e.preventDefault(); sendChat(chatInput.value);} });
chatInput.addEventListener("input",()=>{chatInput.style.height="auto"; chatInput.style.height=Math.min(chatInput.scrollHeight,120)+"px"});
document.getElementById("uni-clear").addEventListener("click",()=>{ if(!chatBusy) chatWelcome(); });
if(!chatRestore()) chatWelcome();
})();
</script>
