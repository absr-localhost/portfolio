---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, EMAIL, projects as kategori, slugKategori } from '~/data/profil';
import { layananDetail } from '~/data/layanan-detail';
import { proyekSaya } from '~/data/proyek-saya';

// Satu halaman untuk tiap item proyek: /proyek/aplikasi-pendidikan/absensi-digital-murid, dst.
export function getStaticPaths() {
  return kategori.flatMap((k) =>
    k.items.map((judul, n) => ({
      params: { slug: slugKategori(k.title), item: slugKategori(judul) },
      props: { k, judul, n },
    })),
  );
}

const { k, judul, n } = Astro.props;
const info = layananDetail.find((x) => x.title === judul);
const saya = proyekSaya[judul];
const d = info?.detail;
const sebelumnya = n > 0 ? k.items[n - 1] : null;
const berikutnya = n < k.items.length - 1 ? k.items[n + 1] : null;
const kembali = `/proyek/${slugKategori(k.title)}`;
const metadata = { title: judul, description: info?.desc };
---

<Layout metadata={metadata}>
  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={wrap}>
      <a href={kembali} class="mb-4 inline-flex items-center gap-1 text-xs font-semibold text-slate-300 hover:text-white sm:text-sm">
        <Icon name="tabler:arrow-left" class="h-4 w-4" /> Kembali ke {k.title}
      </a>
      <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">{judul}</h1>
      {info && <p class="mt-3 max-w-3xl text-slate-300">{info.desc}</p>}
    </div>
  </section>

  <section class="bg-slate-50 py-8 sm:py-10">
    <div class={`${wrap} grid gap-5 lg:grid-cols-3`}>
      <div class="space-y-5 lg:col-span-2">
        {
          saya && (
            <div class={`${card} p-5 sm:p-6`}>
              <h2 class="text-base font-bold text-heading sm:text-lg">Pengalaman saya</h2>
              <p class="mt-2 leading-relaxed text-default">{saya.pengantar}</p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-muted">Teknologi dan alat yang saya pakai</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {saya.teknologi.map((t) => (
                  <span class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-sm text-default">{t}</span>
                ))}
              </div>
            </div>
          )
        }

        {
          d && (
            <div class={`${card} p-5 sm:p-6`}>
              <h2 class="text-base font-bold text-heading sm:text-lg">Gambaran pekerjaan</h2>
              <p class="mt-2 leading-relaxed text-default">{d.gambaran}</p>
            </div>
          )
        }

        {
          d && (
            <div class="grid gap-5 sm:grid-cols-2">
              <div class={`${card} p-5`}>
                <h2 class="text-base font-bold text-heading">Yang saya kerjakan</h2>
                <ul class="mt-3 space-y-2">
                  {d.lingkup.map((x) => (
                    <li class="flex items-start gap-2 text-sm text-default">
                      <Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      <span>{x}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class={`${card} p-5`}>
                <h2 class="text-base font-bold text-heading">Manfaat yang didapat</h2>
                <ul class="mt-3 space-y-2">
                  {d.manfaat.map((x) => (
                    <li class="flex items-start gap-2 text-sm text-default">
                      <Icon name="tabler:circle-check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                      <span>{x}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )
        }
      </div>

      <aside class="space-y-5">
        {
          d && (
            <div class={`${card} p-5`}>
              <h2 class="text-base font-bold text-heading">Cocok untuk</h2>
              <p class="mt-2 text-sm leading-relaxed text-default">{d.cocok}</p>
            </div>
          )
        }
        <div class="rounded-2xl bg-gradient-to-r from-primary to-secondary p-5 text-white">
          <p class="text-sm">Butuh yang serupa untuk kebutuhan Anda? Ceritakan lewat email.</p>
          <a href={`mailto:${EMAIL}`} class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-accent px-4 py-2 text-xs font-semibold text-primary sm:text-sm">
            <Icon name="tabler:mail" class="h-4 w-4" /> Hubungi saya
          </a>
        </div>
      </aside>
    </div>

    <div class={`${wrap} mt-8 grid gap-3 sm:grid-cols-2`}>
      {
        sebelumnya ? (
          <a href={`${kembali}/${slugKategori(sebelumnya)}`} class={`${card} flex items-center gap-2 p-4 text-sm font-semibold text-heading hover:border-accent`}>
            <Icon name="tabler:arrow-left" class="h-4 w-4 shrink-0" />
            <span>{sebelumnya}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        berikutnya && (
          <a href={`${kembali}/${slugKategori(berikutnya)}`} class={`${card} flex items-center justify-end gap-2 p-4 text-right text-sm font-semibold text-heading hover:border-accent`}>
            <span>{berikutnya}</span>
            <Icon name="tabler:arrow-right" class="h-4 w-4 shrink-0" />
          </a>
        )
      }
    </div>
  </section>
</Layout>
