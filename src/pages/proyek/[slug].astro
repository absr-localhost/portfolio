---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { wrap, card, EMAIL, projects as kategori, slugKategori } from '~/data/profil';

// Satu halaman untuk tiap kategori proyek: /proyek/aplikasi-pendidikan, /proyek/multimedia, dst.
export function getStaticPaths() {
  return kategori.map((k, i) => ({
    params: { slug: slugKategori(k.title) },
    props: { k, i },
  }));
}

const { k, i } = Astro.props;
const lainnya = kategori.filter((_, n) => n !== i);
const metadata = { title: k.title };
---

<Layout metadata={metadata}>
  <section class="bg-primary py-12 text-white sm:py-16">
    <div class={wrap}>
      <a href="/#portofolio" class="mb-4 inline-flex items-center gap-1 text-xs font-semibold text-slate-300 hover:text-white sm:text-sm">
        <Icon name="tabler:arrow-left" class="h-4 w-4" /> Kembali ke Beranda
      </a>
      <h1 class="text-2xl font-bold tracking-tight sm:text-4xl">{k.title}</h1>
      <p class="mt-3 text-slate-300">{k.items.length} proyek dan pekerjaan di kategori ini.</p>
    </div>
  </section>

  <section class="bg-slate-50 py-8 sm:py-10">
    <div class={wrap}>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          k.items.map((it) => (
            <li class={`${card} flex items-start gap-3 p-4`}>
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white">
                <Icon name="tabler:check" class="h-4 w-4" />
              </span>
              <span class="text-sm font-semibold leading-snug text-heading sm:text-base">{it}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-col items-start gap-3 rounded-2xl bg-gradient-to-r from-primary to-secondary p-5 text-white sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <p class="text-sm sm:text-base">Butuh yang serupa untuk kebutuhan Anda? Ceritakan lewat email.</p>
        <a href={`mailto:${EMAIL}`} class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-4 py-2 text-xs font-semibold text-primary sm:text-sm">
          <Icon name="tabler:mail" class="h-4 w-4" /> Hubungi saya
        </a>
      </div>

      <h2 class="mt-10 text-base font-bold text-heading sm:text-lg">Kategori lainnya</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          lainnya.map((o) => (
            <a
              href={`/proyek/${slugKategori(o.title)}`}
              class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-heading hover:border-accent sm:text-sm"
            >
              {o.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
