---
import Layout from '~/layouts/Layout.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import Gerak from '~/components/Gerak.astro';
import { Icon } from 'astro-icon/components';

import { headerData, footerData } from '~/navigation';
import { EMAIL } from '~/data/profil';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;

// Menu sidebar diambil dari navigasi yang sudah ada (src/navigation.ts),
// submenu "Lainnya" diratakan agar semua halaman tetap bisa dibuka.
type Tautan = { text?: string; href?: string; links?: Tautan[] };
const semua: Tautan[] = headerData.links.flatMap((l: Tautan) => (l.links ? l.links : [l]));

const ikon: Record<string, string> = {
  '/': 'tabler:home',
  '/layanan': 'tabler:briefcase',
  '/perjalanan': 'tabler:user',
  '/proyek': 'tabler:folder',
  '/artikel': 'tabler:file-text',
  '/produk': 'tabler:package',
  '/kontak': 'tabler:share',
  '/asisten': 'tabler:headset',
  '/aplikasi': 'tabler:device-mobile',
  '/saham': 'tabler:chart-line',
};

const path = '/' + Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const aktif = (href?: string) => {
  if (!href) return false;
  const h = '/' + href.replace(/^\/+|\/+$/g, '');
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />

  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it were already emitted, so their
    SVG sprite symbol goes missing on that page.
    */
  }

  {
    Astro.slots.has('header') ? (
      <slot name="header" />
    ) : (
      <>
        <!-- Overlay HP: menutup sidebar saat disentuh -->
        <div id="sb-ov" class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"></div>

        <!-- SIDEBAR: tetap di kiri pada layar lebar, laci geser pada HP -->
        <aside
          id="sb"
          aria-label="Menu utama"
          class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col overflow-y-auto bg-primary text-white transition-transform duration-200 motion-reduce:transition-none lg:translate-x-0"
        >
          <div class="flex items-center justify-between gap-2 px-4 pt-4">
            <a href="/" class="block rounded-xl bg-white p-2" aria-label="Beranda">
              <img
                src="/logo-header.png"
                alt="Agus Budiono - Technology Solutions"
                class="block h-10 w-auto"
                width="2878"
                height="633"
              />
            </a>
            <button id="sb-x" type="button" class="rounded-lg p-2 hover:bg-white/10 lg:hidden" aria-label="Tutup menu">
              <Icon name="tabler:x" class="h-5 w-5" />
            </button>
          </div>

          <nav class="mt-5 flex-1 px-3">
            <ul class="space-y-1">
              {
                semua.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      aria-current={aktif(l.href) ? 'page' : undefined}
                      class={`flex items-center gap-3 rounded-xl px-2.5 py-2 text-sm font-medium transition ${
                        aktif(l.href) ? 'bg-accent text-primary' : 'text-slate-200 hover:bg-white/10'
                      }`}
                    >
                      <span
                        class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${
                          aktif(l.href) ? 'bg-primary/10' : 'bg-white/10'
                        }`}
                      >
                        <Icon name={ikon[l.href || ''] || 'tabler:link'} class="h-4 w-4" />
                      </span>
                      <span class="min-w-0">{l.text}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="mx-3 mt-4 rounded-xl border border-white/10 bg-white/5 p-3">
            <p class="text-xs leading-snug text-slate-200">Mari berkolaborasi untuk masa depan digital yang lebih baik.</p>
            <a
              href={`mailto:${EMAIL}`}
              class="mt-2.5 inline-flex items-center gap-1.5 rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-primary"
            >
              Hubungi saya
              <Icon name="tabler:arrow-right" class="h-3.5 w-3.5" />
            </a>
          </div>

          <div class="mt-4 flex flex-wrap gap-2 px-4">
            {
              footerData.socialLinks.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.ariaLabel}
                  class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
                >
                  <Icon name={s.icon || 'tabler:link'} class="h-4 w-4" />
                </a>
              ))
            }
            <a
              href={`mailto:${EMAIL}`}
              aria-label="Email"
              class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
            >
              <Icon name="tabler:mail" class="h-4 w-4" />
            </a>
          </div>

          <p class="px-4 pb-4 pt-3 text-[11px] leading-snug text-slate-300">{footerData.footNote}</p>
        </aside>
      </>
    )
  }

  <div class="flex min-w-0 flex-1 flex-col lg:pl-64">
    {
      !Astro.slots.has('header') && (
        <!-- Bar atas HP: logo dan tombol menu -->
        <div class="sticky top-0 z-20 flex items-center justify-between gap-3 border-b border-slate-200 bg-white px-4 py-2 lg:hidden">
          <a href="/" aria-label="Beranda">
            <img
              src="/logo-header.png"
              alt="Agus Budiono - Technology Solutions"
              class="block h-9 w-auto"
              width="2878"
              height="633"
            />
          </a>
          <button
            id="sb-btn"
            type="button"
            aria-controls="sb"
            aria-expanded="false"
            aria-label="Buka menu"
            class="rounded-lg p-2 text-heading hover:bg-slate-100"
          >
            <Icon name="tabler:menu-2" class="h-6 w-6" />
          </button>
        </div>
      )
    }

    {Astro.slots.has('announcement') ? <slot name="announcement" /> : <Announcement />}
    <main class="flex-1">
      <slot />
    </main>
    {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
  </div>
  <Gerak />

  <script is:inline>
    (function () {
      if (window.__sbSiap) return;
      window.__sbSiap = true;

      function ambil() {
        return {
          a: document.getElementById('sb'),
          o: document.getElementById('sb-ov'),
          b: document.getElementById('sb-btn'),
        };
      }
      function buka() {
        var x = ambil();
        if (!x.a) return;
        x.a.classList.remove('-translate-x-full');
        if (x.o) x.o.classList.remove('hidden');
        if (x.b) x.b.setAttribute('aria-expanded', 'true');
      }
      function tutup() {
        var x = ambil();
        if (!x.a) return;
        x.a.classList.add('-translate-x-full');
        if (x.o) x.o.classList.add('hidden');
        if (x.b) x.b.setAttribute('aria-expanded', 'false');
      }

      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!(t instanceof Element)) return;
        if (t.closest('#sb-btn')) {
          var a = document.getElementById('sb');
          if (a && a.classList.contains('-translate-x-full')) buka();
          else tutup();
          return;
        }
        if (t.closest('#sb-ov') || t.closest('#sb-x') || t.closest('#sb a')) tutup();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') tutup();
      });
    })();
  </script>
</Layout>
