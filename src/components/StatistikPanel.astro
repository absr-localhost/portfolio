---
import { Icon } from 'astro-icon/components';
import { wrap } from '~/data/profil';

const card = 'rounded-xl border border-slate-200 bg-white shadow-sm';
const label = 'text-xs font-medium text-muted';
const angka = 'mt-3 text-3xl font-bold leading-none tabular-nums text-heading';
const ikon = 'flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary';
const sub = 'mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted';
const judul = 'text-sm font-semibold text-heading';
const kepala = 'flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3';
const baris = 'flex items-center justify-between gap-3 px-4 py-3';
const tombol = 'rounded-md px-2.5 py-1 text-muted';
---

<div class="bg-slate-50">
  <section class={`${wrap} pb-14 pt-6 sm:pb-16 sm:pt-8`}>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <div class={`${card} p-4`}>
        <div class="flex items-start justify-between gap-2">
          <p class={label}>Total kunjungan</p>
          <span class={ikon}><Icon name="tabler:eye" class="h-5 w-5" /></span>
        </div>
        <p class={angka} data-k="total">-</p>
      </div>
      <div class={`${card} p-4`}>
        <div class="flex items-start justify-between gap-2">
          <p class={label}>Hari ini</p>
          <span class={ikon}><Icon name="tabler:calendar" class="h-5 w-5" /></span>
        </div>
        <p class={angka} data-k="hari">-</p>
        <p class={sub} data-k="s-hari"></p>
      </div>
      <div class={`${card} p-4`}>
        <div class="flex items-start justify-between gap-2">
          <p class={label}>Bulan ini</p>
          <span class={ikon}><Icon name="tabler:chart-bar" class="h-5 w-5" /></span>
        </div>
        <p class={angka} data-k="bulan">-</p>
        <p class={sub} data-k="s-bulan"></p>
      </div>
      <div class={`${card} p-4`}>
        <div class="flex items-start justify-between gap-2">
          <p class={label}>Rata-rata harian</p>
          <span class={ikon}><Icon name="tabler:chart-line" class="h-5 w-5" /></span>
        </div>
        <p class={angka} data-k="rata">-</p>
        <p class={sub} data-k="s-rata"></p>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={`${card} lg:col-span-2`}>
        <div class={kepala}>
          <div>
            <h3 class={judul}>Kunjungan harian</h3>
            <p class="mt-0.5 text-xs text-muted" data-k="sub-harian">14 hari terakhir</p>
          </div>
          <div class="flex rounded-lg bg-slate-100 p-0.5 text-xs font-semibold">
            <button type="button" data-r="7" class={tombol}>7</button>
            <button type="button" data-r="14" class={tombol}>14</button>
            <button type="button" data-r="30" class={tombol}>30</button>
          </div>
        </div>
        <div class="p-4">
          <div class="min-h-[200px] w-full" data-k="grafik-harian"></div>
        </div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Ringkasan 30 hari</h3></div>
        <dl class="divide-y divide-slate-100 text-sm">
          <div class={baris}>
            <dt class="text-muted">Total kunjungan</dt>
            <dd class="font-semibold tabular-nums text-heading" data-k="r-total">-</dd>
          </div>
          <div class={baris}>
            <dt class="text-muted">Hari tersibuk</dt>
            <dd class="font-semibold tabular-nums text-heading" data-k="r-puncak">-</dd>
          </div>
          <div class={baris}>
            <dt class="text-muted">7 hari terakhir</dt>
            <dd class="flex items-center gap-2">
              <span class="hidden" data-k="d-minggu"></span>
              <span class="font-semibold tabular-nums text-heading" data-k="r-minggu">-</span>
            </dd>
          </div>
          <div class={baris}>
            <dt class="text-muted">Hari dengan kunjungan</dt>
            <dd class="font-semibold tabular-nums text-heading" data-k="r-aktif">-</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={`${card} lg:col-span-2`}>
        <div class={kepala}>
          <h3 class={judul}>Kunjungan bulanan</h3>
          <p class="text-xs text-muted">6 bulan terakhir</p>
        </div>
        <div class="p-4">
          <div class="min-h-[190px] w-full" data-k="grafik-bulanan"></div>
        </div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Aktivitas 30 hari</h3></div>
        <div class="grid grid-cols-10 gap-1.5 p-4" data-k="heat"></div>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Perangkat</h3></div>
        <div class="p-4" data-k="d-dev"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Browser</h3></div>
        <div class="p-4" data-k="d-br"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Pengunjung</h3></div>
        <div class="p-4" data-k="d-jn"></div>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Negara</h3></div>
        <div class="p-4" data-k="l-neg"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Sumber kunjungan</h3></div>
        <div class="p-4" data-k="l-src"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}>Halaman masuk</h3></div>
        <div class="p-4" data-k="l-pg"></div>
      </div>
    </div>

    <p class="mt-4 text-xs text-muted" data-k="sumber"></p>
  </section>
</div>

<script>
  type Titik = { t: string; n: number };
  type Hitung = { k: string; n: number };

  const BLN = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const fmt = (n: number) => n.toLocaleString('id-ID');
  const naik = (m: number) => Math.max(4, Math.ceil(m / 4) * 4);
  const jml = (a: Titik[]) => a.reduce((s, x) => s + x.n, 0);
  const q = (k: string) => document.querySelector<HTMLElement>(`[data-k="${k}"]`);
  const isiTeks = (k: string, v: string) => {
    const el = q(k);
    if (el) el.textContent = v;
  };
  const tglPendek = (t: string) => {
    const p = t.split('-');
    return `${Number(p[2])} ${BLN[Number(p[1]) - 1]}`;
  };
  const blnPendek = (t: string) => BLN[Number(t.split('-')[1]) - 1];
  const waktuFmt = (w: string) => {
    const m = /^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})$/.exec(w || '');
    return m ? `${Number(m[3])} ${BLN[Number(m[2]) - 1]} ${m[1]}, ${m[4]}.${m[5]} WIB` : '';
  };

  let terakhir: any = null;
  let rentang = 14;

  function kisi(W: number, H: number, l: number, r: number, t: number, b: number, yMax: number) {
    let garis = '';
    let angka = '';
    for (let k = 0; k <= 4; k++) {
      const v = (yMax * k) / 4;
      const yy = t + (H - t - b) * (1 - v / yMax);
      garis += `<line x1="${l}" x2="${W - r}" y1="${yy}" y2="${yy}" stroke="currentColor" stroke-dasharray="${k ? '3 3' : '0'}" />`;
      angka += `<text x="${l - 6}" y="${yy + 4}" text-anchor="end" class="fill-slate-500 text-[11px]">${fmt(v)}</text>`;
    }
    return `<g class="text-slate-200">${garis}</g>${angka}`;
  }

  function gambarHarian(semua: Titik[]) {
    const el = q('grafik-harian');
    if (!el) return;
    const seri = semua.slice(-rentang);
    const n = seri.length;
    const W = Math.max(el.clientWidth, 240);
    const H = 200, l = 30, r = 10, t = 12, b = 24;
    const yMax = naik(Math.max(...seri.map((s) => s.n)));
    const x = (i: number) => l + (i * (W - l - r)) / (n - 1);
    const y = (v: number) => t + (H - t - b) * (1 - v / yMax);
    const garis = seri.map((s, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(s.n).toFixed(1)}`).join(' ');
    const area = `${garis} L${x(n - 1).toFixed(1)} ${H - b} L${x(0).toFixed(1)} ${H - b} Z`;
    const langkah = n <= 7 ? 1 : n <= 14 ? 3 : 7;
    const awal = `${n} hari terakhir`;
    let titik = '';
    let label = '';
    seri.forEach((s, i) => {
      if (n <= 14) {
        titik += `<circle cx="${x(i).toFixed(1)}" cy="${y(s.n).toFixed(1)}" r="3" fill="white" stroke="currentColor" stroke-width="1.5" />`;
      }
      if ((n - 1 - i) % langkah === 0) {
        label += `<text x="${x(i).toFixed(1)}" y="${H - 6}" text-anchor="${i === n - 1 ? 'end' : 'middle'}" class="fill-slate-500 text-[11px]">${tglPendek(s.t)}</text>`;
      }
    });
    el.innerHTML =
      `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="block text-primary" style="touch-action:pan-y" role="img" aria-label="Grafik kunjungan harian">` +
      `<defs><linearGradient id="gHarian" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="currentColor" stop-opacity="0.25" /><stop offset="1" stop-color="currentColor" stop-opacity="0" /></linearGradient></defs>` +
      kisi(W, H, l, r, t, b, yMax) +
      `<path d="${area}" fill="url(#gHarian)" />` +
      `<path d="${garis}" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />` +
      titik +
      label +
      `<g data-m visibility="hidden"><line y1="${t}" y2="${H - b}" stroke="currentColor" stroke-opacity="0.35" /><circle r="5" fill="currentColor" /></g>` +
      `</svg>`;
    isiTeks('sub-harian', awal);

    const svg = el.querySelector('svg') as SVGSVGElement;
    const m = svg.querySelector('[data-m]') as SVGGElement;
    const ml = m.querySelector('line') as SVGLineElement;
    const mc = m.querySelector('circle') as SVGCircleElement;
    const geser = (e: PointerEvent) => {
      const bb = svg.getBoundingClientRect();
      let i = Math.round(((e.clientX - bb.left - l) / (W - l - r)) * (n - 1));
      i = Math.max(0, Math.min(n - 1, i));
      ml.setAttribute('x1', String(x(i)));
      ml.setAttribute('x2', String(x(i)));
      mc.setAttribute('cx', String(x(i)));
      mc.setAttribute('cy', String(y(seri[i].n)));
      m.setAttribute('visibility', 'visible');
      isiTeks('sub-harian', `${tglPendek(seri[i].t)}: ${fmt(seri[i].n)}`);
    };
    svg.addEventListener('pointermove', geser);
    svg.addEventListener('pointerdown', geser);
    svg.addEventListener('pointerleave', () => {
      m.setAttribute('visibility', 'hidden');
      isiTeks('sub-harian', awal);
    });
  }

  function gambarBulanan(seri: Titik[]) {
    const el = q('grafik-bulanan');
    if (!el) return;
    const W = Math.max(el.clientWidth, 240);
    const H = 190, l = 30, r = 10, t = 22, b = 24;
    const n = seri.length;
    const yMax = naik(Math.max(...seri.map((s) => s.n)));
    const slot = (W - l - r) / n;
    const bw = Math.min(36, slot * 0.55);
    let batang = '';
    seri.forEach((s, i) => {
      const cx = l + slot * (i + 0.5);
      const h = s.n > 0 ? Math.max(2, (H - t - b) * (s.n / yMax)) : 0;
      if (h > 0) {
        batang += `<rect x="${(cx - bw / 2).toFixed(1)}" y="${(H - b - h).toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="3" fill="currentColor" fill-opacity="${i === n - 1 ? 1 : 0.35}" />`;
        batang += `<text x="${cx.toFixed(1)}" y="${(H - b - h - 6).toFixed(1)}" text-anchor="middle" class="fill-slate-700 text-[11px] font-semibold">${fmt(s.n)}</text>`;
      }
      batang += `<text x="${cx.toFixed(1)}" y="${H - 6}" text-anchor="middle" class="fill-slate-500 text-[11px]">${blnPendek(s.t)}</text>`;
    });
    el.innerHTML =
      `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="block text-primary" role="img" aria-label="Grafik kunjungan bulanan">` +
      kisi(W, H, l, r, t, b, yMax) +
      batang +
      `</svg>`;
  }

  function gambarHeat(seri: Titik[]) {
    const el = q('heat');
    if (!el) return;
    const maks = Math.max(1, ...seri.map((s) => s.n));
    el.innerHTML = seri
      .map((s) => {
        const warna = s.n > 0 ? 'bg-primary' : 'bg-slate-100';
        const gaya = s.n > 0 ? `opacity:${(0.25 + (0.75 * s.n) / maks).toFixed(2)}` : '';
        return `<div class="aspect-square rounded ${warna}" style="${gaya}" title="${tglPendek(s.t)}: ${fmt(s.n)}"></div>`;
      })
      .join('');
  }

  const ALPHA = [1, 0.7, 0.45, 0.28, 0.16, 0.08];
  const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => '&#' + c.charCodeAt(0) + ';');
  const kosongHtml = '<p class="text-sm text-muted">Belum ada data.</p>';

  function donat(id: string, arr: Hitung[] | undefined) {
    const el = q(id);
    if (!el) return;
    const tot = arr ? arr.reduce((s, x) => s + x.n, 0) : 0;
    if (!arr || tot === 0) {
      el.innerHTML = kosongHtml;
      return;
    }
    const R = 42;
    const C = 2 * Math.PI * R;
    let pos = 0;
    let seg = '';
    let leg = '';
    arr.forEach((x, i) => {
      const f = x.n / tot;
      const a = ALPHA[Math.min(i, ALPHA.length - 1)];
      seg += `<circle cx="60" cy="60" r="${R}" fill="none" stroke="currentColor" stroke-opacity="${a}" stroke-width="16" stroke-dasharray="${(f * C).toFixed(2)} ${(C - f * C).toFixed(2)}" stroke-dashoffset="${(-pos * C).toFixed(2)}" transform="rotate(-90 60 60)" />`;
      pos += f;
      leg += `<li class="flex items-center justify-between gap-3"><span class="flex min-w-0 items-center gap-2"><span class="h-2.5 w-2.5 shrink-0 rounded-sm bg-primary" style="opacity:${a}"></span><span class="truncate text-muted">${esc(x.k)}</span></span><span class="font-semibold tabular-nums text-heading">${Math.round(f * 100)}%</span></li>`;
    });
    el.innerHTML =
      `<div class="flex items-center gap-4"><svg viewBox="0 0 120 120" class="h-28 w-28 shrink-0 text-primary" role="img" aria-label="Diagram lingkaran"><circle cx="60" cy="60" r="${R}" fill="none" stroke="currentColor" stroke-opacity="0.06" stroke-width="16" />${seg}<text x="60" y="66" text-anchor="middle" class="fill-slate-800 text-[18px] font-bold">${fmt(tot)}</text></svg>` +
      `<ul class="min-w-0 flex-1 space-y-2 text-sm">${leg}</ul></div>`;
  }

  function daftar(id: string, arr: Hitung[] | undefined) {
    const el = q(id);
    if (!el) return;
    const tot = arr ? arr.reduce((s, x) => s + x.n, 0) : 0;
    if (!arr || tot === 0) {
      el.innerHTML = kosongHtml;
      return;
    }
    const maks = Math.max(...arr.map((x) => x.n));
    el.innerHTML =
      '<ul class="space-y-3 text-sm">' +
      arr
        .map(
          (x) =>
            `<li><div class="flex items-center justify-between gap-3"><span class="truncate text-muted">${esc(x.k)}</span><span class="font-semibold tabular-nums text-heading">${fmt(x.n)}</span></div><div class="mt-1.5 h-1.5 rounded-full bg-slate-100"><div class="h-1.5 rounded-full bg-primary" style="width:${Math.max(4, Math.round((x.n / maks) * 100))}%"></div></div></li>`
        )
        .join('') +
      '</ul>';
  }

  function pesanGrafik(teks: string) {
    ['grafik-harian', 'grafik-bulanan', 'heat', 'd-dev', 'd-br', 'd-jn', 'l-neg', 'l-src', 'l-pg'].forEach((k) => {
      const el = q(k);
      if (el) el.innerHTML = `<p class="col-span-10 text-sm text-muted">${teks}</p>`;
    });
  }

  function chip(k: string, kini: number, lalu: number) {
    const el = q(k);
    if (!el) return;
    if (lalu > 0) {
      const p = Math.round(((kini - lalu) / lalu) * 100);
      const w = p > 0 ? 'bg-emerald-50 text-emerald-700' : p < 0 ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-slate-600';
      el.className = `rounded px-1.5 py-0.5 text-xs font-semibold ${w}`;
      el.textContent = `${p > 0 ? '+' : ''}${p}%`;
    } else {
      el.className = 'hidden';
    }
  }

  function tandai() {
    document.querySelectorAll<HTMLElement>('[data-r]').forEach((b) => {
      const aktif = Number(b.dataset.r) === rentang;
      b.className = 'rounded-md px-2.5 py-1 transition ' + (aktif ? 'bg-primary text-white' : 'text-muted hover:text-heading');
      b.setAttribute('aria-pressed', String(aktif));
    });
  }

  function render(d: any) {
    terakhir = d;
    tandai();
    const angka = (v: unknown) => (typeof v === 'number' ? fmt(v) : '-');
    isiTeks('total', angka(d && d.total));
    isiTeks('hari', angka(d && d.hari));
    isiTeks('bulan', angka(d && d.bulan));

    const ada = d && Array.isArray(d.harian) && d.harian.length >= 14 && Array.isArray(d.bulanan);
    if (!ada) {
      ['rata', 's-rata', 's-hari', 's-bulan', 'r-total', 'r-puncak', 'r-minggu', 'r-aktif'].forEach((k) => isiTeks(k, k.startsWith('r-') || k === 'rata' ? '-' : ''));
      chip('d-minggu', 0, 0);
      pesanGrafik('Data grafik tidak tersedia.');
      isiTeks('sumber', d ? 'Data grafik belum tersedia dari sumber.' : 'Data tidak dapat dimuat. Muat ulang halaman untuk mencoba lagi.');
      return;
    }

    const h: Titik[] = d.harian;
    const jumlah = jml(h);
    const puncak = h.reduce((a, s) => (s.n > a.n ? s : a), h[0]);
    const minggu = jml(h.slice(-7));
    isiTeks('rata', (jumlah / h.length).toLocaleString('id-ID', { maximumFractionDigits: 1 }));
    isiTeks('s-rata', `${h.length} hari terakhir`);
    isiTeks('s-hari', typeof d.kemarin === 'number' ? `Kemarin ${fmt(d.kemarin)}` : '');
    isiTeks('s-bulan', typeof d.bulanLalu === 'number' ? `Bulan lalu ${fmt(d.bulanLalu)}` : '');
    isiTeks('r-total', fmt(jumlah));
    isiTeks('r-puncak', puncak.n > 0 ? `${tglPendek(puncak.t)} (${fmt(puncak.n)})` : '-');
    isiTeks('r-minggu', fmt(minggu));
    chip('d-minggu', minggu, jml(h.slice(-14, -7)));
    isiTeks('r-aktif', `${h.filter((s) => s.n > 0).length} dari ${h.length}`);
    const w = waktuFmt(d.waktu);
    isiTeks('sumber', `Sumber: penghitung kunjungan situs, satu hitungan per perangkat per hari.${w ? ' Diperbarui ' + w + '.' : ''}`);

    gambarHarian(h);
    gambarBulanan(d.bulanan);
    gambarHeat(h);
    const dm = d.dim || {};
    donat('d-dev', dm.dev);
    donat('d-br', dm.br);
    donat('d-jn', dm.jn);
    daftar('l-neg', dm.neg);
    daftar('l-src', dm.src);
    daftar('l-pg', dm.pg);
  }

  document.addEventListener('statistik:data', (e) => render((e as CustomEvent).detail));
  document.addEventListener('astro:page-load', () => {
    const w = window as any;
    if (w.__statistik !== undefined) render(w.__statistik);
    else tandai();
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-r]') as HTMLElement | null;
    if (!b) return;
    rentang = Number(b.dataset.r);
    tandai();
    if (terakhir && Array.isArray(terakhir.harian)) gambarHarian(terakhir.harian);
  });

  let tunda = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(tunda);
    tunda = window.setTimeout(() => {
      if (terakhir) render(terakhir);
    }, 150);
  });

  const awalData = (window as any).__statistik;
  if (awalData !== undefined) render(awalData);
  else tandai();
</script>
