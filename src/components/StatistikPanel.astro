---
import { Icon } from 'astro-icon/components';
import { wrap } from '~/data/profil';

const { judul: judulHalaman = '' } = Astro.props;

const card = 'sp-in rounded-xl border border-slate-200 bg-white shadow-sm';
const kepala = 'flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3';
const judul = 'flex items-center gap-2 text-sm font-semibold text-heading';
const ikonJudul = 'h-4 w-4 text-primary';
const tombol = 'rounded-md px-2.5 py-1 text-muted';
const baris = 'flex items-center justify-between gap-3 px-4 py-3';
const tile = 'sp-in rounded-xl p-4';
const bulat = 'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white';
const subTile = 'mt-2 flex min-h-4 flex-wrap items-center gap-x-2 gap-y-1 text-xs';
---

<div class={judulHalaman ? 'bg-white' : 'bg-slate-50'}>
  <section class={`${wrap} pb-14 sm:pb-16 ${judulHalaman ? 'pt-10 sm:pt-12' : 'pt-6 sm:pt-8'}`}>
    {judulHalaman && <h2 class="mb-4 text-xl font-bold text-heading">{judulHalaman}</h2>}

    <div class="sp-in overflow-hidden rounded-2xl bg-primary p-5 text-white sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-medium text-slate-300">Total kunjungan</p>
          <p class="mt-1 text-4xl font-bold leading-none tabular-nums sm:text-5xl" data-k="total">-</p>
          <p class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-300">
            <span class="hidden" data-k="d-minggu"></span>
            <span data-k="s-total"></span>
          </p>
        </div>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15">
          <Icon name="tabler:eye" class="h-5 w-5" />
        </span>
      </div>
      <svg data-k="sp-total" viewBox="0 0 300 56" preserveAspectRatio="none" class="mt-4 h-14 w-full" aria-hidden="true"></svg>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-4">
      <div class={`${tile} bg-sky-50 text-sky-900`}>
        <div class="flex items-start justify-between gap-2">
          <span class={`${bulat} bg-sky-600`}><Icon name="tabler:calendar" class="h-5 w-5" /></span>
          <svg data-k="sp-hari" viewBox="0 0 60 26" class="h-6 w-14" aria-hidden="true"></svg>
        </div>
        <p class="mt-3 text-xs font-medium">Hari ini</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="hari">-</p>
        <p class={subTile} data-k="s-hari"></p>
      </div>
      <div class={`${tile} bg-violet-50 text-violet-900`}>
        <div class="flex items-start justify-between gap-2">
          <span class={`${bulat} bg-violet-600`}><Icon name="tabler:chart-bar" class="h-5 w-5" /></span>
          <svg data-k="sp-bulan" viewBox="0 0 60 26" class="h-6 w-14" aria-hidden="true"></svg>
        </div>
        <p class="mt-3 text-xs font-medium">Bulan ini</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="bulan">-</p>
        <p class={subTile} data-k="s-bulan"></p>
      </div>
      <div class={`${tile} bg-emerald-50 text-emerald-900`}>
        <div class="flex items-start justify-between gap-2">
          <span class={`${bulat} bg-emerald-600`}><Icon name="tabler:chart-line" class="h-5 w-5" /></span>
          <svg data-k="sp-rata" viewBox="0 0 60 26" class="h-6 w-14" aria-hidden="true"></svg>
        </div>
        <p class="mt-3 text-xs font-medium">Rata-rata harian</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="rata">-</p>
        <p class={subTile} data-k="s-rata"></p>
      </div>
      <div class={`${tile} bg-orange-50 text-orange-900`}>
        <div class="flex items-start justify-between gap-2">
          <span class={`${bulat} bg-orange-600`}><Icon name="tabler:trophy" class="h-5 w-5" /></span>
          <svg data-k="sp-puncak" viewBox="0 0 60 26" class="h-6 w-14" aria-hidden="true"></svg>
        </div>
        <p class="mt-3 text-xs font-medium">Hari tersibuk</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="puncak">-</p>
        <p class={subTile} data-k="s-puncak"></p>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={`${card} lg:col-span-2`}>
        <div class={kepala}>
          <div class="min-w-0">
            <h3 class={judul}><Icon name="tabler:chart-area-line" class={ikonJudul} />Kunjungan harian</h3>
            <p class="mt-0.5 text-xs text-muted" data-k="sub-harian">14 hari terakhir</p>
          </div>
          <div class="flex rounded-lg bg-slate-100 p-0.5 text-xs font-semibold">
            <button type="button" data-r="7" class={tombol}>7</button>
            <button type="button" data-r="14" class={tombol}>14</button>
            <button type="button" data-r="30" class={tombol}>30</button>
          </div>
        </div>
        <div class="p-4">
          <div class="min-h-[200px] w-full" data-k="grafik-harian"></div>
        </div>
      </div>
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:list-details" class={ikonJudul} />Ringkasan 30 hari</h3>
        </div>
        <dl class="divide-y divide-slate-100 text-sm">
          <div class={baris}>
            <dt class="text-muted">Total kunjungan</dt>
            <dd class="font-semibold tabular-nums text-heading" data-k="r-total">-</dd>
          </div>
          <div class={baris}>
            <dt class="text-muted">Hari tersibuk</dt>
            <dd class="font-semibold tabular-nums text-heading" data-k="r-puncak">-</dd>
          </div>
          <div class={baris}>
            <dt class="text-muted">7 hari terakhir</dt>
            <dd class="flex items-center gap-2">
              <span class="hidden" data-k="d-minggu2"></span>
              <span class="font-semibold tabular-nums text-heading" data-k="r-minggu">-</span>
            </dd>
          </div>
          <div class={baris}>
            <dt class="text-muted">Hari dengan kunjungan</dt>
            <dd class="font-semibold tabular-nums text-heading" data-k="r-aktif">-</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={`${card} lg:col-span-2`}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:chart-bar" class={ikonJudul} />Kunjungan bulanan</h3>
          <p class="text-xs text-muted">6 bulan terakhir</p>
        </div>
        <div class="p-4">
          <div class="min-h-[190px] w-full" data-k="grafik-bulanan"></div>
        </div>
      </div>
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:calendar-stats" class={ikonJudul} />Aktivitas 30 hari</h3>
        </div>
        <div class="grid grid-cols-10 gap-1.5 p-4" data-k="heat"></div>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:device-mobile" class={ikonJudul} />Perangkat</h3>
        </div>
        <div class="p-4" data-k="d-dev"></div>
      </div>
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:browser" class={ikonJudul} />Browser</h3>
        </div>
        <div class="p-4" data-k="d-br"></div>
      </div>
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:users" class={ikonJudul} />Pengunjung</h3>
        </div>
        <div class="p-4" data-k="d-jn"></div>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:world" class={ikonJudul} />Negara</h3>
        </div>
        <div class="p-4" data-k="l-neg"></div>
      </div>
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:link" class={ikonJudul} />Sumber kunjungan</h3>
        </div>
        <div class="p-4" data-k="l-src"></div>
      </div>
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:file-text" class={ikonJudul} />Halaman masuk</h3>
        </div>
        <div class="p-4" data-k="l-pg"></div>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3" data-k="g-baru">
      <div class={`${card} hidden`} data-k="w-model">
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:device-mobile" class={ikonJudul} />Model HP</h3>
        </div>
        <div class="p-4" data-k="l-model"></div>
      </div>
      <div class={`${card} hidden`} data-k="w-prov">
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:map-pin" class={ikonJudul} />Provinsi asal</h3>
        </div>
        <div class="p-4" data-k="l-prov"></div>
      </div>
      <div class={`${card} hidden`} data-k="w-os">
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:cpu" class={ikonJudul} />Sistem operasi</h3>
        </div>
        <div class="p-4" data-k="d-os"></div>
      </div>
    </div>

    <div class={`${card} mt-3 hidden sm:mt-4`} data-k="w-baru">
      <div class={kepala}>
        <h3 class={judul}><Icon name="tabler:clock" class={ikonJudul} />Pengunjung terbaru</h3>
        <p class="text-xs text-muted">IP disamarkan</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[480px] text-left text-xs">
          <thead>
            <tr class="border-b border-slate-100 text-muted">
              <th class="px-4 py-2 font-medium">Waktu</th>
              <th class="px-2 py-2 font-medium">IP</th>
              <th class="px-2 py-2 font-medium">Perangkat</th>
              <th class="px-2 py-2 font-medium">Provinsi</th>
              <th class="px-4 py-2 font-medium">Halaman</th>
            </tr>
          </thead>
          <tbody data-k="t-baru"></tbody>
        </table>
      </div>
    </div>

    <p class="mt-4 text-xs text-muted" data-k="sumber"></p>
  </section>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .sp-in {
      animation: sp-naik 0.5s ease-out both;
    }
    .sp-in:nth-child(2) {
      animation-delay: 0.05s;
    }
    .sp-in:nth-child(3) {
      animation-delay: 0.1s;
    }
    .sp-in:nth-child(4) {
      animation-delay: 0.15s;
    }
    @keyframes sp-naik {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  type Titik = { t: string; n: number };
  type Hitung = { k: string; n: number };

  const BLN = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const PALET = ['#2a78d6', '#6250d6', '#1baf7a', '#eb6834', '#e87ba4', '#0B2545'];
  const warna = (i: number) => PALET[i] || '#94a3b8';
  const fmt = (n: number) => n.toLocaleString('id-ID');
  const naik = (m: number) => Math.max(4, Math.ceil(m / 4) * 4);
  const jml = (a: Titik[]) => a.reduce((s, x) => s + x.n, 0);
  const q = (k: string) => document.querySelector<HTMLElement>(`[data-k="${k}"]`);
  const isiTeks = (k: string, v: string) => {
    const el = q(k);
    if (el) el.textContent = v;
  };
  const tglPendek = (t: string) => {
    const p = t.split('-');
    return `${Number(p[2])} ${BLN[Number(p[1]) - 1]}`;
  };
  const blnPendek = (t: string) => BLN[Number(t.split('-')[1]) - 1];
  const waktuFmt = (w: string) => {
    const m = /^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})$/.exec(w || '');
    return m ? `${Number(m[3])} ${BLN[Number(m[2]) - 1]} ${m[1]}, ${m[4]}.${m[5]} WIB` : '';
  };
  const waktuPendek = (w: string) => {
    const m = /^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})/.exec(w || '');
    return m ? `${Number(m[3])} ${BLN[Number(m[2]) - 1]}, ${m[4]}.${m[5]}` : '-';
  };
  const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => '&#' + c.charCodeAt(0) + ';');
  const topeng = (ip: string) => {
    const s = String(ip || '');
    if (s.includes(':')) {
      const p = s.split(':');
      return `${p[0] || '0'}:${p[1] || '0'}:xxxx`;
    }
    const p = s.split('.');
    return p.length === 4 ? `${p[0]}.${p[1]}.xx.xx` : '-';
  };
  const kosongHtml = '<p class="text-sm text-muted">Belum ada data.</p>';
  const cincinKosong =
    '<div class="flex items-center gap-4"><svg viewBox="0 0 120 120" class="h-28 w-28 shrink-0" aria-hidden="true"><circle cx="60" cy="60" r="42" fill="none" stroke="#e2e8f0" stroke-width="16" /></svg><p class="text-sm text-muted">Belum ada data.</p></div>';

  let terakhir: any = null;
  let rentang = 14;
  let tampilTotal = 0;

  function hitungNaik(el: HTMLElement, ke: number) {
    const dari = tampilTotal;
    tampilTotal = ke;
    if (dari === ke || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = fmt(ke);
      return;
    }
    const t0 = performance.now();
    const langkah = (t: number) => {
      const p = Math.min(1, (t - t0) / 900);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(Math.round(dari + (ke - dari) * e));
      if (p < 1) requestAnimationFrame(langkah);
    };
    requestAnimationFrame(langkah);
  }

  function spark(nilai: number[], w: number, h: number, warnaGaris: string, area: boolean) {
    const n = nilai.length;
    if (n < 2) return '';
    const m = Math.max(1, ...nilai);
    const x = (i: number) => (i * w) / (n - 1);
    const y = (v: number) => h - 2 - (v / m) * (h - 4);
    const p = nilai.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
    return (
      (area ? `<path d="${p} L${w} ${h} L0 ${h} Z" fill="${warnaGaris}" fill-opacity="0.18" />` : '') +
      `<path d="${p}" fill="none" stroke="${warnaGaris}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />`
    );
  }

  function kisi(W: number, H: number, l: number, r: number, t: number, b: number, yMax: number) {
    let garis = '';
    let angka = '';
    for (let k = 0; k <= 4; k++) {
      const v = (yMax * k) / 4;
      const yy = t + (H - t - b) * (1 - v / yMax);
      garis += `<line x1="${l}" x2="${W - r}" y1="${yy}" y2="${yy}" stroke="currentColor" stroke-dasharray="${k ? '3 3' : '0'}" />`;
      angka += `<text x="${l - 6}" y="${yy + 4}" text-anchor="end" class="fill-slate-500 text-[11px]">${fmt(v)}</text>`;
    }
    return `<g class="text-slate-200">${garis}</g>${angka}`;
  }

  function gambarHarian(semua: Titik[]) {
    const el = q('grafik-harian');
    if (!el) return;
    const seri = semua.slice(-rentang);
    const n = seri.length;
    const W = Math.max(el.clientWidth, 240);
    const H = 200, l = 30, r = 10, t = 12, b = 24;
    const yMax = naik(Math.max(...seri.map((s) => s.n)));
    const x = (i: number) => l + (i * (W - l - r)) / (n - 1);
    const y = (v: number) => t + (H - t - b) * (1 - v / yMax);
    const garis = seri.map((s, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(s.n).toFixed(1)}`).join(' ');
    const area = `${garis} L${x(n - 1).toFixed(1)} ${H - b} L${x(0).toFixed(1)} ${H - b} Z`;
    const langkah = n <= 7 ? 1 : n <= 14 ? 3 : 7;
    const awal = `${n} hari terakhir`;
    let titik = '';
    let label = '';
    seri.forEach((s, i) => {
      if (n <= 14) {
        titik += `<circle cx="${x(i).toFixed(1)}" cy="${y(s.n).toFixed(1)}" r="3" fill="white" stroke="currentColor" stroke-width="1.5" />`;
      }
      if ((n - 1 - i) % langkah === 0) {
        label += `<text x="${x(i).toFixed(1)}" y="${H - 6}" text-anchor="${i === n - 1 ? 'end' : 'middle'}" class="fill-slate-500 text-[11px]">${tglPendek(s.t)}</text>`;
      }
    });
    el.innerHTML =
      `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="block text-sky-600" style="touch-action:pan-y" role="img" aria-label="Grafik kunjungan harian">` +
      `<defs><linearGradient id="gHarian" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="currentColor" stop-opacity="0.28" /><stop offset="1" stop-color="currentColor" stop-opacity="0" /></linearGradient></defs>` +
      kisi(W, H, l, r, t, b, yMax) +
      `<path d="${area}" fill="url(#gHarian)" />` +
      `<path d="${garis}" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />` +
      titik +
      label +
      `<g data-m visibility="hidden"><line y1="${t}" y2="${H - b}" stroke="currentColor" stroke-opacity="0.35" stroke-dasharray="3 3" /><circle r="5" fill="currentColor" stroke="white" stroke-width="2" /></g>` +
      `</svg>`;
    isiTeks('sub-harian', awal);

    const svg = el.querySelector('svg') as SVGSVGElement;
    const m = svg.querySelector('[data-m]') as SVGGElement;
    const ml = m.querySelector('line') as SVGLineElement;
    const mc = m.querySelector('circle') as SVGCircleElement;
    const geser = (e: PointerEvent) => {
      const bb = svg.getBoundingClientRect();
      let i = Math.round(((e.clientX - bb.left - l) / (W - l - r)) * (n - 1));
      i = Math.max(0, Math.min(n - 1, i));
      ml.setAttribute('x1', String(x(i)));
      ml.setAttribute('x2', String(x(i)));
      mc.setAttribute('cx', String(x(i)));
      mc.setAttribute('cy', String(y(seri[i].n)));
      m.setAttribute('visibility', 'visible');
      isiTeks('sub-harian', `${tglPendek(seri[i].t)}: ${fmt(seri[i].n)}`);
    };
    svg.addEventListener('pointermove', geser);
    svg.addEventListener('pointerdown', geser);
    svg.addEventListener('pointerleave', () => {
      m.setAttribute('visibility', 'hidden');
      isiTeks('sub-harian', awal);
    });
  }

  function gambarBulanan(seri: Titik[]) {
    const el = q('grafik-bulanan');
    if (!el) return;
    const W = Math.max(el.clientWidth, 240);
    const H = 190, l = 30, r = 10, t = 22, b = 24;
    const n = seri.length;
    const yMax = naik(Math.max(...seri.map((s) => s.n)));
    const slot = (W - l - r) / n;
    const bw = Math.min(36, slot * 0.55);
    let batang = '';
    seri.forEach((s, i) => {
      const cx = l + slot * (i + 0.5);
      const h = s.n > 0 ? Math.max(2, (H - t - b) * (s.n / yMax)) : 0;
      if (h > 0) {
        batang += `<rect x="${(cx - bw / 2).toFixed(1)}" y="${(H - b - h).toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="4" fill="currentColor" fill-opacity="${i === n - 1 ? 1 : 0.4}" />`;
        batang += `<text x="${cx.toFixed(1)}" y="${(H - b - h - 6).toFixed(1)}" text-anchor="middle" class="fill-slate-700 text-[11px] font-semibold">${fmt(s.n)}</text>`;
      }
      batang += `<text x="${cx.toFixed(1)}" y="${H - 6}" text-anchor="middle" class="fill-slate-500 text-[11px]">${blnPendek(s.t)}</text>`;
    });
    el.innerHTML =
      `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="block text-violet-600" role="img" aria-label="Grafik kunjungan bulanan">` +
      kisi(W, H, l, r, t, b, yMax) +
      batang +
      `</svg>`;
  }

  function gambarHeat(seri: Titik[]) {
    const el = q('heat');
    if (!el) return;
    const maks = Math.max(1, ...seri.map((s) => s.n));
    el.innerHTML = seri
      .map((s) => {
        const kelas = s.n > 0 ? 'bg-emerald-600' : 'bg-slate-100';
        const gaya = s.n > 0 ? `opacity:${(0.25 + (0.75 * s.n) / maks).toFixed(2)}` : '';
        return `<div class="aspect-square rounded ${kelas}" style="${gaya}" title="${tglPendek(s.t)}: ${fmt(s.n)}"></div>`;
      })
      .join('');
  }

  function donat(id: string, arr: Hitung[] | undefined) {
    const el = q(id);
    if (!el) return;
    const tot = arr ? arr.reduce((s, x) => s + x.n, 0) : 0;
    if (!arr || tot === 0) {
      el.innerHTML = cincinKosong;
      return;
    }
    const R = 42;
    const C = 2 * Math.PI * R;
    let pos = 0;
    let seg = '';
    let leg = '';
    arr.forEach((x, i) => {
      const f = x.n / tot;
      const len = Math.max(f * C - 1.5, 0.5);
      seg += `<circle data-i="${i}" cx="60" cy="60" r="${R}" fill="none" stroke="${warna(i)}" stroke-width="16" stroke-dasharray="${len.toFixed(2)} ${(C - len).toFixed(2)}" stroke-dashoffset="${(-pos * C).toFixed(2)}" transform="rotate(-90 60 60)" style="cursor:pointer" />`;
      pos += f;
      leg += `<li class="flex items-center justify-between gap-3"><span class="flex min-w-0 items-center gap-2"><span class="h-2.5 w-2.5 shrink-0 rounded-sm" style="background:${warna(i)}"></span><span class="truncate text-muted">${esc(x.k)}</span></span><span class="font-semibold tabular-nums text-heading">${Math.round(f * 100)}%</span></li>`;
    });
    el.innerHTML =
      `<div class="flex items-center gap-4"><svg viewBox="0 0 120 120" class="h-28 w-28 shrink-0" role="img" aria-label="Diagram lingkaran"><circle cx="60" cy="60" r="${R}" fill="none" stroke="#f1f5f9" stroke-width="16" />${seg}<text data-c1 x="60" y="62" text-anchor="middle" class="fill-slate-800 text-[18px] font-bold">${fmt(tot)}</text><text data-c2 x="60" y="77" text-anchor="middle" class="fill-slate-500 text-[10px]">kunjungan</text></svg>` +
      `<ul class="min-w-0 flex-1 space-y-2 text-sm">${leg}</ul></div>`;
    const c1 = el.querySelector('[data-c1]') as SVGTextElement;
    const c2 = el.querySelector('[data-c2]') as SVGTextElement;
    const reset = () => {
      c1.textContent = fmt(tot);
      c2.textContent = 'kunjungan';
    };
    el.querySelectorAll<SVGCircleElement>('circle[data-i]').forEach((c) => {
      const tampil = () => {
        const x = arr[Number(c.dataset.i)];
        c1.textContent = `${Math.round((x.n / tot) * 100)}%`;
        c2.textContent = x.k.length > 12 ? x.k.slice(0, 11) + '.' : x.k;
      };
      c.addEventListener('pointerenter', tampil);
      c.addEventListener('pointerdown', tampil);
      c.addEventListener('pointerleave', reset);
    });
  }

  function daftar(id: string, arr: Hitung[] | undefined, w: string) {
    const el = q(id);
    if (!el) return;
    const tot = arr ? arr.reduce((s, x) => s + x.n, 0) : 0;
    if (!arr || tot === 0) {
      el.innerHTML = kosongHtml;
      return;
    }
    const maks = Math.max(...arr.map((x) => x.n));
    el.innerHTML =
      '<ul class="space-y-3 text-sm">' +
      arr
        .map(
          (x) =>
            `<li><div class="flex items-center justify-between gap-3"><span class="truncate text-muted">${esc(x.k)}</span><span class="font-semibold tabular-nums text-heading">${fmt(x.n)}</span></div><div class="mt-1.5 h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full" style="width:${Math.max(4, Math.round((x.n / maks) * 100))}%;background:${w}"></div></div></li>`
        )
        .join('') +
      '</ul>';
  }

  function tampil(k: string, ada: boolean) {
    const el = q(k);
    if (el) el.classList.toggle('hidden', !ada);
  }

  function pengunjungBaru(arr: any) {
    const ada = Array.isArray(arr) && arr.length > 0;
    tampil('w-baru', ada);
    const tb = q('t-baru');
    if (!tb || !ada) return;
    tb.innerHTML = arr
      .slice(0, 10)
      .map(
        (v: any) =>
          `<tr class="border-b border-slate-50"><td class="whitespace-nowrap px-4 py-2 text-muted">${esc(waktuPendek(v.w))}</td><td class="px-2 py-2 tabular-nums text-muted">${esc(topeng(v.ip))}</td><td class="px-2 py-2 text-heading">${esc(v.hp || v.dev || '-')}</td><td class="px-2 py-2">${v.prov ? `<span class="rounded-full bg-sky-50 px-2 py-0.5 font-medium text-sky-800">${esc(v.prov)}</span>` : '-'}</td><td class="px-4 py-2 text-muted">${esc(v.pg || '/')}</td></tr>`
      )
      .join('');
  }

  function pesanGrafik(teks: string) {
    ['grafik-harian', 'grafik-bulanan', 'heat', 'l-neg', 'l-src', 'l-pg'].forEach((k) => {
      const el = q(k);
      if (el) el.innerHTML = `<p class="col-span-10 text-sm text-muted">${teks}</p>`;
    });
    ['d-dev', 'd-br', 'd-jn'].forEach((k) => {
      const el = q(k);
      if (el) el.innerHTML = cincinKosong;
    });
  }

  function chip(k: string, kini: number, lalu: number, gelap: boolean) {
    const el = q(k);
    if (!el) return;
    if (lalu > 0) {
      const p = Math.round(((kini - lalu) / lalu) * 100);
      const w = gelap
        ? p > 0
          ? 'bg-white/15 text-emerald-200'
          : p < 0
            ? 'bg-white/15 text-rose-200'
            : 'bg-white/15 text-slate-200'
        : p > 0
          ? 'bg-emerald-50 text-emerald-700'
          : p < 0
            ? 'bg-rose-50 text-rose-700'
            : 'bg-slate-100 text-slate-600';
      el.className = `rounded px-1.5 py-0.5 text-xs font-semibold ${w}`;
      el.textContent = p > 0 ? `naik ${p}%` : p < 0 ? `turun ${Math.abs(p)}%` : 'tetap';
    } else {
      el.className = 'hidden';
      el.textContent = '';
    }
  }

  function tandai() {
    document.querySelectorAll<HTMLElement>('[data-r]').forEach((b) => {
      const aktif = Number(b.dataset.r) === rentang;
      b.className = 'rounded-md px-2.5 py-1 transition ' + (aktif ? 'bg-primary text-white' : 'text-muted hover:text-heading');
      b.setAttribute('aria-pressed', String(aktif));
    });
  }

  function gambarSpark(h: Titik[]) {
    const nilai = h.map((s) => s.n);
    const taruh = (k: string, isi: string) => {
      const el = q(k);
      if (el) el.innerHTML = isi;
    };
    taruh('sp-total', spark(nilai, 300, 56, '#85B7EB', true));
    taruh('sp-hari', spark(nilai.slice(-10), 60, 26, '#2a78d6', false));
    taruh('sp-bulan', spark(nilai.slice(-20), 60, 26, '#6250d6', false));
    taruh('sp-rata', spark(nilai, 60, 26, '#1baf7a', false));
    taruh('sp-puncak', spark(nilai.slice(-14), 60, 26, '#eb6834', false));
  }

  function render(d: any) {
    terakhir = d;
    tandai();
    const angka = (v: unknown) => (typeof v === 'number' ? fmt(v) : '-');
    const elTotal = q('total');
    if (elTotal) {
      if (d && typeof d.total === 'number') hitungNaik(elTotal, d.total);
      else elTotal.textContent = '-';
    }
    isiTeks('hari', angka(d && d.hari));
    isiTeks('bulan', angka(d && d.bulan));

    const ada = d && Array.isArray(d.harian) && d.harian.length >= 14 && Array.isArray(d.bulanan);
    if (!ada) {
      ['rata', 'puncak', 's-rata', 's-hari', 's-bulan', 's-puncak', 's-total', 'r-total', 'r-puncak', 'r-minggu', 'r-aktif'].forEach((k) =>
        isiTeks(k, k.startsWith('r-') || k === 'rata' || k === 'puncak' ? '-' : '')
      );
      chip('d-minggu', 0, 0, true);
      chip('d-minggu2', 0, 0, false);
      pesanGrafik('Data grafik tidak tersedia.');
      isiTeks('sumber', d ? 'Data grafik belum tersedia dari sumber.' : 'Data tidak dapat dimuat. Muat ulang halaman untuk mencoba lagi.');
      return;
    }

    const h: Titik[] = d.harian;
    const jumlah = jml(h);
    const puncak = h.reduce((a, s) => (s.n > a.n ? s : a), h[0]);
    const minggu = jml(h.slice(-7));
    const mingguLalu = jml(h.slice(-14, -7));
    isiTeks('rata', (jumlah / h.length).toLocaleString('id-ID', { maximumFractionDigits: 1 }));
    isiTeks('s-rata', `${h.length} hari terakhir`);
    isiTeks('puncak', puncak.n > 0 ? fmt(puncak.n) : '-');
    isiTeks('s-puncak', puncak.n > 0 ? tglPendek(puncak.t) : '');
    isiTeks('s-hari', typeof d.kemarin === 'number' ? `Kemarin ${fmt(d.kemarin)}` : '');
    isiTeks('s-bulan', typeof d.bulanLalu === 'number' ? `Bulan lalu ${fmt(d.bulanLalu)}` : '');
    isiTeks('s-total', mingguLalu > 0 ? '7 hari terakhir dibanding 7 hari sebelumnya' : '');
    isiTeks('r-total', fmt(jumlah));
    isiTeks('r-puncak', puncak.n > 0 ? `${tglPendek(puncak.t)} (${fmt(puncak.n)})` : '-');
    isiTeks('r-minggu', fmt(minggu));
    chip('d-minggu', minggu, mingguLalu, true);
    chip('d-minggu2', minggu, mingguLalu, false);
    isiTeks('r-aktif', `${h.filter((s) => s.n > 0).length} dari ${h.length}`);
    const w = waktuFmt(d.waktu);
    isiTeks('sumber', `Sumber: penghitung kunjungan situs, satu hitungan per perangkat per hari.${w ? ' Diperbarui ' + w + '.' : ''}`);

    gambarSpark(h);
    gambarHarian(h);
    gambarBulanan(d.bulanan);
    gambarHeat(h);
    const dm = d.dim || {};
    donat('d-dev', dm.dev);
    donat('d-br', dm.br);
    donat('d-jn', dm.jn);
    daftar('l-neg', dm.neg, '#1baf7a');
    daftar('l-src', dm.src, '#e87ba4');
    daftar('l-pg', dm.pg, '#2a78d6');

    const adaModel = Array.isArray(dm.model) && dm.model.length > 0;
    const adaProv = Array.isArray(dm.prov) && dm.prov.length > 0;
    const adaOs = Array.isArray(dm.os) && dm.os.length > 0;
    tampil('w-model', adaModel);
    tampil('w-prov', adaProv);
    tampil('w-os', adaOs);
    tampil('g-baru', adaModel || adaProv || adaOs);
    if (adaModel) daftar('l-model', dm.model, '#6250d6');
    if (adaProv) daftar('l-prov', dm.prov, '#eb6834');
    if (adaOs) donat('d-os', dm.os);
    pengunjungBaru(d.terbaru);
  }

  document.addEventListener('statistik:data', (e) => render((e as CustomEvent).detail));
  document.addEventListener('astro:page-load', () => {
    const w = window as any;
    if (w.__statistik !== undefined) render(w.__statistik);
    else tandai();
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-r]') as HTMLElement | null;
    if (!b) return;
    rentang = Number(b.dataset.r);
    tandai();
    if (terakhir && Array.isArray(terakhir.harian)) gambarHarian(terakhir.harian);
  });

  let tunda = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(tunda);
    tunda = window.setTimeout(() => {
      if (terakhir) render(terakhir);
    }, 150);
  });

  const awalData = (window as any).__statistik;
  if (awalData !== undefined) render(awalData);
  else tandai();
</script>
