---
import { Icon } from 'astro-icon/components';
import { wrap } from '~/data/profil';

const { judul: judulHalaman = '' } = Astro.props;

const card = 'sp-in rounded-xl border border-slate-200 bg-white shadow-sm';
const kepala = 'flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3';
const judul = 'flex items-center gap-2 text-sm font-semibold text-heading';
const ikonJudul = 'h-4 w-4 text-primary';
const tile = 'sp-in rounded-xl p-4';
const bulat = 'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white';
---

<div class={judulHalaman ? 'bg-white' : 'bg-slate-50'}>
  <section class={`${wrap} pb-14 sm:pb-16 ${judulHalaman ? 'pt-10 sm:pt-12' : 'pt-6 sm:pt-8'}`}>
    {judulHalaman && <h2 class="mb-4 text-xl font-bold text-heading">{judulHalaman}</h2>}
    <p class="mb-3 hidden rounded-lg bg-sky-50 px-3 py-2 text-xs text-sky-900" data-k="demo">Mode contoh: semua angka dan nama di halaman ini hanya contoh, bukan data nyata.</p>

    <div class="sp-in overflow-hidden rounded-2xl bg-primary p-5 text-white sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-medium text-slate-300">Total kunjungan</p>
          <p class="mt-1 text-4xl font-bold leading-none tabular-nums sm:text-5xl" data-k="total">-</p>
          <p class="mt-2 text-xs text-slate-300" data-k="s-total"></p>
        </div>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15">
          <Icon name="tabler:eye" class="h-5 w-5" />
        </span>
      </div>

      <div class="mt-5 grid grid-cols-3 divide-x divide-white/10 rounded-xl bg-white/5 py-3 text-center">
        <div class="px-2">
          <p class="text-[11px] text-slate-300">Hari ini</p>
          <p class="mt-1 text-xl font-bold tabular-nums" data-k="hari">-</p>
          <p class="mt-0.5 min-h-4 text-[11px] text-slate-400" data-k="s-hari"></p>
        </div>
        <div class="px-2">
          <p class="text-[11px] text-slate-300">Bulan ini</p>
          <p class="mt-1 text-xl font-bold tabular-nums" data-k="bulan">-</p>
          <p class="mt-0.5 min-h-4 text-[11px] text-slate-400" data-k="s-bulan"></p>
        </div>
        <div class="px-2">
          <p class="text-[11px] text-slate-300">7 hari terakhir</p>
          <p class="mt-1 text-xl font-bold tabular-nums" data-k="r-minggu">-</p>
          <p class="mt-0.5 flex min-h-4 justify-center"><span class="hidden" data-k="d-minggu"></span></p>
        </div>
      </div>

      <div class="mt-5 flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="flex items-center gap-2 text-sm font-semibold"><Icon name="tabler:chart-area-line" class="h-4 w-4 text-sky-300" />Kunjungan harian</p>
          <p class="mt-0.5 truncate text-xs text-slate-300" data-k="sub-harian">14 hari terakhir</p>
        </div>
        <div class="flex shrink-0 rounded-lg bg-white/10 p-0.5 text-xs font-semibold">
          <button type="button" data-r="7">7</button>
          <button type="button" data-r="14">14</button>
          <button type="button" data-r="30">30</button>
        </div>
      </div>
      <div class="mt-3 min-h-[190px] w-full" data-k="grafik-harian"></div>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-4">
      <div class={`${tile} bg-emerald-50 text-emerald-900`}>
        <span class={`${bulat} bg-emerald-600`}><Icon name="tabler:chart-line" class="h-5 w-5" /></span>
        <p class="mt-3 text-xs font-medium">Rata-rata harian</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="rata">-</p>
        <p class="mt-2 min-h-4 text-xs" data-k="s-rata"></p>
      </div>
      <div class={`${tile} bg-orange-50 text-orange-900`}>
        <span class={`${bulat} bg-orange-600`}><Icon name="tabler:trophy" class="h-5 w-5" /></span>
        <p class="mt-3 text-xs font-medium">Hari tersibuk</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="puncak">-</p>
        <p class="mt-2 min-h-4 text-xs" data-k="s-puncak"></p>
      </div>
      <div class={`${tile} bg-violet-50 text-violet-900`}>
        <span class={`${bulat} bg-violet-600`}><Icon name="tabler:calendar-stats" class="h-5 w-5" /></span>
        <p class="mt-3 text-xs font-medium">Hari dengan kunjungan</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="r-aktif">-</p>
        <p class="mt-2 min-h-4 text-xs" data-k="s-aktif"></p>
      </div>
      <div class={`${tile} bg-sky-50 text-sky-900`}>
        <span class={`${bulat} bg-sky-600`}><Icon name="tabler:users" class="h-5 w-5" /></span>
        <p class="mt-3 text-xs font-medium">Pengunjung kembali</p>
        <p class="mt-1 text-2xl font-bold leading-none tabular-nums" data-k="kembali">-</p>
        <p class="mt-2 min-h-4 text-xs" data-k="s-kembali"></p>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={`${card} lg:col-span-2`}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:chart-bar" class={ikonJudul} />Kunjungan bulanan</h3>
          <p class="text-xs text-muted">6 bulan terakhir</p>
        </div>
        <div class="p-4">
          <div class="min-h-[190px] w-full" data-k="grafik-bulanan"></div>
        </div>
      </div>
      <div class={card}>
        <div class={kepala}>
          <h3 class={judul}><Icon name="tabler:calendar-stats" class={ikonJudul} />Aktivitas 30 hari</h3>
        </div>
        <p class="px-4 pt-3 text-xs text-muted">Satu kotak satu hari. Makin gelap, makin banyak kunjungan.</p>
        <div class="grid grid-cols-10 gap-1.5 p-4 pt-2" data-k="heat"></div>
      </div>
    </div>

    <div class={`${card} mt-3 sm:mt-4`}>
      <div class={kepala}>
        <h3 class={judul}><Icon name="tabler:clock" class={ikonJudul} />Jam dan hari tersibuk</h3>
        <p class="text-xs text-muted" data-k="jam-puncak"></p>
      </div>
      <div class="p-4">
        <p class="mb-3 text-xs text-muted">Kapan pengunjung paling sering datang, dalam WIB.</p>
        <div data-k="jam"></div>
        <div class="mt-3 flex items-center justify-end gap-1.5 text-[11px] text-muted">
          <span>Sepi</span>
          <span class="h-3 w-3 rounded-[3px] bg-slate-100"></span>
          <span class="h-3 w-3 rounded-[3px] bg-violet-600 opacity-25"></span>
          <span class="h-3 w-3 rounded-[3px] bg-violet-600 opacity-50"></span>
          <span class="h-3 w-3 rounded-[3px] bg-violet-600 opacity-75"></span>
          <span class="h-3 w-3 rounded-[3px] bg-violet-600"></span>
          <span>Ramai</span>
        </div>
      </div>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-5">
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:device-mobile" class={ikonJudul} />Perangkat</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Jenis perangkat yang dipakai pengunjung.</p>
        <div class="p-4 pt-2" data-k="d-dev"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:browser" class={ikonJudul} />Browser</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Aplikasi yang dipakai untuk membuka situs.</p>
        <div class="p-4 pt-2" data-k="d-br"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:cpu" class={ikonJudul} />Sistem operasi</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Sistem di perangkat pengunjung.</p>
        <div class="p-4 pt-2" data-k="d-os"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:users" class={ikonJudul} />Pengunjung</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Kembali berarti browser itu pernah berkunjung sebelumnya.</p>
        <div class="p-4 pt-2" data-k="d-jn"></div>
      </div>
      <div class={`${card} col-span-2 lg:col-span-1`}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:wifi" class={ikonJudul} />Koneksi</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Jenis dan kecepatan koneksi yang dilaporkan browser. Tidak semua browser mengirimnya.</p>
        <div class="p-4 pt-2" data-k="d-kn"></div>
      </div>
    </div>

    <div class="mt-3 grid gap-3 sm:mt-4 sm:gap-4 lg:grid-cols-3">
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:map-pin" class={ikonJudul} />Provinsi asal</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Perkiraan dari alamat IP. Pengguna kartu seluler kadang tercatat di provinsi lain.</p>
        <div class="p-4 pt-2" data-k="l-prov"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:map-pin" class={ikonJudul} />Kota</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Perkiraan kota dari alamat IP.</p>
        <div class="p-4 pt-2" data-k="l-kota"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:network" class={ikonJudul} />Penyedia internet</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Penyedia layanan internet (ISP) pengunjung, dibaca dari alamat IP.</p>
        <div class="p-4 pt-2" data-k="l-isp"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:device-mobile" class={ikonJudul} />Model HP</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Tipe HP yang terbaca dari browser. Sebagian hanya terbaca sebagai merek.</p>
        <div class="p-4 pt-2" data-k="l-model"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:language" class={ikonJudul} />Bahasa browser</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Bahasa yang diatur di browser pengunjung.</p>
        <div class="p-4 pt-2" data-k="l-bhs"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:device-desktop" class={ikonJudul} />Ukuran layar</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Ukuran layar perangkat pengunjung, dalam piksel.</p>
        <div class="p-4 pt-2" data-k="l-lyr"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:world" class={ikonJudul} />Negara</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Perkiraan negara dari alamat IP.</p>
        <div class="p-4 pt-2" data-k="l-neg"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:link" class={ikonJudul} />Sumber kunjungan</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Dari mana pengunjung datang: langsung, media sosial, atau situs lain.</p>
        <div class="p-4 pt-2" data-k="l-src"></div>
      </div>
      <div class={card}>
        <div class={kepala}><h3 class={judul}><Icon name="tabler:file-text" class={ikonJudul} />Halaman masuk</h3></div>
        <p class="px-4 pt-3 text-xs text-muted">Halaman pertama yang dibuka pengunjung saat tiba di situs.</p>
        <div class="p-4 pt-2" data-k="l-pg"></div>
      </div>
    </div>

    <div class={`${card} mt-3 sm:mt-4`}>
      <div class={kepala}>
        <h3 class={judul}><Icon name="tabler:users" class={ikonJudul} />Pengunjung terbaru</h3>
        <p class="text-xs text-muted">IP disamarkan</p>
      </div>
      <p class="px-4 pt-3 text-xs text-muted">Kunjungan terakhir yang tercatat, satu per perangkat per hari.</p>
      <div data-k="t-baru"></div>
    </div>

    <p class="mt-4 text-xs text-muted empty:hidden" data-k="sumber"></p>
  </section>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .sp-in {
      animation: sp-naik 0.5s ease-out both;
    }
    @keyframes sp-naik {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  type Titik = { t: string; n: number };
  type Hitung = { k: string; n: number };

  const BLN = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const HARI = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'];
  const HARI_PENUH = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];
  const PALET = ['#2a78d6', '#6250d6', '#1baf7a', '#eb6834', '#e87ba4', '#0B2545'];
  const warna = (i: number) => PALET[i] || '#94a3b8';
  const MODEL_NAMA: Record<string, string> = {
    'Samsung SM-A155F': 'Samsung Galaxy A15',
    'Samsung SM-A156B': 'Samsung Galaxy A15 5G',
    'Samsung SM-A055F': 'Samsung Galaxy A05',
    'Samsung SM-A057F': 'Samsung Galaxy A05s',
    'Samsung SM-A145F': 'Samsung Galaxy A14',
    'Samsung SM-A135F': 'Samsung Galaxy A13',
    'Samsung SM-A045F': 'Samsung Galaxy A04',
    'Samsung SM-A047F': 'Samsung Galaxy A04s',
    'Samsung SM-A245F': 'Samsung Galaxy A24',
    'Samsung SM-A346E': 'Samsung Galaxy A34 5G',
    'Samsung SM-A546E': 'Samsung Galaxy A54 5G',
    'Samsung SM-A125F': 'Samsung Galaxy A12',
    'Samsung SM-A325F': 'Samsung Galaxy A32',
  };
  const namaHp = (s: string) => MODEL_NAMA[s] || s;
  const HALAMAN: Record<string, string> = {
    '/': 'Beranda',
    '/proyek': 'Portofolio',
    '/layanan': 'Layanan',
    '/produk': 'Produk',
    '/perjalanan': 'Tentang saya',
    '/kontak': 'Media Sosial',
    '/aplikasi': 'Aplikasi',
    '/saham': 'Saham Lokal',
    '/statistik': 'Statistik',
  };
  const BAHASA: Record<string, string> = { id: 'Indonesia', en: 'Inggris', ms: 'Melayu', jv: 'Jawa', su: 'Sunda', ar: 'Arab', zh: 'Mandarin', ja: 'Jepang', ko: 'Korea', es: 'Spanyol', fr: 'Prancis', de: 'Jerman', ru: 'Rusia', hi: 'Hindi' };
  const namaBahasa = (s: string) => (BAHASA[s.slice(0, 2).toLowerCase()] ? `${BAHASA[s.slice(0, 2).toLowerCase()]} (${s})` : s);
  const namaLayar = (s: string) => s.replace('x', ' x ');
  const namaHalaman = (s: string) => {
    const p = s.length > 1 ? s.replace(/\/+$/, '') : s;
    return HALAMAN[p] || s;
  };
  const fmt = (n: number) => n.toLocaleString('id-ID');
  const naik = (m: number) => Math.max(4, Math.ceil(m / 4) * 4);
  const jml = (a: Titik[]) => a.reduce((s, x) => s + x.n, 0);
  const q = (k: string) => document.querySelector<HTMLElement>(`[data-k="${k}"]`);
  const isiTeks = (k: string, v: string) => {
    const el = q(k);
    if (el) el.textContent = v;
  };
  const tglPendek = (t: string) => {
    const p = t.split('-');
    return `${Number(p[2])} ${BLN[Number(p[1]) - 1]}`;
  };
  const blnPendek = (t: string) => BLN[Number(t.split('-')[1]) - 1];
  const waktuPendek = (w: string) => {
    const m = /^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2})/.exec(w || '');
    return m ? `${Number(m[3])} ${BLN[Number(m[2]) - 1]}, ${m[4]}.${m[5]}` : '-';
  };
  const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => '&#' + c.charCodeAt(0) + ';');
  const topeng = (ip: string) => {
    const s = String(ip || '');
    if (!s) return '-';
    if (s.includes(':')) {
      const p = s.split(':');
      return `${p[0] || '0'}:${p[1] || '0'}:xxxx`;
    }
    const p = s.split('.');
    return p.length === 4 ? `${p[0]}.${p[1]}.xx.xx` : '-';
  };
  const kosongDaftar =
    '<div class="space-y-3" aria-hidden="true">' +
    [72, 48, 28].map((w) => `<div class="h-2 rounded-full bg-slate-100" style="width:${w}%"></div>`).join('') +
    '</div><p class="mt-3 text-sm text-muted">Belum ada data.</p>';
  const cincinKosong =
    '<div class="flex flex-col items-center gap-3"><svg viewBox="0 0 120 120" class="h-28 w-28" aria-hidden="true"><circle cx="60" cy="60" r="42" fill="none" stroke="#e2e8f0" stroke-width="16" /></svg><p class="text-sm text-muted">Belum ada data.</p></div>';

  let terakhir: any = null;
  let rentang = 14;
  let tampilTotal = 0;
  const demoAktif = () => new URLSearchParams(location.search).has('demo');

  function hitungNaik(el: HTMLElement, ke: number) {
    const dari = tampilTotal;
    tampilTotal = ke;
    if (dari === ke || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = fmt(ke);
      return;
    }
    const t0 = performance.now();
    const langkah = (t: number) => {
      const p = Math.min(1, (t - t0) / 900);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(Math.round(dari + (ke - dari) * e));
      if (p < 1) requestAnimationFrame(langkah);
    };
    requestAnimationFrame(langkah);
  }

  function kisi(W: number, H: number, l: number, r: number, t: number, b: number, yMax: number, gelap: boolean) {
    let garis = '';
    let angka = '';
    for (let k = 0; k <= 4; k++) {
      const v = (yMax * k) / 4;
      const yy = t + (H - t - b) * (1 - v / yMax);
      garis += `<line x1="${l}" x2="${W - r}" y1="${yy}" y2="${yy}" stroke="currentColor" stroke-dasharray="${k ? '3 3' : '0'}" />`;
      angka += `<text x="${l - 6}" y="${yy + 4}" text-anchor="end" class="${gelap ? 'fill-slate-400' : 'fill-slate-500'} text-[11px]">${fmt(v)}</text>`;
    }
    return `<g class="${gelap ? 'text-white/15' : 'text-slate-200'}">${garis}</g>${angka}`;
  }

  function gambarHarian(semua: Titik[]) {
    const el = q('grafik-harian');
    if (!el) return;
    const seri = semua.slice(-rentang);
    const n = seri.length;
    const W = Math.max(el.clientWidth, 240);
    const H = 190, l = 30, r = 8, t = 10, b = 24;
    const yMax = naik(Math.max(...seri.map((s) => s.n)));
    const x = (i: number) => l + (i * (W - l - r)) / (n - 1);
    const y = (v: number) => t + (H - t - b) * (1 - v / yMax);
    const garis = seri.map((s, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(s.n).toFixed(1)}`).join(' ');
    const area = `${garis} L${x(n - 1).toFixed(1)} ${H - b} L${x(0).toFixed(1)} ${H - b} Z`;
    const langkah = n <= 7 ? 1 : n <= 14 ? 3 : 7;
    const awal = `${n} hari terakhir`;
    let titik = '';
    let label = '';
    seri.forEach((s, i) => {
      if (n <= 14) {
        titik += `<circle cx="${x(i).toFixed(1)}" cy="${y(s.n).toFixed(1)}" r="3" fill="#0B2545" stroke="currentColor" stroke-width="1.8" />`;
      }
      if ((n - 1 - i) % langkah === 0) {
        label += `<text x="${x(i).toFixed(1)}" y="${H - 6}" text-anchor="${i === n - 1 ? 'end' : 'middle'}" class="fill-slate-400 text-[11px]">${tglPendek(s.t)}</text>`;
      }
    });
    el.innerHTML =
      `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="block text-sky-300" style="touch-action:pan-y" role="img" aria-label="Grafik kunjungan harian">` +
      `<defs><linearGradient id="gHarian" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="currentColor" stop-opacity="0.35" /><stop offset="1" stop-color="currentColor" stop-opacity="0" /></linearGradient></defs>` +
      kisi(W, H, l, r, t, b, yMax, true) +
      `<path d="${area}" fill="url(#gHarian)" />` +
      `<path d="${garis}" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />` +
      titik +
      label +
      `<g data-m visibility="hidden"><line y1="${t}" y2="${H - b}" stroke="white" stroke-opacity="0.35" stroke-dasharray="3 3" /><circle r="5" fill="white" stroke="currentColor" stroke-width="2.5" /></g>` +
      `</svg>`;
    isiTeks('sub-harian', awal);

    const svg = el.querySelector('svg') as SVGSVGElement;
    const m = svg.querySelector('[data-m]') as SVGGElement;
    const ml = m.querySelector('line') as SVGLineElement;
    const mc = m.querySelector('circle') as SVGCircleElement;
    const geser = (e: PointerEvent) => {
      const bb = svg.getBoundingClientRect();
      let i = Math.round(((e.clientX - bb.left - l) / (W - l - r)) * (n - 1));
      i = Math.max(0, Math.min(n - 1, i));
      ml.setAttribute('x1', String(x(i)));
      ml.setAttribute('x2', String(x(i)));
      mc.setAttribute('cx', String(x(i)));
      mc.setAttribute('cy', String(y(seri[i].n)));
      m.setAttribute('visibility', 'visible');
      isiTeks('sub-harian', `${tglPendek(seri[i].t)}: ${fmt(seri[i].n)} kunjungan`);
    };
    svg.addEventListener('pointermove', geser);
    svg.addEventListener('pointerdown', geser);
    svg.addEventListener('pointerleave', () => {
      m.setAttribute('visibility', 'hidden');
      isiTeks('sub-harian', awal);
    });
  }

  function gambarBulanan(seri: Titik[]) {
    const el = q('grafik-bulanan');
    if (!el) return;
    const W = Math.max(el.clientWidth, 240);
    const H = 190, l = 30, r = 10, t = 22, b = 24;
    const n = seri.length;
    const yMax = naik(Math.max(...seri.map((s) => s.n)));
    const slot = (W - l - r) / n;
    const bw = Math.min(36, slot * 0.55);
    let batang = '';
    seri.forEach((s, i) => {
      const cx = l + slot * (i + 0.5);
      const h = s.n > 0 ? Math.max(2, (H - t - b) * (s.n / yMax)) : 0;
      if (h > 0) {
        batang += `<rect x="${(cx - bw / 2).toFixed(1)}" y="${(H - b - h).toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="4" fill="currentColor" fill-opacity="${i === n - 1 ? 1 : 0.4}" />`;
        batang += `<text x="${cx.toFixed(1)}" y="${(H - b - h - 6).toFixed(1)}" text-anchor="middle" class="fill-slate-700 text-[11px] font-semibold">${fmt(s.n)}</text>`;
      }
      batang += `<text x="${cx.toFixed(1)}" y="${H - 6}" text-anchor="middle" class="fill-slate-500 text-[11px]">${blnPendek(s.t)}</text>`;
    });
    el.innerHTML =
      `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" class="block text-violet-600" role="img" aria-label="Grafik kunjungan bulanan">` +
      kisi(W, H, l, r, t, b, yMax, false) +
      batang +
      `</svg>`;
  }

  function gambarHeat(seri: Titik[]) {
    const el = q('heat');
    if (!el) return;
    const maks = Math.max(1, ...seri.map((s) => s.n));
    el.innerHTML = seri
      .map((s) => {
        const kelas = s.n > 0 ? 'bg-emerald-600' : 'bg-slate-100';
        const gaya = s.n > 0 ? `opacity:${(0.25 + (0.75 * s.n) / maks).toFixed(2)}` : '';
        return `<div class="aspect-square rounded ${kelas}" style="${gaya}" title="${tglPendek(s.t)}: ${fmt(s.n)}"></div>`;
      })
      .join('');
  }

  function gambarJam(heat: any) {
    const el = q('jam');
    if (!el) return;
    const ok = Array.isArray(heat) && heat.length === 168;
    const maks = ok ? Math.max(...(heat as number[])) : 0;
    let html = '<div class="grid gap-[3px]" style="grid-template-columns:28px repeat(24,minmax(0,1fr))"><div></div>';
    for (let j = 0; j < 24; j++) html += `<div class="text-center text-[10px] text-slate-400">${j % 6 === 0 ? j : ''}</div>`;
    let pI = -1;
    for (let r = 0; r < 7; r++) {
      html += `<div class="flex items-center text-[10px] text-slate-500">${HARI[r]}</div>`;
      for (let j = 0; j < 24; j++) {
        const n = ok ? heat[r * 24 + j] : 0;
        if (n > 0 && (pI < 0 || n > heat[pI])) pI = r * 24 + j;
        const gaya = n > 0 ? `background:#6250d6;opacity:${(0.2 + (0.8 * n) / maks).toFixed(2)}` : '';
        html += `<div class="aspect-square rounded-[3px] ${n > 0 ? '' : 'bg-slate-100'}" style="${gaya}" title="${HARI_PENUH[r]} ${j}.00: ${fmt(n)}"></div>`;
      }
    }
    el.innerHTML = html + '</div>';
    isiTeks('jam-puncak', pI >= 0 ? `Paling ramai: ${HARI_PENUH[Math.floor(pI / 24)]}, ${pI % 24}.00` : 'Belum ada data');
  }

  function donat(id: string, arr: Hitung[] | undefined) {
    const el = q(id);
    if (!el) return;
    const tot = arr ? arr.reduce((s, x) => s + x.n, 0) : 0;
    if (!arr || tot === 0) {
      el.innerHTML = cincinKosong;
      return;
    }
    const R = 42;
    const C = 2 * Math.PI * R;
    let pos = 0;
    let seg = '';
    let leg = '';
    arr.forEach((x, i) => {
      const f = x.n / tot;
      const len = Math.max(f * C - 1.5, 0.5);
      seg += `<circle data-i="${i}" cx="60" cy="60" r="${R}" fill="none" stroke="${warna(i)}" stroke-width="16" stroke-dasharray="${len.toFixed(2)} ${(C - len).toFixed(2)}" stroke-dashoffset="${(-pos * C).toFixed(2)}" transform="rotate(-90 60 60)" style="cursor:pointer" />`;
      pos += f;
      leg += `<li class="flex items-center justify-between gap-2"><span class="flex min-w-0 items-center gap-1.5"><span class="h-2.5 w-2.5 shrink-0 rounded-sm" style="background:${warna(i)}"></span><span class="truncate text-muted">${esc(x.k)}</span></span><span class="font-semibold tabular-nums text-heading">${Math.round(f * 100)}%</span></li>`;
    });
    el.innerHTML =
      `<div class="flex flex-col items-center gap-3"><svg viewBox="0 0 120 120" class="h-28 w-28" role="img" aria-label="Diagram lingkaran"><circle cx="60" cy="60" r="${R}" fill="none" stroke="#f1f5f9" stroke-width="16" />${seg}<text data-c1 x="60" y="62" text-anchor="middle" class="fill-slate-800 text-[18px] font-bold">${fmt(tot)}</text><text data-c2 x="60" y="77" text-anchor="middle" class="fill-slate-500 text-[10px]">kunjungan</text></svg>` +
      `<ul class="w-full space-y-1.5 text-xs">${leg}</ul></div>`;
    const c1 = el.querySelector('[data-c1]') as SVGTextElement;
    const c2 = el.querySelector('[data-c2]') as SVGTextElement;
    const reset = () => {
      c1.textContent = fmt(tot);
      c2.textContent = 'kunjungan';
    };
    el.querySelectorAll<SVGCircleElement>('circle[data-i]').forEach((c) => {
      const tampil = () => {
        const x = arr[Number(c.dataset.i)];
        c1.textContent = `${Math.round((x.n / tot) * 100)}%`;
        c2.textContent = x.k.length > 12 ? x.k.slice(0, 11) + '.' : x.k;
      };
      c.addEventListener('pointerenter', tampil);
      c.addEventListener('pointerdown', tampil);
      c.addEventListener('pointerleave', reset);
    });
  }

  function daftar(id: string, arr: Hitung[] | undefined, w: string, ubah?: (s: string) => string) {
    const el = q(id);
    if (!el) return;
    const tot = arr ? arr.reduce((s, x) => s + x.n, 0) : 0;
    if (!arr || tot === 0) {
      el.innerHTML = kosongDaftar;
      return;
    }
    const maks = Math.max(...arr.map((x) => x.n));
    el.innerHTML =
      '<ul class="space-y-3 text-sm">' +
      arr
        .map(
          (x) =>
            `<li><div class="flex items-center justify-between gap-3"><span class="truncate text-muted">${esc(ubah ? ubah(x.k) : x.k)}</span><span class="shrink-0 font-semibold tabular-nums text-heading">${fmt(x.n)} <span class="font-normal text-muted">${Math.round((x.n / tot) * 100)}%</span></span></div><div class="mt-1.5 h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full" style="width:${Math.max(4, Math.round((x.n / maks) * 100))}%;background:${w}"></div></div></li>`
        )
        .join('') +
      '</ul>';
  }

  function pengunjungBaru(arr: any) {
    const el = q('t-baru');
    if (!el) return;
    if (!Array.isArray(arr) || arr.length === 0) {
      el.innerHTML = '<p class="px-4 py-4 text-sm text-muted">Belum ada data.</p>';
      return;
    }
    el.innerHTML =
      '<ul class="divide-y divide-slate-100">' +
      arr
        .slice(0, 8)
        .map((v: any, i: number) => {
          const nama = namaHp(String(v.hp || v.dev || '-'));
          const awal = (nama.trim().charAt(0) || '?').toUpperCase();
          return `<li class="flex items-center gap-3 px-4 py-3"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white" style="background:${warna(i % 5)}">${esc(awal)}</span><div class="min-w-0 flex-1"><p class="truncate text-sm font-semibold text-heading">${esc(nama)}</p><p class="flex gap-3 truncate text-xs text-muted"><span class="tabular-nums">${esc(topeng(v.ip))}</span>${v.isp ? `<span class="truncate">${esc(v.isp)}</span>` : ''}</p><p class="flex gap-3 truncate text-xs text-muted"><span class="truncate">${esc(namaHalaman(String(v.pg || '/')))}</span><span class="shrink-0">${esc(waktuPendek(v.w))}</span></p></div><div class="shrink-0 text-right"><p class="text-xs font-medium text-heading">${esc(v.prov || '-')}</p><p class="text-xs text-muted">${esc(v.kota || '')}</p></div></li>`;
        })
        .join('') +
      '</ul>';
  }

  function pesanGrafik(teks: string) {
    ['grafik-harian', 'grafik-bulanan', 'heat'].forEach((k) => {
      const el = q(k);
      if (el) el.innerHTML = `<p class="col-span-10 text-sm text-slate-400">${teks}</p>`;
    });
    ['d-dev', 'd-br', 'd-os', 'd-jn', 'd-kn'].forEach((k) => {
      const el = q(k);
      if (el) el.innerHTML = cincinKosong;
    });
    ['l-prov', 'l-kota', 'l-isp', 'l-model', 'l-bhs', 'l-lyr', 'l-neg', 'l-src', 'l-pg'].forEach((k) => {
      const el = q(k);
      if (el) el.innerHTML = kosongDaftar;
    });
    gambarJam(null);
    pengunjungBaru(null);
  }

  function chip(k: string, kini: number, lalu: number) {
    const el = q(k);
    if (!el) return;
    if (lalu > 0) {
      const p = Math.round(((kini - lalu) / lalu) * 100);
      const w = p > 0 ? 'bg-white/15 text-emerald-200' : p < 0 ? 'bg-white/15 text-rose-200' : 'bg-white/15 text-slate-200';
      el.className = `rounded px-1.5 py-0.5 text-[11px] font-semibold ${w}`;
      el.textContent = p > 0 ? `naik ${p}%` : p < 0 ? `turun ${Math.abs(p)}%` : 'tetap';
    } else {
      el.className = 'hidden';
      el.textContent = '';
    }
  }

  function tandai() {
    document.querySelectorAll<HTMLElement>('[data-r]').forEach((b) => {
      const aktif = Number(b.dataset.r) === rentang;
      b.className = 'rounded-md px-2.5 py-1 transition ' + (aktif ? 'bg-white text-primary' : 'text-slate-300 hover:text-white');
      b.setAttribute('aria-pressed', String(aktif));
    });
  }

  function contoh() {
    let s = 11;
    const r = () => {
      s = (s * 9301 + 49297) % 233280;
      return s / 233280;
    };
    const tgl = (m: number) => new Date(Date.now() - m * 86400000).toLocaleDateString('sv-SE');
    const harian: Titik[] = [];
    for (let i = 29; i >= 0; i--) {
      const hr = new Date(Date.now() - i * 86400000).getDay();
      harian.push({ t: tgl(i), n: Math.round(38 + (29 - i) * 2.1 + r() * 34 - (hr === 1 ? 12 : 0) + (hr === 0 || hr === 6 ? 10 : 0)) });
    }
    const bulanan: Titik[] = [];
    const nilaiBln = [210, 290, 380, 450, 560, jml(harian)];
    for (let k = 5; k >= 0; k--) {
      const d = new Date();
      d.setMonth(d.getMonth() - k, 1);
      bulanan.push({ t: d.toLocaleDateString('sv-SE'), n: nilaiBln[5 - k] });
    }
    const heat: number[] = [];
    for (let rr = 0; rr < 7; rr++) {
      for (let j = 0; j < 24; j++) {
        const dasar = j >= 19 && j <= 22 ? 9 : j >= 7 && j <= 18 ? 4 : 1;
        heat.push(Math.round(dasar * (0.4 + r() * 1.1) * (rr >= 5 ? 1.3 : 1)));
      }
    }
    const mulai = (a: [string, number][]) => a.map(([k, n]) => ({ k, n }));
    const sekarang = new Date().toLocaleString('sv-SE').slice(0, 16);
    return {
      total: 1284,
      hari: harian[29].n,
      bulan: bulanan[5].n,
      kemarin: harian[28].n,
      bulanLalu: bulanan[4].n,
      harian,
      bulanan,
      waktu: sekarang,
      heat,
      dim: {
        dev: mulai([['Ponsel', 68], ['Komputer', 26], ['Tablet', 6]]),
        br: mulai([['Chrome', 58], ['Aplikasi sosial', 17], ['Safari', 14], ['Edge', 7], ['Lainnya', 4]]),
        os: mulai([['Android 15', 31], ['Android 14', 22], ['iOS', 17], ['Windows 11', 14], ['Lainnya', 8]]),
        jn: mulai([['Baru', 64], ['Kembali', 36]]),
        prov: mulai([['Jambi', 120], ['Sumatera Selatan', 88], ['DKI Jakarta', 64], ['Jawa Barat', 41], ['Riau', 28], ['Jawa Timur', 22], ['Lampung', 14], ['Lainnya', 9]]),
        model: mulai([['Oppo CPH2591', 74], ['Samsung SM-A155F', 52], ['Xiaomi 23129RAA4G', 41], ['iPhone', 33], ['vivo V2312', 24], ['Lainnya', 18]]),
        kota: mulai([['Bandar Lampung', 70], ['Jambi', 66], ['Palembang', 52], ['Jakarta', 48], ['Pekanbaru', 20], ['Bandung', 16]]),
        isp: mulai([['Telkomsel', 160], ['Indosat', 82], ['XL Axiata', 64], ['Telkom', 52], ['Biznet', 18], ['Lainnya', 14]]),
        kon: mulai([['Seluler 4G', 58], ['WiFi 4G', 30], ['4G', 8], ['Seluler 3G', 4]]),
        bhs: mulai([['id-ID', 310], ['en-US', 54], ['id', 20], ['ms-MY', 6]]),
        lyr: mulai([['412x915', 88], ['393x873', 70], ['360x800', 64], ['1920x1080', 40], ['390x844', 33]]),
        neg: mulai([['Indonesia', 372], ['Malaysia', 14], ['Singapura', 7]]),
        src: mulai([['Langsung', 190], ['instagram.com', 96], ['tiktok.com', 58], ['google.com', 41], ['wa.me', 22], ['Lainnya', 9]]),
        pg: mulai([['/', 240], ['/proyek', 120], ['/layanan', 70], ['/produk', 44], ['/kontak', 26], ['/perjalanan', 12]]),
      },
      terbaru: [
        { w: sekarang, ip: '36.79.xx.xx', hp: 'Samsung SM-A155F', dev: 'Ponsel', prov: 'Jambi', kota: 'Jambi', isp: 'Telkomsel', pg: '/' },
        { w: sekarang, ip: '114.122.xx.xx', hp: 'Oppo CPH2591', dev: 'Ponsel', prov: 'Sumatera Selatan', kota: 'Palembang', isp: 'Indosat', pg: '/proyek' },
        { w: sekarang, ip: '180.254.xx.xx', hp: 'Windows 11', dev: 'Komputer', prov: 'DKI Jakarta', kota: 'Jakarta', isp: 'Biznet', pg: '/layanan' },
        { w: sekarang, ip: '112.215.xx.xx', hp: 'iPhone', dev: 'Ponsel', prov: 'Jawa Barat', kota: 'Bandung', isp: 'XL Axiata', pg: '/produk' },
        { w: sekarang, ip: '125.160.xx.xx', hp: 'Xiaomi 23129RAA4G', dev: 'Ponsel', prov: 'Riau', kota: 'Pekanbaru', isp: 'Telkomsel', pg: '/' },
      ],
    };
  }

  function render(dAsli: any) {
    const demo = demoAktif();
    const d = demo ? contoh() : dAsli;
    terakhir = d;
    const info = q('demo');
    if (info) info.classList.toggle('hidden', !demo);
    tandai();
    const angka = (v: unknown) => (typeof v === 'number' ? fmt(v) : '-');
    const elTotal = q('total');
    if (elTotal) {
      if (d && typeof d.total === 'number') hitungNaik(elTotal, d.total);
      else elTotal.textContent = '-';
    }
    isiTeks('hari', angka(d && d.hari));
    isiTeks('bulan', angka(d && d.bulan));

    const ada = d && Array.isArray(d.harian) && d.harian.length >= 14 && Array.isArray(d.bulanan);
    if (!ada) {
      ['rata', 'puncak', 'kembali', 'r-aktif', 'r-minggu'].forEach((k) => isiTeks(k, '-'));
      ['s-rata', 's-hari', 's-bulan', 's-puncak', 's-total', 's-aktif', 's-kembali'].forEach((k) => isiTeks(k, ''));
      chip('d-minggu', 0, 0);
      pesanGrafik('Data grafik tidak tersedia.');
      isiTeks('sumber', d ? 'Data grafik belum tersedia dari sumber.' : 'Data tidak dapat dimuat. Muat ulang halaman untuk mencoba lagi.');
      return;
    }

    const h: Titik[] = d.harian;
    const jumlah = jml(h);
    const puncak = h.reduce((a, s) => (s.n > a.n ? s : a), h[0]);
    const minggu = jml(h.slice(-7));
    const mingguLalu = jml(h.slice(-14, -7));
    const aktif = h.filter((s) => s.n > 0).length;
    const dm = d.dim || {};
    const jn: Hitung[] = Array.isArray(dm.jn) ? dm.jn : [];
    const totJn = jn.reduce((s, x) => s + x.n, 0);
    const kembali = jn.find((x) => x.k === 'Kembali');

    isiTeks('s-total', `${h.length} hari terakhir: ${fmt(jumlah)} kunjungan`);
    isiTeks('s-hari', typeof d.kemarin === 'number' ? `Kemarin ${fmt(d.kemarin)}` : '');
    isiTeks('s-bulan', typeof d.bulanLalu === 'number' ? `Bulan lalu ${fmt(d.bulanLalu)}` : '');
    isiTeks('r-minggu', fmt(minggu));
    chip('d-minggu', minggu, mingguLalu);
    isiTeks('rata', (jumlah / h.length).toLocaleString('id-ID', { maximumFractionDigits: 1 }));
    isiTeks('s-rata', `${h.length} hari terakhir`);
    isiTeks('puncak', puncak.n > 0 ? fmt(puncak.n) : '-');
    isiTeks('s-puncak', puncak.n > 0 ? tglPendek(puncak.t) : '');
    isiTeks('r-aktif', `${aktif} dari ${h.length}`);
    isiTeks('s-aktif', 'hari terakhir');
    isiTeks('kembali', totJn > 0 ? `${Math.round(((kembali ? kembali.n : 0) / totJn) * 100)}%` : '-');
    isiTeks('s-kembali', totJn > 0 ? `dari ${fmt(totJn)} kunjungan` : '');
    isiTeks('sumber', '');

    gambarHarian(h);
    gambarBulanan(d.bulanan);
    gambarHeat(h);
    gambarJam(d.heat);
    donat('d-dev', dm.dev);
    donat('d-br', dm.br);
    donat('d-os', dm.os);
    donat('d-jn', dm.jn);
    donat('d-kn', dm.kon);
    daftar('l-prov', dm.prov, '#eb6834');
    daftar('l-kota', dm.kota, '#1baf7a');
    daftar('l-isp', dm.isp, '#2a78d6');
    daftar('l-model', dm.model, '#6250d6', namaHp);
    daftar('l-bhs', dm.bhs, '#e87ba4', namaBahasa);
    daftar('l-lyr', dm.lyr, '#eb6834', namaLayar);
    daftar('l-neg', dm.neg, '#1baf7a');
    daftar('l-src', dm.src, '#e87ba4');
    daftar('l-pg', dm.pg, '#2a78d6', namaHalaman);
    pengunjungBaru(d.terbaru);
  }

  document.addEventListener('statistik:data', (e) => render((e as CustomEvent).detail));
  document.addEventListener('astro:page-load', () => {
    const w = window as any;
    if (w.__statistik !== undefined || demoAktif()) render(w.__statistik);
    else tandai();
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-r]') as HTMLElement | null;
    if (!b) return;
    rentang = Number(b.dataset.r);
    tandai();
    if (terakhir && Array.isArray(terakhir.harian)) gambarHarian(terakhir.harian);
  });

  let tunda = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(tunda);
    tunda = window.setTimeout(() => {
      if (terakhir) render(terakhir);
    }, 150);
  });

  const awalData = (window as any).__statistik;
  if (awalData !== undefined || demoAktif()) render(awalData);
  else tandai();
</script>
