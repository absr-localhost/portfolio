---
import { wrap } from '~/data/profil';
---

<section id="kr" class="bg-white pb-2 pt-6 sm:pt-8" hidden>
  <div class={wrap}>
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2 class="kr-judul">Karya</h2>
      <a href="/artikel/?k=Karya" class="inline-flex items-center gap-1 text-xs font-semibold text-link hover:underline sm:text-sm">
        Lihat semua
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
    <div id="kr-row" class="kr-row -mx-4 flex snap-x gap-3 overflow-x-auto px-4 pb-4 pt-1 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-4"></div>
  </div>
</section>

<style is:global>
  #kr[hidden] {
    display: none !important;
  }
  .kr-judul {
    border-left: 4px solid rgb(200 162 74);
    padding-left: 0.625rem;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    color: rgb(11 37 69);
  }
  @media (min-width: 640px) {
    .kr-judul { font-size: 1.25rem; }
  }
  .kr-row { scrollbar-width: none; scroll-padding-inline: 1rem; }
  .kr-row::-webkit-scrollbar { display: none; }
  .kr-kartu {
    background-color: #060a22;
    background-image: linear-gradient(rgb(4 8 32 / 0.3), rgb(4 8 32 / 0.55)), url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    box-shadow: 0 14px 28px -14px rgb(7 11 37 / 0.7), 0 2px 6px rgb(7 11 37 / 0.2), inset 0 1px 0 rgb(255 255 255 / 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .kr-item p { text-shadow: 0 1px 8px rgb(2 6 24 / 0.55); }
  .kr-img { transition: transform 0.5s ease; }
  .kr-btn { transition: background-color 0.2s ease, transform 0.2s ease; }
  @media (hover: hover) {
    .kr-item:hover .kr-kartu { transform: translateY(-3px); box-shadow: 0 20px 34px -14px rgb(7 11 37 / 0.8), 0 2px 6px rgb(7 11 37 / 0.2), inset 0 1px 0 rgb(255 255 255 / 0.1); }
    .kr-item:hover .kr-img { transform: scale(1.05); }
    .kr-item:hover .kr-btn { background-color: rgb(238 242 255); }
  }
  .kr-item:focus-visible { outline: 2px solid rgb(200 162 74); outline-offset: 3px; border-radius: 1.5rem; }
</style>

<script is:inline>
  (function () {
    var sec = document.getElementById('kr');
    var row = document.getElementById('kr-row');
    if (!sec || !row) return;

    var CAL = '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4M8 3v4M4 11h16"/>';
    var ARR = '<path d="M5 12h14M13 6l6 6-6 6"/>';
    function ic(p, c) {
      return '<svg viewBox="0 0 24 24" class="' + c + '" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + p + '</svg>';
    }

    function kartu(it) {
      if (!it || !/^[a-z0-9-]{1,80}$/.test(it.slug || '')) return null;
      var a = document.createElement('a');
      a.href = '/artikel/' + it.slug;
      a.className = 'kr-item block w-[268px] shrink-0 snap-start sm:w-auto';
      a.setAttribute('aria-label', 'Buka: ' + (it.judul || 'Karya'));

      var k = document.createElement('div');
      k.className = 'kr-kartu flex h-full flex-col rounded-3xl border border-white/10 p-2';

      var th = document.createElement('div');
      th.className = 'relative overflow-hidden rounded-2xl bg-slate-900';
      th.style.aspectRatio = '2 / 1';
      var src = /^\/admin\/media\/[a-z]_[a-f0-9]{16}\.jpg$/.test(it.foto || '') ? it.foto : '';
      if (src) {
        var im = document.createElement('img');
        im.className = 'kr-img absolute inset-0 h-full w-full object-cover';
        im.alt = '';
        im.loading = 'lazy';
        im.decoding = 'async';
        im.src = src;
        th.appendChild(im);
      }
      k.appendChild(th);

      var tx = document.createElement('div');
      tx.className = 'flex flex-1 flex-col px-1.5 pb-1 pt-2.5';
      var t = document.createElement('p');
      t.className = 'line-clamp-2 text-sm font-bold leading-snug text-white';
      t.textContent = it.judul || '';
      tx.appendChild(t);
      if (it.tanggal) {
        var d = document.createElement('p');
        d.className = 'mt-1 flex items-center gap-1 text-[11px] text-white/60';
        d.innerHTML = ic(CAL, 'h-3 w-3');
        d.appendChild(document.createTextNode(it.tanggal));
        tx.appendChild(d);
      }
      if (it.ringkasan) {
        var r = document.createElement('p');
        r.className = 'mt-1.5 line-clamp-3 text-xs leading-snug text-white/75';
        r.textContent = it.ringkasan;
        tx.appendChild(r);
      }
      var sp = document.createElement('span');
      sp.className = 'flex-1';
      tx.appendChild(sp);
      var bt = document.createElement('span');
      bt.className = 'kr-btn mt-3 flex items-center justify-center gap-1.5 rounded-full bg-white py-2 text-xs font-bold text-primary';
      bt.innerHTML = '<span>Buka</span>' + ic(ARR, 'h-3.5 w-3.5');
      tx.appendChild(bt);
      k.appendChild(tx);

      a.appendChild(k);
      return a;
    }

    fetch('/artikel/terbaru.php?kat=Karya&t=' + Date.now(), { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        var arr = d && Array.isArray(d.karya) ? d.karya : [];
        var n = 0;
        arr.forEach(function (it) {
          var el = kartu(it);
          if (el) { row.appendChild(el); n++; }
        });
        if (n) sec.hidden = false;
      })
      .catch(function () {});
  })();
</script>
