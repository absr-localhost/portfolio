---
import { wrap } from '~/data/profil';
---

<section id="vb" class="bg-slate-50 py-10 sm:py-12" hidden>
  <div class={wrap}>
    <div id="vb-row" class="flex snap-x gap-3 overflow-x-auto pb-2 sm:gap-4"></div>
  </div>

  <div id="vb-modal" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/85 p-3" role="dialog" aria-modal="true" aria-label="Video" hidden>
    <button id="vb-x" type="button" class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-primary text-white" aria-label="Tutup"></button>
    <div class="flex max-h-full w-full max-w-3xl flex-col items-center gap-3 overflow-y-auto">
      <div id="vb-box" class="vb-box relative overflow-hidden rounded-xl bg-black" role="group" aria-label="Video">
        <video id="vb-video" class="h-full w-full bg-black object-contain" playsinline preload="none"></video>
        <div id="vb-bar" class="absolute inset-x-0 bottom-0 flex items-center gap-1 bg-primary/90 px-1.5 py-1 text-white">
          <button id="vb-pp" type="button" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md" aria-label="Putar"></button>
          <input id="vb-rg" type="range" min="0" max="1000" step="1" value="0" class="h-6 min-w-0 flex-1 accent-white" aria-label="Posisi video" />
          <button id="vb-mu" type="button" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md" aria-label="Suara"></button>
          <button id="vb-fs" type="button" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md" aria-label="Layar penuh"></button>
        </div>
      </div>
      <div id="vb-info" class="w-full max-w-md text-center" hidden>
        <h2 id="vb-t" class="text-lg font-bold text-white" hidden></h2>
        <p id="vb-d" class="mt-1 text-sm text-slate-300" hidden></p>
        <p id="vb-w" class="mt-2 text-xs text-slate-400" hidden></p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #vb[hidden],
  #vb [hidden] {
    display: none !important;
  }
  .vb-box:fullscreen {
    aspect-ratio: auto !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
  }
  .vb-box:-webkit-full-screen {
    aspect-ratio: auto !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
  }
  .vb-box.vb-fake {
    position: fixed !important;
    inset: 0;
    z-index: 10000;
    aspect-ratio: auto !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
  }
  @keyframes vbp {
    0% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0.55); }
    70%, 100% { box-shadow: 0 0 0 10px rgb(255 255 255 / 0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .vb-pulse { animation: vbp 2.4s ease-out infinite; }
  }
</style>

<script is:inline>
  (function () {
    var sec = document.getElementById('vb');
    if (!sec) return;
    var $ = function (i) { return document.getElementById(i); };
    var row = $('vb-row'), modal = $('vb-modal'), box = $('vb-box'), v = $('vb-video');
    var bar = $('vb-bar'), pp = $('vb-pp'), rg = $('vb-rg'), mu = $('vb-mu'), fs = $('vb-fs'), xb = $('vb-x');
    var BASE = '/admin/video/';
    var landscape = false, drag = false, opener = null;

    var P = {
      play: '<path d="M8 5v14l11-7z" fill="currentColor" stroke="none"/>',
      pause: '<path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor" stroke="none"/>',
      vol: '<path d="M4 9v6h4l5 4V5L8 9z" fill="currentColor" stroke="none"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/>',
      mute: '<path d="M4 9v6h4l5 4V5L8 9z" fill="currentColor" stroke="none"/><path d="M16 9l5 6M21 9l-5 6"/>',
      fs: '<path d="M4 8V6a2 2 0 0 1 2-2h2M4 16v2a2 2 0 0 0 2 2h2M16 4h2a2 2 0 0 1 2 2v2M16 20h2a2 2 0 0 0 2-2v-2"/>',
      fsx: '<path d="M8 4v2a2 2 0 0 1-2 2H4M4 16h2a2 2 0 0 1 2 2v2M16 4v2a2 2 0 0 0 2 2h2M20 16h-2a2 2 0 0 0-2 2v2"/>',
      x: '<path d="M6 6l12 12M18 6L6 18"/>'
    };
    function ic(n, c) {
      return '<svg viewBox="0 0 24 24" class="' + c + '" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + P[n] + '</svg>';
    }
    function fmt(s) { s = Math.round(s); return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2); }
    function txt(id, t) {
      var e = $(id);
      e.textContent = t || '';
      e.hidden = !t;
      return !!t;
    }
    function tgl(w, pendek) {
      if (!w) return '';
      var d = new Date(w);
      if (isNaN(d.getTime())) return '';
      var s = d.toLocaleDateString('id-ID', { day: 'numeric', month: pendek ? 'short' : 'long', year: 'numeric' });
      if (!pendek) s += ', ' + d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
      return s;
    }

    function setPP() {
      pp.innerHTML = ic(v.paused ? 'play' : 'pause', 'h-5 w-5');
      pp.setAttribute('aria-label', v.paused ? 'Putar' : 'Jeda');
    }
    function setMu() {
      var off = v.muted || v.volume === 0;
      mu.innerHTML = ic(off ? 'mute' : 'vol', 'h-5 w-5');
      mu.setAttribute('aria-label', off ? 'Nyalakan suara' : 'Matikan suara');
    }
    function toggle() {
      if (v.paused) {
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      } else {
        v.pause();
      }
    }

    function isFS() {
      return document.fullscreenElement === box || document.webkitFullscreenElement === box || box.classList.contains('vb-fake');
    }
    function unlock() {
      try { if (screen.orientation && screen.orientation.unlock) screen.orientation.unlock(); } catch (e) {}
    }
    function lockLand() {
      try {
        if (landscape && screen.orientation && screen.orientation.lock) {
          screen.orientation.lock('landscape').catch(function () {});
        }
      } catch (e) {}
    }
    function syncFS() {
      var on = isFS();
      fs.innerHTML = ic(on ? 'fsx' : 'fs', 'h-5 w-5');
      fs.setAttribute('aria-label', on ? 'Keluar layar penuh' : 'Layar penuh');
      if (!on) unlock();
    }
    function fallback() {
      if (v.webkitEnterFullscreen && /iPhone|iPad|iPod/.test(navigator.userAgent)) {
        try { v.webkitEnterFullscreen(); return; } catch (e) {}
      }
      box.classList.add('vb-fake');
      syncFS();
    }
    function enterFS() {
      var req = box.requestFullscreen || box.webkitRequestFullscreen;
      if (!req) { fallback(); return; }
      try {
        var p = req.call(box);
        if (p && p.then) { p.then(lockLand, fallback); } else { lockLand(); }
      } catch (e) { fallback(); }
    }
    function exitFS() {
      if (box.classList.contains('vb-fake')) {
        box.classList.remove('vb-fake');
        syncFS();
        return;
      }
      var ex = document.exitFullscreen || document.webkitExitFullscreen;
      if (ex && (document.fullscreenElement || document.webkitFullscreenElement)) {
        try { var p = ex.call(document); if (p && p.catch) p.catch(function () {}); } catch (e) {}
      }
    }

    function openV(it, from) {
      var w = Number(it.lebar) || 9, h = Number(it.tinggi) || 16;
      landscape = w >= h;
      opener = from;
      box.style.aspectRatio = w + ' / ' + h;
      box.style.width = 'min(100%, calc(66dvh * ' + (w / h) + '))';
      box.setAttribute('aria-label', it.judul || 'Video');
      var a = txt('vb-t', it.judul);
      var b = txt('vb-d', it.deskripsi);
      var c = txt('vb-w', tgl(it.waktu, false));
      $('vb-info').hidden = !(a || b || c);
      v.poster = BASE + it.sampul;
      v.src = BASE + it.video;
      rg.value = '0';
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      setPP(); setMu(); syncFS();
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
      xb.focus();
    }
    function closeV() {
      if (modal.hidden) return;
      exitFS();
      v.pause();
      v.removeAttribute('src');
      v.load();
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      unlock();
      if (opener) opener.focus();
    }

    xb.innerHTML = ic('x', 'h-5 w-5');
    xb.addEventListener('click', closeV);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeV(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeV(); });
    v.addEventListener('click', toggle);
    pp.addEventListener('click', toggle);
    mu.addEventListener('click', function () { v.muted = !v.muted; });
    fs.addEventListener('click', function () { if (isFS()) { exitFS(); } else { enterFS(); } });
    v.addEventListener('play', setPP);
    v.addEventListener('pause', setPP);
    v.addEventListener('volumechange', setMu);
    v.addEventListener('timeupdate', function () {
      if (!drag && v.duration) rg.value = String(Math.round(v.currentTime / v.duration * 1000));
    });
    v.addEventListener('ended', function () {
      v.currentTime = 0;
      rg.value = '0';
      setPP();
    });
    rg.addEventListener('pointerdown', function () { drag = true; });
    rg.addEventListener('pointerup', function () { drag = false; });
    rg.addEventListener('pointercancel', function () { drag = false; });
    rg.addEventListener('change', function () { drag = false; });
    rg.addEventListener('input', function () {
      if (v.duration) v.currentTime = Number(rg.value) / 1000 * v.duration;
    });
    document.addEventListener('fullscreenchange', syncFS);
    document.addEventListener('webkitfullscreenchange', syncFS);
    document.addEventListener('visibilitychange', function () {
      if (document.hidden && !v.paused) v.pause();
    });

    function kartu(it, i, tegak) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'shrink-0 snap-start text-left ' + (tegak ? 'w-[140px] sm:w-[170px]' : 'w-[240px] sm:w-[280px]');
      b.setAttribute('aria-label', (it.judul || 'Video') + ', putar');

      var th = document.createElement('div');
      th.className = 'relative overflow-hidden rounded-xl border border-slate-200 bg-black shadow-sm';
      th.style.aspectRatio = tegak ? '9 / 16' : '16 / 9';
      var im = document.createElement('img');
      im.className = 'absolute inset-0 h-full w-full object-cover';
      im.alt = '';
      im.loading = 'lazy';
      im.decoding = 'async';
      im.src = BASE + it.sampul;
      var pl = document.createElement('span');
      pl.className = 'absolute bottom-2 left-2 flex items-center gap-1 rounded-full bg-primary/90 py-1 pl-2 pr-2.5 text-xs text-white' + (i === 0 ? ' vb-pulse' : '');
      pl.innerHTML = ic('play', 'h-4 w-4') + '<span>' + fmt(Number(it.durasi) || 0) + '</span>';
      th.appendChild(im);
      th.appendChild(pl);
      b.appendChild(th);

      if (it.judul) {
        var t = document.createElement('p');
        t.className = 'mt-2 line-clamp-2 text-sm font-semibold text-heading';
        t.textContent = it.judul;
        b.appendChild(t);
      }
      var tg = tgl(it.waktu, true);
      if (tg) {
        var d = document.createElement('p');
        d.className = 'mt-0.5 text-xs text-muted';
        d.textContent = tg;
        b.appendChild(d);
      }
      b.addEventListener('click', function () { openV(it, b); });
      return b;
    }

    fetch('/admin/video/video.json?t=' + Date.now(), { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d) return;
        var arr = Array.isArray(d.daftar) ? d.daftar : (d.video ? [d] : []);
        arr = arr.filter(function (it) { return it && it.aktif && it.video && it.sampul; });
        if (!arr.length) return;
        var tegak = (Number(arr[0].tinggi) || 16) > (Number(arr[0].lebar) || 9);
        arr.forEach(function (it, i) { row.appendChild(kartu(it, i, tegak)); });
        setPP(); setMu(); syncFS();
        sec.hidden = false;
      })
      .catch(function () {});
  })();
</script>
